{
  /* If you are developing, `dotnet dev-certs https --trust` will create and trust a development certificate. */
  "ConnectionStrings": {
    "database": "YOUR_POSTGRES_CONNECTION_STRING"
  },
  "Steam": {
    // https://steamcommunity.com/dev/apikey
    "ApiKey": "YOUR_SECRET",
    "Username": "STEAM_USERNAME_ONLY_NEEDED_IF_ANONYMOUS_ONLY_FALSE",
    "Password": "STEAM_PASSWORD_ONLY_NEEDED_IF_ANONYMOUS_ONLY_FALSE"
  },
  "Hosting": {
    "WorkerProvisioning": {
      // Production provisioning is fail-closed unless this is an immutable image reference.
      "ContainerImage": "ghcr.io/x39/united-tactical-forces-cloud-worker@sha256:REPLACE_WITH_64_HEX_DIGEST"
    },
    "Providers": {
      "Hetzner": {
        "Token": "YOUR_HETZNER_CLOUD_API_TOKEN"
      }
    }
  },
  "Jwt": {
    "SecretKey": "YOUR_SECRET_KEY"
  },
  "Discord": {
    "OAuth": {
        "ClientId": "YOUR_CLIENT_ID",
        "ClientSecret": "YOUR_CLIENT_SECRET"
    },
    "Bot": {
        // https://discordapp.com/developers
        "ApplicationId": "YOUR_APPLICATION_ID",
        "PublicKey": "YOUR_PUBLIC_KEY",
        "BotToken": "YOUR_BOT_TOKEN"
    }
  }
}
