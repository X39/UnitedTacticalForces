{
  /* If you are developing, `dotnet dev-certs https --trust` will create and trust a development certificate. */
  "ConnectionStrings": {
    "database": "YOUR_POSTGRES_CONNECTION_STRING"
  },
  "Steam": {
    // https://steamcommunity.com/dev/apikey
    "ApiKey": "YOUR_SECRET",
    "Username": "STEAM_ACCOUNT_NAME_ENTITLED_TO_ARMA3_DEDICATED_SERVER",
    "Password": "STEAM_ACCOUNT_PASSWORD_REQUIRED_FOR_CLOUD_WORKERS"
  },
  "Hosting": {
    "WorkerProvisioning": {
      // Production provisioning is fail-closed unless this is an immutable image reference.
      "ContainerImage": "ghcr.io/x39/united-tactical-forces-cloud-worker@sha256:REPLACE_WITH_64_HEX_DIGEST",
      // Use a dedicated classic PAT with read:packages only. Do not reuse the publisher token.
      "RegistryUsername": "YOUR_GITHUB_USERNAME",
      "RegistryToken": "YOUR_READ_ONLY_GHCR_TOKEN",
      // Optional key-only emergency host access. Restrict source CIDRs to operator networks; never use 0.0.0.0/0.
      "AdministrativeSshEnabled": false,
      "AdministrativeSshUser": "utf-admin",
      "AdministrativeSshAuthorizedKeys": [
        "ssh-ed25519 REPLACE_WITH_ADMIN_PUBLIC_KEY"
      ],
      "AdministrativeSshSourceCidrs": [
        "REPLACE_WITH_ADMIN_PUBLIC_IP/32"
      ]
    },
    "Providers": {
      "Hetzner": {
        "Token": "YOUR_HETZNER_CLOUD_API_TOKEN"
      }
    }
  },
  "Jwt": {
    "SecretKey": "YOUR_SECRET_KEY"
  },
  "Discord": {
    "OAuth": {
        "ClientId": "YOUR_CLIENT_ID",
        "ClientSecret": "YOUR_CLIENT_SECRET"
    },
    "Bot": {
        // https://discordapp.com/developers
        "ApplicationId": "YOUR_APPLICATION_ID",
        "PublicKey": "YOUR_PUBLIC_KEY",
        "BotToken": "YOUR_BOT_TOKEN"
    }
  }
}
