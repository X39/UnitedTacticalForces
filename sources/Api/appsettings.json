{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "General": {
    "BasePath": "/",
    "ApiBaseUrl": "http://example.com",
    "ClientBaseUrl": "http://example.com",
    "AutoVerifyNewUsers": false
  },
  "Testing": {
    "AuthorizationBypass": {
      "Enabled": false,
      "UserId": "b6aa28a3-a740-4e0c-b5dc-157c04881872"
    }
  },
  "Steam": {
    // Requires restart if changed
    "Enabled": true
  },
  "Hosting": {
    "Providers": {
      "Hetzner": {
        "BaseUrl": "https://api.hetzner.cloud/v1/",
        "ServerType": "ccx13",
        "Image": "ubuntu-24.04",
        "Location": "fsn1",
        // Conservative combined estimate for CCX13 plus one explicitly billed Primary IPv4.
        "EstimatedHourlyCostEur": 0.10
      }
    },
    "PersistentStorage": {
      "BasePath": ".local/hosting/persistent"
    },
    "Worker": {
      "HeartbeatInterval": "00:00:10",
      "StaleThreshold": "00:01:00",
      "JobLease": "00:00:45",
      "LeaseRenewalInterval": "00:00:10",
      "RetryDelay": "00:00:30",
      "BootstrapCredentialLifetime": "00:45:00",
      "RegistrationGrace": "00:15:00",
      "WorkerCredentialLifetime": "30.00:00:00",
      "HealthReconciliationInterval": "00:00:15",
      "FaultEvidenceCollectionWindow": "00:01:00",
      "MaxConcurrentJobs": 4,
      "MaxConcurrentNormalJobs": 3,
      "IdlePollInterval": "00:00:02"
    },
    "ProviderReconciliation": {
      "Enabled": true,
      "InitialDelay": "00:00:15",
      "ScanInterval": "00:05:00",
      "CompletedIncidentRetention": "365.00:00:00"
    },
    "Finance": {
      "MinimumSafetyRangeEur": 5.0,
      "ReservationSlice": "00:15:00",
      "ReconciliationInterval": "00:00:30",
      // Conservative configured estimate for CCX13 in fsn1 plus one Primary IPv4.
      // Revalidate this operational value whenever the Hetzner product/location changes.
      "EstimatedHourlyCostEur": {
        "hetzner": 0.10
      }
    },
    "WorkerProvisioning": {
      "ContainerImage": "ghcr.io/x39/united-tactical-forces-cloud-worker:development",
      "BootstrapPath": "/etc/united-tactical-forces/bootstrap.json",
      "StateDirectory": "/var/lib/united-tactical-forces/worker",
      "RuntimeDirectory": "/srv/united-tactical-forces/runtime",
      "ContainerPidsLimit": 1024,
      "ContainerMemoryLimit": "7g",
      "ContainerLogMaxSize": "10m",
      "ContainerLogMaxFiles": 3
    }
  },
  "Discord": {
    // Requires restart if changed
    "Enabled": true,
    "Bot": {
      "EmbedColor": "#BAA05A"
    }
  },
  "TeamSpeak": {
    "Host": "ts3.hoster.com",
    "Port": 9987,
    "Password": "serverPassword",
    "Channel": "MyDefaultChannel",
    "ChannelPassword": "defaultChannelPassword"
  },
  "AllowedHosts": "*"
}
