@using System.Globalization
@using X39.UnitedTacticalForces.WebApp.Services.GameServerRepository
@inject IStringLocalizer<Language> Localizer

<section class="utf-panel storage-demand" aria-labelledby="storage-demand-title">
    <div class="hosting-section-heading">
        <span class="utf-kicker">@Localizer["Hosting_Create_StoragePreflight"]</span>
        <h2 id="storage-demand-title">@Localizer["Hosting_Create_StorageDemandTitle"]</h2>
        <p>@Localizer["Hosting_Create_StorageDemandDescription"]</p>
    </div>

    <dl class="storage-demand__totals">
        <div><dt>@Localizer["Hosting_Create_SteadyStateUsage"]</dt><dd>@FormatBytes(Demand.SteadyStateRequiredBytes)</dd></div>
        <div><dt>@Localizer["Hosting_Create_PreparationWorkspace"]</dt><dd>@FormatBytes(Demand.PreparationWorkspaceBytes)</dd></div>
        <div><dt>@Localizer["Hosting_Create_SafetyMargin", Demand.SafetyMarginPercent.ToString("0.#", CultureInfo.CurrentCulture)]</dt><dd>@FormatBytes(Demand.SafetyMarginBytes)</dd></div>
        <div><dt>@Localizer["Hosting_Create_RecommendedPeak"]</dt><dd>@FormatBytes(Demand.PeakPreparationRequiredBytes)</dd></div>
        @if (Demand.MinimumExternalCapacityGiB is { } minimumExternalGiB)
        {
            <div><dt>@Localizer["Hosting_Storage_RecommendedRawCapacity"]</dt><dd>@minimumExternalGiB.ToString("N0", CultureInfo.CurrentCulture) GiB</dd></div>
            <div><dt>@Localizer["Hosting_Storage_RecommendedUsableCapacity"]</dt><dd>@FormatOptionalBytes(Demand.RecommendedExternalUsableBytes)</dd></div>
        }
    </dl>

    <p class="storage-demand__status">
        <strong>@Localizer["Hosting_Create_Confidence"]</strong> @StatusText(Demand.Status).
        @if (Demand.MeasurementTimestamp is { } measuredAt)
        {
            <span> @Localizer["Hosting_Create_LatestMeasurement", measuredAt.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)]</span>
        }
    </p>

    @if (Demand.MissingComponents.Count > 0)
    {
        <UtfAlert Intent="MessageIntent.Warning">
            @Localizer["Hosting_Create_MissingComponents", string.Join(", ", Demand.MissingComponents)]
        </UtfAlert>
    }

    @if (SelectedFit is { IsSufficient: false })
    {
        <UtfAlert Intent="MessageIntent.Warning">
            @Localizer["Hosting_Create_SelectedProfileInsufficient"]
        </UtfAlert>
    }
    else if (SelectedFit is { IsSufficient: null })
    {
        <UtfAlert Intent="MessageIntent.Warning">
            @Localizer["Hosting_Create_SelectedProfileUnknown"]
        </UtfAlert>
    }

    <h3>@Localizer["Hosting_Create_SelectedProfileCapacity"]</h3>
    @if (SelectedFit is { } selectedFit)
    {
        <article class="storage-demand__profile">
            <strong>@selectedFit.DisplayName</strong>
            <span>@Localizer["Hosting_Create_IncludedCapacity"]: @FormatOptionalBytes(selectedFit.IncludedCapacityBytes)</span>
            <span>@Localizer["Hosting_Create_UsableCapacity"]: @FormatOptionalBytes(selectedFit.UsableCapacityBytes)</span>
            <span><strong>@FitText(selectedFit.IsSufficient)</strong></span>
        </article>
    }
    else
    {
        <p class="storage-demand__status">@Localizer["Hosting_Create_ProfileCapacityUnavailable"]</p>
    }

    <details>
        <summary>@Localizer["Hosting_Create_ComponentBreakdown"]</summary>
        <ul class="storage-demand__components">
            @foreach (var component in Demand.Components)
            {
                <li>
                    <span><strong>@component.DisplayName</strong> — @component.Kind</span>
                    <span>@FormatBytes(component.RequiredBytes); @StatusText(component.Status); @component.Source</span>
                </li>
            }
        </ul>
    </details>
</section>

@code {
    [Parameter, EditorRequired]
    public StorageDemandInfo Demand { get; set; } = null!;

    [Parameter]
    public string? SelectedProfileIdentifier { get; set; }

    private RuntimeProfileStorageFitInfo? SelectedFit
        => Demand.RuntimeProfiles.FirstOrDefault(profile => string.Equals(
            profile.RuntimeProfileIdentifier,
            SelectedProfileIdentifier,
            StringComparison.OrdinalIgnoreCase));

    private string StatusText(string status)
        => status.Trim().ToLowerInvariant() switch
        {
            "measured" => Localizer["Hosting_Create_StorageStatusMeasured"].Value,
            "estimated" => Localizer["Hosting_Create_StorageStatusEstimated"].Value,
            "incomplete" => Localizer["Hosting_Create_StorageStatusIncomplete"].Value,
            _ => Localizer["Hosting_Create_StorageStatusUnavailable"].Value,
        };

    private string FitText(bool? sufficient)
        => sufficient switch
        {
            true => Localizer["Hosting_Create_FitSufficient"].Value,
            false => Localizer["Hosting_Create_FitInsufficient"].Value,
            null => Localizer["Hosting_Create_FitUnknown"].Value,
        };

    private string FormatOptionalBytes(long? bytes)
        => bytes is { } value
            ? FormatBytes(value)
            : Localizer["Hosting_Create_StorageStatusUnavailable"].Value;

    private static string FormatBytes(long bytes)
    {
        const decimal gib = 1_073_741_824m;
        return bytes >= gib
            ? $"{bytes / gib:0.##} GiB"
            : $"{bytes / 1_048_576m:0.##} MiB";
    }
}
