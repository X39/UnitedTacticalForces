@using System.Net.Http.Json
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject IConfiguration Configuration
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject IStringLocalizer<Language> Localizer

@if (_isVisible)
{
    <button class="utf-button utf-button--ghost utf-ui-variant-switch"
            type="button"
            @onclick="OpenReactAsync">
        @Localizer["React_UI_TryNew"]
    </button>
}

@code {
    private bool _isVisible;
    private bool _enabled;
    private string _reactBasePath = "/next";
    private UiRouteManifestRoute[] _routes = [];

    protected override async Task OnInitializedAsync()
    {
        _enabled = Configuration.GetValue<bool>("Ui:ReactVariantEnabled");
        if (!_enabled)
            return;

        NavigationManager.LocationChanged += OnLocationChanged;
        var configuredBasePath = Configuration["Ui:ReactBasePath"]?.TrimEnd('/') ?? "/next";
        if (!IsValidReactBase(configuredBasePath))
        {
            Console.Error.WriteLine("The React UI base must be /next or an HTTP(S) development origin ending in /next.");
            return;
        }
        _reactBasePath = configuredBasePath;
        try
        {
            var client = HttpClientFactory.CreateClient("API");
            var manifestUri = new Uri(new Uri(NavigationManager.BaseUri), "ui-routes.json");
            var manifest = await client.GetFromJsonAsync<UiRouteManifest>(manifestUri);
            _routes = manifest?.Routes ?? [];
            await EvaluateLocationAsync(NavigationManager.Uri);
        }
        catch (Exception)
        {
            Console.Error.WriteLine("React UI route certification could not be loaded.");
        }
    }

    private async Task OpenReactAsync()
        => await JsRuntime.InvokeVoidAsync("utfUiVariant.openReact", _reactBasePath);

    private static bool IsValidReactBase(string value)
    {
        if (string.Equals(value, "/next", StringComparison.Ordinal))
            return true;
        return Uri.TryCreate(value, UriKind.Absolute, out var uri)
               && (string.Equals(uri.Scheme, Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase)
                   || string.Equals(uri.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase))
               && string.Equals(uri.AbsolutePath.TrimEnd('/'), "/next", StringComparison.Ordinal);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
        => _ = InvokeAsync(() => EvaluateLocationAsync(args.Location));

    private async Task EvaluateLocationAsync(string location)
    {
        var currentPath = new Uri(location).AbsolutePath;
        _isVisible = _routes.Any(route => route.Certified
                                         && route.Patterns.Any(pattern => IsMatch(pattern, currentPath)));
        StateHasChanged();
        if (!_isVisible)
            return;

        var preferredVariant = await JsRuntime.InvokeAsync<string?>("utfUiVariant.getVariant");
        if (string.Equals(preferredVariant, "react", StringComparison.Ordinal))
            await OpenReactAsync();
    }

    private static bool IsMatch(string pattern, string path)
    {
        var segments = pattern.Split('/', StringSplitOptions.RemoveEmptyEntries)
            .Select(segment => segment.StartsWith('{') && segment.EndsWith('}')
                ? segment.Contains(":guid", StringComparison.OrdinalIgnoreCase)
                    ? "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
                    : segment.Contains(":long", StringComparison.OrdinalIgnoreCase)
                        ? "-?[0-9]+"
                        : "[^/]+"
                : Regex.Escape(segment));
        var expression = pattern == "/" ? "^/$" : $"^/{string.Join('/', segments)}/?$";
        return Regex.IsMatch(path, expression, RegexOptions.IgnoreCase | RegexOptions.CultureInvariant);
    }

    private sealed record UiRouteManifestRoute
    {
        public string Canonical { get; init; } = string.Empty;
        public string[] Aliases { get; init; } = [];
        public bool Certified { get; init; }
        public IEnumerable<string> Patterns => [Canonical, ..Aliases];
    }

    private sealed record UiRouteManifest
    {
        public UiRouteManifestRoute[] Routes { get; init; } = [];
    }

    public void Dispose()
    {
        if (_enabled)
            NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
