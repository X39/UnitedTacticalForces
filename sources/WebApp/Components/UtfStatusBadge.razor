<span class="@CssClass" role="@Role">
    @if (ShowDot)
    {
        <span class="utf-status__dot"></span>
    }
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @Text
    }
</span>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string Intent { get; set; } = "neutral";

    [Parameter]
    public string? Role { get; set; }

    [Parameter]
    public bool ShowDot { get; set; } = true;

    [Parameter]
    public string? Text { get; set; }

    private string CssClass
    {
        get
        {
            var className = $"utf-status utf-status--{NormalizeIntent(Intent)}";
            return string.IsNullOrWhiteSpace(Class) ? className : $"{className} {Class}";
        }
    }

    private static string NormalizeIntent(string? intent)
        => intent?.Trim().ToLowerInvariant() switch
        {
            "brand" => "brand",
            "danger" => "danger",
            "error" => "danger",
            "info" => "info",
            "success" => "success",
            "warning" => "warning",
            _ => "neutral",
        };
}
