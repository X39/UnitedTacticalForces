@if (OnClick.HasDelegate)
{
    <button class="@CssClass"
            type="button"
            disabled="@Disabled"
            @onclick="OnClick">
        @MetricContent
    </button>
}
else
{
    <div class="@CssClass">
        @MetricContent
    </div>
}

@code {
    [Parameter]
    public bool Active { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public string? Status { get; set; }

    [Parameter]
    public string? StatusClass { get; set; }

    [Parameter]
    public string StatusIntent { get; set; } = "neutral";

    [Parameter]
    public string? Value { get; set; }

    private string CssClass
    {
        get
        {
            var className = Active ? "utf-command-metric utf-command-metric--active" : "utf-command-metric";
            if (Disabled)
                className += " utf-command-metric--disabled";
            return string.IsNullOrWhiteSpace(Class) ? className : $"{className} {Class}";
        }
    }

    private RenderFragment MetricContent
        => @<text>
               @if (!string.IsNullOrWhiteSpace(Status))
               {
                   @if (!string.IsNullOrWhiteSpace(StatusClass))
                   {
                       <span class="@StatusClass"><span class="utf-status__dot"></span>@Status</span>
                   }
                   else
                   {
                       <UtfStatusBadge Intent="@StatusIntent" Text="@Status"/>
                   }
               }
               <strong>@Value</strong>
               @if (!string.IsNullOrWhiteSpace(Description))
               {
                   <span>@Description</span>
               }
           </text>;
}
