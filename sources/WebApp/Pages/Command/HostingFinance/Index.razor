@page "/command/hosting-finance"
@layout CommandCenterLayout
@using System.Globalization
@using X39.UnitedTacticalForces.Hosting.Contracts
@using X39.UnitedTacticalForces.WebApp.Services
@using X39.UnitedTacticalForces.WebApp.Services.HostingFinanceRepository
@inject IHostingFinanceRepository FinanceRepository
@inject IToastService ToastService
@inject IDialogService DialogService
@inject MeService Me
@inject IStringLocalizer<Language> Localizer

<PageTitle>@Localizer["HostingFinance_PageTitle"]</PageTitle>

<div class="hosting-finance-page">
    <UtfCommandPageHeader Title="@(Localizer["HostingFinance_Title"])"
                          Description="@(Localizer["HostingFinance_Description"])">
        <Actions>
            <UtfCommandButton Disabled="@_isLoading" OnClick="RefreshAsync">
                <Icon><FluentIcon Value="@(new Icons.Regular.Size20.ArrowSyncCircle())"/></Icon>
                <ChildContent>@Localizer["HostingFinance_Refresh"]</ChildContent>
            </UtfCommandButton>
        </Actions>
    </UtfCommandPageHeader>

    @if (!CanViewFinance)
    {
        <section class="utf-empty-state">
            <h2>@Localizer["HostingFinance_NoAccessTitle"]</h2>
            <p>@Localizer["HostingFinance_NoAccessMessage"]</p>
        </section>
    }
    else if (_loadError is not null)
    {
        <div class="utf-state-panel utf-state-panel--warning" role="alert">@_loadError</div>
    }
    else
    {
        <section class="utf-panel hosting-finance-policy">
            <div class="hosting-finance-section-heading">
                <div>
                    <span class="utf-kicker">@Localizer["HostingFinance_PolicyKicker"]</span>
                    <h2>@Localizer["HostingFinance_PolicyTitle"]</h2>
                    <p>@Localizer["HostingFinance_PolicyDescription"]</p>
                </div>
                <span class="utf-status utf-status--info">
                    <span class="utf-status__dot"></span>@Localizer["HostingFinance_Global"]
                </span>
            </div>
            <div class="hosting-finance-policy-fields">
                <label class="utf-command-field">
                    <span>@Localizer["HostingFinance_MinimumReserve"]</span>
                    <input class="utf-command-input" type="number" min="0" step="0.01"
                           disabled="@(!CanManagePolicy || _isSavingPolicy)" @bind="_minimumSafetyRangeEur"/>
                </label>
                <label class="utf-command-field">
                    <span>@Localizer["HostingFinance_ReservationSlice"]</span>
                    <input class="utf-command-input" type="number" min="1" max="1440" step="1"
                           disabled="@(!CanManagePolicy || _isSavingPolicy)" @bind="_reservationSliceMinutes"/>
                </label>
                @if (CanManagePolicy)
                {
                    <UtfCommandButton Class="hosting-finance-policy-save" Variant="primary"
                                      Disabled="@_isSavingPolicy" OnClick="SavePolicyAsync">
                        @(_isSavingPolicy ? Localizer["HostingFinance_Saving"] : Localizer["HostingFinance_SavePolicy"])
                    </UtfCommandButton>
                }
            </div>
        </section>

        <div class="hosting-finance-workspace">
            <aside class="utf-panel hosting-finance-owner-browser">
                <div class="hosting-finance-browser-heading">
                    <div>
                        <span class="utf-kicker">@Localizer["HostingFinance_OwnersKicker"]</span>
                        <h2>@Localizer["HostingFinance_OwnersTitle"]</h2>
                    </div>
                    <span class="utf-status utf-status--neutral">@_totalOwnerCount</span>
                </div>

                <form class="hosting-finance-search" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
                    <UtfCommandSearch Label="@(Localizer["HostingFinance_SearchLabel"])"
                                      Placeholder="@(Localizer["HostingFinance_SearchPlaceholder"])"
                                      Value="@_search" ValueChanged="OnSearchChanged"/>
                    <UtfCommandButton Type="submit" Disabled="@_isLoadingOwners">
                        @Localizer["HostingFinance_Search"]
                    </UtfCommandButton>
                </form>

                @if (_isLoadingOwners)
                {
                    <div class="hosting-finance-browser-state">
                        @Localizer["HostingFinance_LoadingOwners"]
                        <FluentProgress Width="180px"/>
                    </div>
                }
                else if (_owners.Count == 0)
                {
                    <div class="hosting-finance-browser-state">@Localizer["HostingFinance_NoOwners"]</div>
                }
                else
                {
                    <div class="hosting-finance-owner-list" role="listbox" aria-label="@(Localizer["HostingFinance_OwnerResultsAria"])">
                        @foreach (var optionOwner in _owners)
                        {
                            <button type="button" role="option" aria-selected="@(optionOwner.CostOwnerId == _selectedOwnerId)"
                                    class="@GetOwnerButtonClass(optionOwner)" @onclick="@(() => SelectOwner(optionOwner))">
                                <span class="hosting-finance-owner-avatar" aria-hidden="true">@GetInitials(optionOwner.DisplayName)</span>
                                <span class="hosting-finance-owner-copy">
                                    <strong>@optionOwner.DisplayName</strong>
                                    <span>@FormatOwnerKind(optionOwner.Kind) · @FormatMoney(optionOwner.Balance, optionOwner.Currency)</span>
                                </span>
                                @if (optionOwner.IsFrozen)
                                {
                                    <span class="utf-status utf-status--warning">@Localizer["HostingFinance_Frozen"]</span>
                                }
                            </button>
                        }
                    </div>
                }

                @if (_totalOwnerCount > PageSize)
                {
                    <div class="hosting-finance-pagination">
                        <UtfCommandButton Disabled="@(_pageIndex == 0 || _isLoadingOwners)" OnClick="PreviousPageAsync">
                            @Localizer["HostingFinance_Previous"]
                        </UtfCommandButton>
                        <span>@FormatPageLabel()</span>
                        <UtfCommandButton Disabled="@(!HasNextPage || _isLoadingOwners)" OnClick="NextPageAsync">
                            @Localizer["HostingFinance_Next"]
                        </UtfCommandButton>
                    </div>
                }
            </aside>

            <main class="hosting-finance-detail">
                @if (SelectedOwner is not { } owner)
                {
                    <section class="utf-empty-state hosting-finance-select-prompt">
                        <FluentIcon Value="@(new Icons.Regular.Size24.PersonSearch())"/>
                        <h2>@Localizer["HostingFinance_SelectOwnerTitle"]</h2>
                        <p>@Localizer["HostingFinance_SelectOwnerMessage"]</p>
                    </section>
                }
                else
                {
                    <section class="utf-panel hosting-finance-summary">
                        <div class="hosting-finance-section-heading">
                            <div>
                                <span class="utf-kicker">@FormatOwnerKind(owner.Kind)</span>
                                <h2>@owner.DisplayName</h2>
                            </div>
                            <span class="utf-status @(owner.IsFrozen ? "utf-status--warning" : "utf-status--success")">
                                <span class="utf-status__dot"></span>
                                @(owner.IsFrozen ? Localizer["HostingFinance_Frozen"] : Localizer["HostingFinance_Active"])
                            </span>
                        </div>
                        <dl class="hosting-finance-metrics">
                            <div><dt>@Localizer["HostingFinance_Balance"]</dt><dd>@FormatMoney(owner.Balance, owner.Currency)</dd></div>
                            <div><dt>@Localizer["HostingFinance_Allowance"]</dt><dd>@(owner.Allowance.HasValue ? FormatMoney(owner.Allowance.Value, owner.Currency) : Localizer["HostingFinance_None"])</dd></div>
                            <div><dt>@Localizer["HostingFinance_Reserved"]</dt><dd>@FormatMoney(owner.ReservedProviderCost, owner.Currency)</dd></div>
                            <div><dt>@Localizer["HostingFinance_Spendable"]</dt><dd>@FormatMoney(owner.SpendableAmount, owner.Currency)</dd></div>
                        </dl>
                    </section>

                    <div class="hosting-finance-actions">
                        <section class="utf-panel hosting-finance-action-card">
                            <div>
                                <span class="utf-kicker">@Localizer["HostingFinance_PaymentKicker"]</span>
                                <h3>@Localizer["HostingFinance_PaymentTitle"]</h3>
                                <p>@Localizer["HostingFinance_PaymentDescription"]</p>
                            </div>
                            <label class="utf-command-field"><span>@Localizer["HostingFinance_Amount"]</span><input class="utf-command-input" type="number" min="0.01" step="0.01" @bind="_paymentAmount"/></label>
                            <label class="utf-command-field"><span>@Localizer["HostingFinance_Reference"]</span><input class="utf-command-input" maxlength="128" @bind="_paymentReference"/></label>
                            <label class="utf-command-field"><span>@Localizer["HostingFinance_Note"]</span><textarea class="utf-command-input" rows="3" maxlength="512" @bind="_paymentReason"></textarea></label>
                            <UtfCommandButton Variant="primary" Disabled="@(!CanRecordPayment || _isSavingOwner)" OnClick="RecordPaymentAsync">
                                @Localizer["HostingFinance_RecordPayment"]
                            </UtfCommandButton>
                        </section>

                        <section class="utf-panel hosting-finance-action-card">
                            <div>
                                <span class="utf-kicker">@Localizer["HostingFinance_RefundKicker"]</span>
                                <h3>@Localizer["HostingFinance_RefundTitle"]</h3>
                                <p>@Localizer["HostingFinance_RefundDescription"]</p>
                            </div>
                            <label class="utf-command-field"><span>@Localizer["HostingFinance_Amount"]</span><input class="utf-command-input" type="number" min="0.01" step="0.01" @bind="_refundAmount"/></label>
                            <label class="utf-command-field"><span>@Localizer["HostingFinance_Reference"]</span><input class="utf-command-input" maxlength="128" @bind="_refundReference"/></label>
                            <label class="utf-command-field"><span>@Localizer["HostingFinance_Reason"]</span><textarea class="utf-command-input" rows="3" maxlength="512" @bind="_refundReason"></textarea></label>
                            <UtfCommandButton Variant="danger" Disabled="@(!CanRecordRefund || _isSavingOwner)" OnClick="RecordRefundAsync">
                                @Localizer["HostingFinance_RecordRefund"]
                            </UtfCommandButton>
                        </section>

                        <section class="utf-panel hosting-finance-action-card">
                            <div>
                                <span class="utf-kicker">@Localizer["HostingFinance_AllowanceKicker"]</span>
                                <h3>@Localizer["HostingFinance_AllowanceTitle"]</h3>
                                <p>@Localizer["HostingFinance_AllowanceDescription"]</p>
                            </div>
                            <label class="utf-command-field"><span>@Localizer["HostingFinance_AllowanceAmount"]</span><input class="utf-command-input" type="number" min="0" step="0.01" disabled="@_revokeAllowance" @bind="_allowance"/></label>
                            <label class="hosting-finance-check"><input type="checkbox" @bind="_revokeAllowance"/><span>@Localizer["HostingFinance_RevokeAllowance"]</span></label>
                            <label class="utf-command-field"><span>@Localizer["HostingFinance_Reason"]</span><textarea class="utf-command-input" rows="3" maxlength="512" @bind="_allowanceReason"></textarea></label>
                            <UtfCommandButton Variant="primary" Disabled="@(!CanManageAllowance || _isSavingOwner)" OnClick="SaveAllowanceAsync">
                                @Localizer["HostingFinance_SaveAllowance"]
                            </UtfCommandButton>
                        </section>

                        <section class="utf-panel hosting-finance-action-card">
                            <div>
                                <span class="utf-kicker">@Localizer["HostingFinance_CorrectionKicker"]</span>
                                <h3>@Localizer["HostingFinance_CorrectionTitle"]</h3>
                                <p>@Localizer["HostingFinance_CorrectionDescription"]</p>
                            </div>
                            <label class="utf-command-field"><span>@Localizer["HostingFinance_DeploymentId"]</span><input class="utf-command-input" autocomplete="off" @bind="_deploymentId"/></label>
                            <label class="utf-command-field"><span>@Localizer["HostingFinance_CorrectOwnerId"]</span><input class="utf-command-input" autocomplete="off" @bind="_correctOwnerId"/></label>
                            <label class="utf-command-field"><span>@Localizer["HostingFinance_CorrectionAmount"]</span><input class="utf-command-input" type="number" min="0.01" step="0.01" @bind="_correctionAmount"/></label>
                            <label class="utf-command-field"><span>@Localizer["HostingFinance_Reason"]</span><textarea class="utf-command-input" rows="3" maxlength="512" @bind="_correctionReason"></textarea></label>
                            <UtfCommandButton Variant="danger" Disabled="@(!CanCorrectLedger || _isSavingOwner)" OnClick="CorrectDeploymentCostOwnerAsync">
                                @Localizer["HostingFinance_RecordCorrection"]
                            </UtfCommandButton>
                        </section>
                    </div>

                    <section class="utf-panel hosting-finance-ledger-panel">
                        <div class="hosting-finance-section-heading">
                            <div>
                                <span class="utf-kicker">@Localizer["HostingFinance_LedgerKicker"]</span>
                                <h2>@Localizer["HostingFinance_LedgerTitle"]</h2>
                            </div>
                        </div>
                        @if (owner.RecentLedgerEntries.Count == 0)
                        {
                            <div class="hosting-finance-browser-state">@Localizer["HostingFinance_NoLedgerEntries"]</div>
                        }
                        else
                        {
                            <div class="utf-command-table-scroll">
                                <table class="utf-command-table">
                                    <thead>
                                    <tr>
                                        <th>@Localizer["HostingFinance_ColumnEffective"]</th>
                                        <th>@Localizer["HostingFinance_ColumnKind"]</th>
                                        <th>@Localizer["HostingFinance_ColumnAmount"]</th>
                                        <th>@Localizer["HostingFinance_ColumnBalance"]</th>
                                        <th>@Localizer["HostingFinance_ColumnContext"]</th>
                                        @if (CanCorrectLedger)
                                        {
                                            <th>@Localizer["HostingFinance_ColumnActions"]</th>
                                        }
                                    </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var entry in owner.RecentLedgerEntries)
                                    {
                                        var context = string.Join(
                                            " · ",
                                            new[] { entry.ExternalReference, entry.Reason }
                                                .Where(q => !string.IsNullOrWhiteSpace(q)));
                                        <tr>
                                            <td>@entry.TimeStampEffective.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</td>
                                            <td>@FormatLedgerKind(entry.Kind)</td>
                                            <td class="@(entry.Amount < 0 ? "hosting-finance-negative" : "hosting-finance-positive")">@FormatMoney(entry.Amount, entry.Currency)</td>
                                            <td>@FormatMoney(entry.BalanceAfter, entry.Currency)</td>
                                            <td>
                                                <span>@(string.IsNullOrWhiteSpace(context) ? Localizer["HostingFinance_NotAvailable"] : context)</span>
                                                <details class="hosting-finance-audit-details">
                                                    <summary>@Localizer["HostingFinance_AuditDetails"]</summary>
                                                    <dl>
                                                        <div><dt>@Localizer["HostingFinance_EntryId"]</dt><dd><code>@entry.Id</code></dd></div>
                                                        <div><dt>@Localizer["HostingFinance_Recorded"]</dt><dd>@entry.TimeStampRecorded.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</dd></div>
                                                        <div><dt>@Localizer["HostingFinance_RecordedBy"]</dt><dd>@FormatIdentifier(entry.RecordedById)</dd></div>
                                                        <div><dt>@Localizer["HostingFinance_RecordIdentifier"]</dt><dd>@FormatIdentifier(entry.RecordIdentifier)</dd></div>
                                                        <div><dt>@Localizer["HostingFinance_FinanceOperation"]</dt><dd>@FormatIdentifier(entry.FinanceOperationId)</dd></div>
                                                        <div><dt>@Localizer["HostingFinance_DeploymentId"]</dt><dd>@FormatIdentifier(entry.DeploymentId)</dd></div>
                                                        <div><dt>@Localizer["HostingFinance_ReversedEntry"]</dt><dd>@FormatIdentifier(entry.ReversedEntryId)</dd></div>
                                                    </dl>
                                                </details>
                                            </td>
                                            @if (CanCorrectLedger)
                                            {
                                                <td>
                                                    <UtfCommandButton Disabled="@(!CanReverseEntry(entry) || _isSavingOwner)"
                                                                      OnClick="@(() => SelectReversalTarget(entry))">
                                                        @Localizer["HostingFinance_ReverseEntry"]
                                                    </UtfCommandButton>
                                                </td>
                                            }
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>

                    @if (_reversalTarget is { } reversalTarget)
                    {
                        <section class="utf-panel hosting-finance-action-card hosting-finance-reversal">
                            <div>
                                <span class="utf-kicker">@Localizer["HostingFinance_ReversalKicker"]</span>
                                <h3>@Localizer["HostingFinance_ReversalTitle"]</h3>
                                <p>@string.Format(CultureInfo.CurrentCulture, Localizer["HostingFinance_ReversalDescription"].Value, reversalTarget.Id)</p>
                            </div>
                            <label class="utf-command-field"><span>@Localizer["HostingFinance_Reason"]</span><textarea class="utf-command-input" rows="3" maxlength="512" @bind="_reversalReason"></textarea></label>
                            <div class="hosting-finance-reversal-actions">
                                <UtfCommandButton Disabled="@_isSavingOwner" OnClick="CancelReversal">
                                    @Localizer["Common_Cancel"]
                                </UtfCommandButton>
                                <UtfCommandButton Variant="danger" Disabled="@_isSavingOwner" OnClick="ReverseLedgerEntryAsync">
                                    @Localizer["HostingFinance_ReverseEntry"]
                                </UtfCommandButton>
                            </div>
                        </section>
                    }
                }
            </main>
        </div>
    }
</div>

@code {
    private const int PageSize = 20;
    private IReadOnlyList<HostingCostOwnerInfo> _owners = [];
    private HostingFinancePolicyInfo? _policy;
    private Guid? _selectedOwnerId;
    private long _totalOwnerCount;
    private int _pageIndex;
    private string _search = string.Empty;
    private decimal _minimumSafetyRangeEur;
    private int _reservationSliceMinutes = 15;
    private decimal _paymentAmount;
    private string _paymentReference = string.Empty;
    private string? _paymentReason;
    private decimal _refundAmount;
    private string _refundReference = string.Empty;
    private string _refundReason = string.Empty;
    private decimal _allowance;
    private bool _revokeAllowance;
    private string _allowanceReason = string.Empty;
    private string _deploymentId = string.Empty;
    private string _correctOwnerId = string.Empty;
    private decimal _correctionAmount;
    private string _correctionReason = string.Empty;
    private HostingLedgerEntryInfo? _reversalTarget;
    private string _reversalReason = string.Empty;
    private bool _isLoading;
    private bool _isLoadingOwners;
    private bool _isSavingPolicy;
    private bool _isSavingOwner;
    private string? _loadError;

    private bool CanViewFinance => Me.HasBaseClaim(Claims.Finance.All, Claims.Finance.ViewAll);
    private bool CanRecordPayment => Me.HasBaseClaim(Claims.Finance.All, Claims.Finance.RecordPayment);
    private bool CanRecordRefund => Me.HasBaseClaim(Claims.Finance.All, Claims.Finance.RecordRefund);
    private bool CanManageAllowance => Me.HasBaseClaim(Claims.Finance.All, Claims.Finance.ManageAllowance);
    private bool CanCorrectLedger => Me.HasBaseClaim(Claims.Finance.All, Claims.Finance.CorrectLedger);
    private bool CanManagePolicy => Me.HasBaseClaim(Claims.Finance.All, Claims.Finance.ManagePolicy);
    private bool HasNextPage => (_pageIndex + 1L) * PageSize < _totalOwnerCount;
    private HostingCostOwnerInfo? SelectedOwner => _owners.FirstOrDefault(q => q.CostOwnerId == _selectedOwnerId);

    protected override async Task OnInitializedAsync()
    {
        if (CanViewFinance)
            await RefreshAsync().ConfigureAwait(false);
    }

    private async Task RefreshAsync()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            _policy = await FinanceRepository.GetPolicyAsync().ConfigureAwait(false);
            _minimumSafetyRangeEur = _policy.MinimumSafetyRangeEur;
            _reservationSliceMinutes = _policy.ReservationSliceMinutes;
            await LoadOwnersAsync().ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            _loadError = string.Format(CultureInfo.CurrentCulture, Localizer["HostingFinance_LoadError"].Value, UserFacingError.Message(ex));
        }
        finally { _isLoading = false; }
    }

    private async Task LoadOwnersAsync(bool preserveSelection = true)
    {
        _isLoadingOwners = true;
        try
        {
            var page = await FinanceRepository.GetCostOwnersAsync(_search, _pageIndex * PageSize, PageSize).ConfigureAwait(false);
            _owners = page.Owners;
            _totalOwnerCount = page.TotalCount;
            if (!preserveSelection || _selectedOwnerId is null || _owners.All(q => q.CostOwnerId != _selectedOwnerId))
                _selectedOwnerId = null;
            LoadOwnerEditor();
        }
        finally { _isLoadingOwners = false; }
    }

    private Task OnSearchChanged(string value) { _search = value; return Task.CompletedTask; }
    private async Task SearchAsync() { _pageIndex = 0; await LoadOwnersAsync(false).ConfigureAwait(false); }
    private async Task PreviousPageAsync() { if (_pageIndex > 0) _pageIndex--; await LoadOwnersAsync(false).ConfigureAwait(false); }
    private async Task NextPageAsync() { if (HasNextPage) _pageIndex++; await LoadOwnersAsync(false).ConfigureAwait(false); }
    private void SelectOwner(HostingCostOwnerInfo owner) { _selectedOwnerId = owner.CostOwnerId; LoadOwnerEditor(); }

    private void LoadOwnerEditor()
    {
        _allowance = SelectedOwner?.Allowance ?? 0m;
        _revokeAllowance = SelectedOwner?.Allowance is null;
        _allowanceReason = string.Empty;
        _paymentAmount = 0m;
        _paymentReference = string.Empty;
        _paymentReason = null;
        _refundAmount = 0m;
        _refundReference = string.Empty;
        _refundReason = string.Empty;
        _deploymentId = string.Empty;
        _correctOwnerId = string.Empty;
        _correctionAmount = 0m;
        _correctionReason = string.Empty;
        _reversalTarget = null;
        _reversalReason = string.Empty;
    }

    private async Task SavePolicyAsync()
    {
        if (!CanManagePolicy) return;
        _isSavingPolicy = true;
        try
        {
            _policy = await FinanceRepository.UpdatePolicyAsync(_minimumSafetyRangeEur, _reservationSliceMinutes).ConfigureAwait(false);
            ToastService.ShowSuccess(Localizer["HostingFinance_PolicySaved"]);
        }
        catch (Exception ex) { ToastService.ShowError(UserFacingError.Message(ex)); }
        finally { _isSavingPolicy = false; }
    }

    private async Task RecordPaymentAsync()
    {
        if (!CanRecordPayment || SelectedOwner is not { } owner) return;
        if (_paymentAmount <= 0 || string.IsNullOrWhiteSpace(_paymentReference))
        {
            ToastService.ShowError(Localizer["HostingFinance_PaymentValidation"]);
            return;
        }
        _isSavingOwner = true;
        try
        {
            await FinanceRepository.RecordPaymentAsync(owner.CostOwnerId, _paymentAmount, DateTimeOffset.UtcNow, _paymentReference, _paymentReason).ConfigureAwait(false);
            ToastService.ShowSuccess(Localizer["HostingFinance_PaymentSaved"]);
            await LoadOwnersAsync().ConfigureAwait(false);
        }
        catch (Exception ex) { ToastService.ShowError(UserFacingError.Message(ex)); }
        finally { _isSavingOwner = false; }
    }

    private async Task SaveAllowanceAsync()
    {
        if (!CanManageAllowance || SelectedOwner is not { } owner) return;
        if (string.IsNullOrWhiteSpace(_allowanceReason) || (!_revokeAllowance && _allowance < 0))
        {
            ToastService.ShowError(Localizer["HostingFinance_AllowanceValidation"]);
            return;
        }
        _isSavingOwner = true;
        try
        {
            await FinanceRepository.ChangeAllowanceAsync(owner.CostOwnerId, _revokeAllowance ? null : _allowance, _allowanceReason).ConfigureAwait(false);
            ToastService.ShowSuccess(Localizer["HostingFinance_AllowanceSaved"]);
            await LoadOwnersAsync().ConfigureAwait(false);
        }
        catch (Exception ex) { ToastService.ShowError(UserFacingError.Message(ex)); }
        finally { _isSavingOwner = false; }
    }

    private async Task RecordRefundAsync()
    {
        if (!CanRecordRefund || SelectedOwner is not { } owner)
            return;
        if (_refundAmount <= 0
            || string.IsNullOrWhiteSpace(_refundReference)
            || string.IsNullOrWhiteSpace(_refundReason))
        {
            ToastService.ShowError(Localizer["HostingFinance_RefundValidation"]);
            return;
        }

        var confirmed = await ConfirmFinanceActionAsync(
                Localizer["HostingFinance_RefundConfirmTitle"],
                string.Format(
                    CultureInfo.CurrentCulture,
                    Localizer["HostingFinance_RefundConfirmDescription"].Value,
                    FormatMoney(_refundAmount, owner.Currency),
                    owner.DisplayName),
                owner.DisplayName,
                Localizer["HostingFinance_RecordRefund"])
            .ConfigureAwait(false);
        if (!confirmed)
            return;

        _isSavingOwner = true;
        try
        {
            await FinanceRepository.RecordRefundAsync(
                    owner.CostOwnerId,
                    _refundAmount,
                    DateTimeOffset.UtcNow,
                    _refundReference.Trim(),
                    _refundReason.Trim())
                .ConfigureAwait(false);
            ToastService.ShowSuccess(Localizer["HostingFinance_RefundSaved"]);
            await LoadOwnersAsync().ConfigureAwait(false);
        }
        catch (Exception ex) { ToastService.ShowError(UserFacingError.Message(ex)); }
        finally { _isSavingOwner = false; }
    }

    private async Task CorrectDeploymentCostOwnerAsync()
    {
        if (!CanCorrectLedger || SelectedOwner is not { } owner)
            return;
        if (!Guid.TryParse(_deploymentId, out var deploymentId)
            || !Guid.TryParse(_correctOwnerId, out var correctOwnerId)
            || correctOwnerId == owner.CostOwnerId
            || _correctionAmount <= 0
            || string.IsNullOrWhiteSpace(_correctionReason))
        {
            ToastService.ShowError(Localizer["HostingFinance_CorrectionValidation"]);
            return;
        }

        var confirmed = await ConfirmFinanceActionAsync(
                Localizer["HostingFinance_CorrectionConfirmTitle"],
                string.Format(
                    CultureInfo.CurrentCulture,
                    Localizer["HostingFinance_CorrectionConfirmDescription"].Value,
                    FormatMoney(_correctionAmount, owner.Currency),
                    owner.DisplayName,
                    correctOwnerId),
                owner.DisplayName,
                Localizer["HostingFinance_RecordCorrection"])
            .ConfigureAwait(false);
        if (!confirmed)
            return;

        _isSavingOwner = true;
        try
        {
            await FinanceRepository.CorrectDeploymentCostOwnerAsync(
                    owner.CostOwnerId,
                    deploymentId,
                    correctOwnerId,
                    _correctionAmount,
                    DateTimeOffset.UtcNow,
                    _correctionReason.Trim())
                .ConfigureAwait(false);
            ToastService.ShowSuccess(Localizer["HostingFinance_CorrectionSaved"]);
            await LoadOwnersAsync().ConfigureAwait(false);
        }
        catch (Exception ex) { ToastService.ShowError(UserFacingError.Message(ex)); }
        finally { _isSavingOwner = false; }
    }

    private void SelectReversalTarget(HostingLedgerEntryInfo entry)
    {
        if (!CanReverseEntry(entry))
            return;
        _reversalTarget = entry;
        _reversalReason = string.Empty;
    }

    private void CancelReversal()
    {
        _reversalTarget = null;
        _reversalReason = string.Empty;
    }

    private async Task ReverseLedgerEntryAsync()
    {
        if (!CanCorrectLedger
            || SelectedOwner is not { } owner
            || _reversalTarget is not { } target
            || !CanReverseEntry(target)
            || string.IsNullOrWhiteSpace(_reversalReason))
        {
            ToastService.ShowError(Localizer["HostingFinance_ReversalValidation"]);
            return;
        }

        var confirmed = await ConfirmFinanceActionAsync(
                Localizer["HostingFinance_ReversalConfirmTitle"],
                string.Format(
                    CultureInfo.CurrentCulture,
                    Localizer["HostingFinance_ReversalConfirmDescription"].Value,
                    target.Id),
                owner.DisplayName,
                Localizer["HostingFinance_ReverseEntry"])
            .ConfigureAwait(false);
        if (!confirmed)
            return;

        _isSavingOwner = true;
        try
        {
            await FinanceRepository.ReverseLedgerEntryAsync(
                    owner.CostOwnerId,
                    target.Id,
                    DateTimeOffset.UtcNow,
                    _reversalReason.Trim())
                .ConfigureAwait(false);
            ToastService.ShowSuccess(Localizer["HostingFinance_ReversalSaved"]);
            await LoadOwnersAsync().ConfigureAwait(false);
        }
        catch (Exception ex) { ToastService.ShowError(UserFacingError.Message(ex)); }
        finally { _isSavingOwner = false; }
    }

    private async Task<bool> ConfirmFinanceActionAsync(
        string title,
        string message,
        string challenge,
        string confirmLabel)
        => await DialogService.ShowUtfChallengeConfirmationAsync(
                title,
                message,
                challenge,
                string.Format(
                    CultureInfo.CurrentCulture,
                    Localizer["HostingFinance_ConfirmChallenge"].Value,
                    challenge),
                confirmLabel,
                Localizer["Common_Cancel"],
                kicker: Localizer["HostingFinance_LedgerKicker"])
            .ConfigureAwait(false) is not null;

    private bool CanReverseEntry(HostingLedgerEntryInfo entry)
        => entry.Kind is not EHostingLedgerEntryKind.ProviderCostSlice
           and not EHostingLedgerEntryKind.AllowanceChanged
           && SelectedOwner?.RecentLedgerEntries.All(q => q.ReversedEntryId != entry.Id) == true;

    private static string FormatMoney(decimal value, string currency) => $"{value:N2} {currency}";
    private string FormatIdentifier(Guid? identifier)
        => identifier?.ToString() ?? Localizer["HostingFinance_NotAvailable"];
    private string FormatPageLabel() => string.Format(CultureInfo.CurrentCulture, Localizer["HostingFinance_PageLabel"].Value, _pageIndex + 1, Math.Max(1, (int)Math.Ceiling(_totalOwnerCount / (double)PageSize)));
    private string GetOwnerButtonClass(HostingCostOwnerInfo owner) => owner.CostOwnerId == _selectedOwnerId ? "hosting-finance-owner hosting-finance-owner--selected" : "hosting-finance-owner";
    private static string GetInitials(string value) => string.Concat(value.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(q => char.ToUpperInvariant(q[0])));
    private string FormatOwnerKind(ECostOwnerKind kind) => kind switch
    {
        ECostOwnerKind.User => Localizer["HostingFinance_OwnerMember"],
        ECostOwnerKind.Verein => Localizer["HostingFinance_OwnerVerein"],
        ECostOwnerKind.ExternalOrganization => Localizer["HostingFinance_OwnerOrganization"],
        _ => kind.ToString(),
    };
    private string FormatLedgerKind(EHostingLedgerEntryKind kind) => Localizer[$"HostingFinance_LedgerKind_{kind}"].ResourceNotFound ? kind.ToString() : Localizer[$"HostingFinance_LedgerKind_{kind}"];
}
