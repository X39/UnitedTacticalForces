@page "/verein"
@using System.Globalization
@using X39.UnitedTacticalForces.Common.Verein
@using X39.UnitedTacticalForces.WebApp.Services
@using X39.UnitedTacticalForces.WebApp.Services.SiteImageSettingsRepository
@using X39.UnitedTacticalForces.WebApp.Services.VereinRepository
@inject IVereinRepository VereinRepository
@inject MeService Me
@inject BaseUrl BaseUrl
@inject ISiteImageSettingsRepository SiteImageSettingsRepository
@inject IStringLocalizer<Language> Localizer

<PageTitle>@Localizer[nameof(Language.Pages_Verein_Index_PageTitle)]</PageTitle>

<div class="utf-community-page utf-unit-page utf-verein-page">
    <header class="utf-community-page-hero utf-unit-hero utf-verein-hero" style="@HeroImageStyle">
        <div class="utf-unit-hero__copy">
            <span class="utf-kicker">@Localizer[nameof(Language.Pages_Verein_Index_Kicker)]</span>
            <h1>@Localizer[nameof(Language.Pages_Verein_Index_Title)]</h1>
            <p>@Localizer[nameof(Language.Pages_Verein_Index_Subtitle)]</p>
            <div class="utf-unit-actions">
                <a class="utf-button utf-button--primary" href="@BaseUrl.ResolveSelfUrl("join")">
                    @Localizer[nameof(Language.Pages_Verein_Index_MembershipRequest)]
                </a>
                <a class="utf-button utf-button--ghost" href="@BaseUrl.ResolveSelfUrl("verein/satzung")">
                    @Localizer[nameof(Language.Pages_Verein_Index_ReadSatzung)]
                </a>
            </div>
        </div>

        <aside class="utf-unit-hero-panel" aria-label="@(Localizer[nameof(Language.Pages_Verein_Index_StatusAria)])">
            <div class="utf-unit-panel-heading">
                <FluentIcon Value="@(new Icons.Regular.Size24.DocumentBulletListClock())"/>
                <div>
                    <span>@Localizer[nameof(Language.Pages_Verein_Index_StatusKicker)]</span>
                    <strong>@GetMembershipStatusTitle()</strong>
                </div>
            </div>
            <dl class="utf-unit-status-list">
                <div>
                    <dt>@Localizer[nameof(Language.Pages_Verein_Index_ProfileStatus)]</dt>
                    <dd>@GetMembershipStatusDetail()</dd>
                </div>
                <div>
                    <dt>@Localizer[nameof(Language.Pages_Verein_Index_DocumentsStatus)]</dt>
                    <dd>@FormatDocumentStatus()</dd>
                </div>
                <div>
                    <dt>@Localizer[nameof(Language.Pages_Verein_Index_LedgerStatus)]</dt>
                    <dd>@GetLedgerStatus()</dd>
                </div>
            </dl>
        </aside>
    </header>

    <section class="utf-community-page-section utf-unit-section">
        @if (_isLoading)
        {
            <div class="utf-state-panel">
                @Localizer[nameof(Language.Pages_Verein_Index_Loading)]
                <FluentProgress Width="240px"/>
            </div>
        }
        else
        {
            @if (_loadError is not null)
            {
                <div class="utf-state-panel utf-state-panel--warning" role="alert">
                    @_loadError
                </div>
            }

            <div class="utf-section-heading utf-section-heading--row">
                <div>
                    <span class="utf-kicker">@Localizer[nameof(Language.Pages_Verein_Index_WorkspaceKicker)]</span>
                    <h2>@Localizer[nameof(Language.Pages_Verein_Index_WorkspaceTitle)]</h2>
                </div>
                <span class="utf-unit-section-note">@Localizer[nameof(Language.Pages_Verein_Index_WorkspaceNote)]</span>
            </div>

            <div class="utf-unit-feature-grid">
                <article class="utf-unit-feature-card">
                    <div class="utf-unit-feature-card__top">
                        <span class="utf-unit-feature-icon">
                            <FluentIcon Value="@(new Icons.Regular.Size24.DocumentBulletListClock())"/>
                        </span>
                        <span class="utf-unit-state utf-unit-state--active">@Localizer[nameof(Language.Pages_Verein_Index_PublicState)]</span>
                    </div>
                    <h3>@Localizer[nameof(Language.Pages_Verein_Index_SatzungTitle)]</h3>
                    <p>@Localizer[nameof(Language.Pages_Verein_Index_SatzungBody)]</p>
                    <a class="utf-unit-feature-card__action" href="@BaseUrl.ResolveSelfUrl("verein/satzung")">
                        @Localizer[nameof(Language.Pages_Verein_Index_ReadSatzung)]
                    </a>
                </article>

                <article class="utf-unit-feature-card">
                    <div class="utf-unit-feature-card__top">
                        <span class="utf-unit-feature-icon">
                            <FluentIcon Value="@(new Icons.Regular.Size24.DocumentBulletListClock())"/>
                        </span>
                        <span class="utf-unit-state utf-unit-state--active">@Localizer[nameof(Language.Pages_Verein_Index_PublicState)]</span>
                    </div>
                    <h3>@Localizer[nameof(Language.Pages_Verein_Index_MinutesTitle)]</h3>
                    <p>@Localizer[nameof(Language.Pages_Verein_Index_MinutesBody)]</p>
                    <a class="utf-unit-feature-card__action" href="@BaseUrl.ResolveSelfUrl("verein/beschluesse")">
                        @Localizer[nameof(Language.Pages_Verein_Index_OpenArchive)]
                    </a>
                </article>

                <article class="utf-unit-feature-card">
                    <div class="utf-unit-feature-card__top">
                        <span class="utf-unit-feature-icon">
                            <FluentIcon Value="@(new Icons.Regular.Size24.WalletCreditCard())"/>
                        </span>
                        <span class="@GetLedgerStateClass()">@GetLedgerStateLabel()</span>
                    </div>
                    <h3>@Localizer[nameof(Language.Pages_Verein_Index_KassenbuchTitle)]</h3>
                    <p>@Localizer[nameof(Language.Pages_Verein_Index_KassenbuchBody)]</p>
                    <a class="utf-unit-feature-card__action" href="@BaseUrl.ResolveSelfUrl("verein/kassenbuch")">
                        @Localizer[nameof(Language.Pages_Verein_Index_OpenKassenbuch)]
                    </a>
                </article>

                <article class="utf-unit-feature-card">
                    <div class="utf-unit-feature-card__top">
                        <span class="utf-unit-feature-icon">
                            <FluentIcon Value="@(new Icons.Regular.Size24.PeopleTeam())"/>
                        </span>
                        <span class="@GetRequestStateClass()">@GetRequestStateLabel()</span>
                    </div>
                    <h3>@Localizer[nameof(Language.Pages_Verein_Index_MembershipTitle)]</h3>
                    <p>@GetRequestCardBody()</p>
                    <a class="utf-unit-feature-card__action" href="@BaseUrl.ResolveSelfUrl(GetRequestCardHref())">
                        @GetRequestCardAction()
                    </a>
                </article>
            </div>
        }
    </section>
</div>

@code {
    private VereinDocumentInfo? _satzung;
    private IReadOnlyList<VereinDocumentInfo> _minutes = [];
    private VereinMembershipRequestInfo? _request;
    private bool _isLoading = true;
    private string? _loadError;
    private IReadOnlyDictionary<string, SiteImageSettingInfo> _siteImages =
        new Dictionary<string, SiteImageSettingInfo>(StringComparer.OrdinalIgnoreCase);

    private bool CanReadKassenbuch
        => Me.IsVereinMember || Me.HasBaseClaimOrVereinAdmin(Claims.Verein.All, Claims.Verein.Kassenbuch);

    private string HeroImageStyle
        => $"--utf-hero-image: url('{GetSiteImageUrl("verein-hero", "media/generated/verein-governance-table-hero.jpg")}');";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _satzung = await VereinRepository.GetPublishedSatzungAsync().ConfigureAwait(false);
            _minutes = await VereinRepository.GetPublishedMinutesAsync(take: 6).ConfigureAwait(false);
            await LoadSiteImagesAsync().ConfigureAwait(false);
            if (Me.IsAuthenticated && !Me.IsVereinMember)
                _request = await VereinRepository.GetMyMembershipRequestAsync().ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            _loadError = string.Format(CultureInfo.CurrentCulture, Localizer[nameof(Language.Pages_Verein_Index_LoadError)].Value, UserFacingError.Message(ex));
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadSiteImagesAsync()
    {
        try
        {
            _siteImages = (await SiteImageSettingsRepository.GetSettingsAsync().ConfigureAwait(false))
                .ToDictionary(q => q.Key, StringComparer.OrdinalIgnoreCase);
        }
        catch
        {
            _siteImages = new Dictionary<string, SiteImageSettingInfo>(StringComparer.OrdinalIgnoreCase);
        }
    }

    private string GetSiteImageUrl(string key, string fallbackResourcePath)
        => _siteImages.TryGetValue(key, out var setting) && !string.IsNullOrWhiteSpace(setting.ImagePath)
            ? BaseUrl.ResolveImageUrl(setting.ImagePath)
            : BaseUrl.ResolveResourceUrl(fallbackResourcePath);

    private string GetMembershipStatusTitle()
    {
        if (Me.IsVereinMember)
            return string.IsNullOrWhiteSpace(Me.VereinMemberNumber)
                ? Localizer[nameof(Language.Pages_Verein_Index_ActiveMember)].Value
                : string.Format(CultureInfo.CurrentCulture, Localizer[nameof(Language.Pages_Verein_Index_ActiveMemberNumber)].Value, Me.VereinMemberNumber);
        if (_request is not null)
            return GetRequestStatusLabel(_request.Status);
        return Me.IsAuthenticated
            ? Localizer[nameof(Language.Pages_Verein_Index_NoRequest)].Value
            : Localizer[nameof(Language.Pages_Verein_Index_SignInForStatus)].Value;
    }

    private string GetMembershipStatusDetail()
    {
        if (Me.IsVereinMember)
            return Localizer[nameof(Language.Pages_Verein_Index_ActiveMemberDetail)].Value;
        if (_request is not null)
            return string.Format(CultureInfo.CurrentCulture, Localizer[nameof(Language.Pages_Verein_Index_RequestUpdated)].Value, FormatDate(_request.TimeStampUpdated));
        return Me.IsAuthenticated
            ? Localizer[nameof(Language.Pages_Verein_Index_NoRequestDetail)].Value
            : Localizer[nameof(Language.Pages_Verein_Index_SignInDetail)].Value;
    }

    private string FormatDocumentStatus()
        => string.Format(
            CultureInfo.CurrentCulture,
            Localizer[nameof(Language.Pages_Verein_Index_DocumentsStatusValue)].Value,
            _satzung is null ? 0 : 1,
            _minutes.Count
        );

    private string GetLedgerStatus()
        => CanReadKassenbuch
            ? Localizer[nameof(Language.Pages_Verein_Index_LedgerAccessible)].Value
            : Localizer[nameof(Language.Pages_Verein_Index_LedgerRestricted)].Value;

    private string GetLedgerStateClass()
        => CanReadKassenbuch ? "utf-unit-state utf-unit-state--active" : "utf-unit-state utf-unit-state--restricted";

    private string GetLedgerStateLabel()
        => CanReadKassenbuch ? Localizer[nameof(Language.Pages_Verein_Index_MemberState)].Value : Localizer[nameof(Language.Pages_Verein_Index_MembersOnlyState)].Value;

    private string GetRequestStateClass()
        => _request?.Status switch
        {
            EVereinMembershipRequestStatus.Approved           => "utf-unit-state utf-unit-state--active",
            EVereinMembershipRequestStatus.Rejected           => "utf-unit-state utf-unit-state--restricted",
            EVereinMembershipRequestStatus.Submitted          => "utf-unit-state utf-unit-state--planned",
            EVereinMembershipRequestStatus.AcceptedForContact => "utf-unit-state utf-unit-state--planned",
            EVereinMembershipRequestStatus.Withdrawn          => "utf-unit-state",
            _ when Me.IsVereinMember                          => "utf-unit-state utf-unit-state--active",
            _                                                 => "utf-unit-state utf-unit-state--planned",
        };

    private string GetRequestStateLabel()
    {
        if (Me.IsVereinMember)
            return Localizer[nameof(Language.Pages_Verein_Index_MemberState)].Value;
        return _request is null
            ? Localizer[nameof(Language.Pages_Verein_Index_RequestStateOpen)].Value
            : GetRequestStatusLabel(_request.Status);
    }

    private string GetRequestStatusLabel(EVereinMembershipRequestStatus status)
        => status switch
        {
            EVereinMembershipRequestStatus.Submitted          => Localizer[nameof(Language.Pages_Public_Join_RequestStatus_Submitted)].Value,
            EVereinMembershipRequestStatus.AcceptedForContact => Localizer[nameof(Language.Pages_Public_Join_RequestStatus_AcceptedForContact)].Value,
            EVereinMembershipRequestStatus.Approved           => Localizer[nameof(Language.Pages_Public_Join_RequestStatus_Approved)].Value,
            EVereinMembershipRequestStatus.Rejected           => Localizer[nameof(Language.Pages_Public_Join_RequestStatus_Rejected)].Value,
            EVereinMembershipRequestStatus.Withdrawn          => Localizer[nameof(Language.Pages_Public_Join_RequestStatus_Withdrawn)].Value,
            _                                                 => throw new ArgumentOutOfRangeException(nameof(status), status, null),
        };

    private string GetRequestCardBody()
    {
        if (Me.IsVereinMember)
            return Localizer[nameof(Language.Pages_Verein_Index_MembershipActiveBody)].Value;
        if (_request is not null)
            return string.Format(CultureInfo.CurrentCulture, Localizer[nameof(Language.Pages_Verein_Index_MembershipRequestBody)].Value, FormatDate(_request.TimeStampUpdated));
        return Localizer[nameof(Language.Pages_Verein_Index_MembershipOpenBody)].Value;
    }

    private string GetRequestCardHref()
        => Me.IsVereinMember ? "settings" : "join";

    private string GetRequestCardAction()
        => Me.IsVereinMember
            ? Localizer[nameof(Language.Pages_Verein_Index_OpenSettings)].Value
            : Localizer[nameof(Language.Pages_Verein_Index_MembershipRequest)].Value;

    private static string FormatDate(DateTimeOffset value)
        => value.ToLocalTime().ToString("dd.MM.yyyy HH:mm", CultureInfo.CurrentCulture);
}
