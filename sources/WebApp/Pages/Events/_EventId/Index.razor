@page "/events/{EventId:guid}"
@using System.Collections.Immutable
@using System.Globalization
@using System.Text.RegularExpressions
@using X39.UnitedTacticalForces.WebApp.UtfApi.Models
@using X39.UnitedTacticalForces.WebApp.Data
@using X39.UnitedTacticalForces.WebApp.Services
@using X39.UnitedTacticalForces.WebApp.Services.EventRepository
@using X39.UnitedTacticalForces.WebApp.Services.SiteImageSettingsRepository
@using X39.UnitedTacticalForces.WebApp.Services.SlotRepository
@using X39.UnitedTacticalForces.WebApp.Services.UserRepository
@using X39.UnitedTacticalForces.WebApp.UtfApi.Models
@inject IEventRepository EventRepository
@inject ISiteImageSettingsRepository SiteImageSettingsRepository
@inject ISlotRepository SlotRepository
@inject IUserRepository UserRepository
@inject NavigationManager NavigationManager
@inject BaseUrl BaseUrl
@inject IStringLocalizer<Language> Localizer
@inject MeService Me

<PageTitle>@(_event?.Title ?? Localizer[nameof(Language.Pages_Events_Detail_PageTitleFallback)].Value)</PageTitle>

<div class="utf-event-detail">
    @if (_isLoading)
    {
        <section class="utf-event-detail-skeleton" aria-label="@(Localizer[nameof(Language.Auto_OperationLoading_7d19a411)])" aria-busy="true">
            <span class="utf-sr-only">@Localizer[nameof(Language.Auto_OperationIsLoading_e4663d01)]</span>

            <div class="utf-mission-banner utf-mission-banner--skeleton" aria-hidden="true">
                <div class="utf-mission-banner__content">
                    <span class="utf-skeleton utf-event-skeleton__back"></span>
                    <span class="utf-skeleton utf-event-skeleton__tag"></span>
                    <span class="utf-skeleton utf-event-skeleton__title"></span>

                    <div class="utf-mission-meta utf-mission-meta--skeleton">
                        @for (var index = 0; index < MissionMetaSkeletonItemCount; index++)
                        {
                            <div class="utf-mission-meta__item">
                                <span class="utf-skeleton utf-event-skeleton__icon"></span>
                                <div>
                                    <span class="utf-skeleton utf-event-skeleton__label"></span>
                                    <span class="utf-skeleton utf-event-skeleton__strong"></span>
                                    <span class="utf-skeleton utf-event-skeleton__small"></span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="utf-event-detail__grid utf-event-detail__grid--skeleton" aria-hidden="true">
                <main class="utf-event-detail__main">
                    <section class="utf-briefing-panel utf-briefing-panel--skeleton">
                        <header class="utf-panel-title">
                            <span class="utf-skeleton utf-event-skeleton__panel-icon"></span>
                            <span class="utf-skeleton utf-event-skeleton__panel-title"></span>
                        </header>

                        <div class="utf-briefing-skeleton__objectives">
                            @for (var index = 0; index < BriefingObjectiveSkeletonItemCount; index++)
                            {
                                <div class="utf-briefing-skeleton__objective">
                                    <span class="utf-skeleton utf-event-skeleton__objective-icon"></span>
                                    <span class="utf-skeleton utf-event-skeleton__objective-line"></span>
                                </div>
                            }
                        </div>

                        <div class="utf-briefing-notes utf-briefing-notes--skeleton">
                            <span class="utf-skeleton utf-event-skeleton__kicker"></span>
                            <span class="utf-skeleton utf-event-skeleton__section-title"></span>
                            <span class="utf-skeleton utf-event-skeleton__briefing-line"></span>
                            <span class="utf-skeleton utf-event-skeleton__briefing-line"></span>
                            <span class="utf-skeleton utf-event-skeleton__briefing-line utf-event-skeleton__briefing-line--short"></span>
                        </div>
                    </section>

                    <section class="utf-roster-panel utf-roster-panel--skeleton">
                        <header class="utf-roster-panel__header">
                            <div class="utf-panel-title">
                                <span class="utf-skeleton utf-event-skeleton__panel-icon"></span>
                                <span class="utf-skeleton utf-event-skeleton__panel-title"></span>
                            </div>
                            <span class="utf-skeleton utf-event-skeleton__roster-count"></span>
                        </header>

                        <div class="utf-slot-register" role="presentation">
                            <div class="utf-slot-register__head">
                                <span class="utf-skeleton utf-event-skeleton__head-cell"></span>
                                <span class="utf-skeleton utf-event-skeleton__head-cell"></span>
                                <span class="utf-skeleton utf-event-skeleton__head-cell"></span>
                                <span></span>
                            </div>

                            @for (var groupIndex = 0; groupIndex < SlotGroupSkeletonCount; groupIndex++)
                            {
                                <section class="utf-roster-group utf-roster-group--skeleton">
                                    <header class="utf-roster-group__header">
                                        <div>
                                            <span class="utf-skeleton utf-event-skeleton__group-icon"></span>
                                            <span class="utf-skeleton utf-event-skeleton__group-title"></span>
                                        </div>
                                        <span class="utf-skeleton utf-event-skeleton__group-count"></span>
                                    </header>

                                    @for (var rowIndex = 0; rowIndex < SlotRowSkeletonCount; rowIndex++)
                                    {
                                        <article class="utf-slot-row utf-slot-row--skeleton">
                                            <div class="utf-slot-role-cell">
                                                <span class="utf-skeleton utf-event-skeleton__role-icon"></span>
                                                <div>
                                                    <span class="utf-skeleton utf-event-skeleton__side-pill"></span>
                                                    <span class="utf-skeleton utf-event-skeleton__slot-title"></span>
                                                    <span class="utf-skeleton utf-event-skeleton__slot-small"></span>
                                                </div>
                                            </div>

                                            <div class="utf-slot-assignee">
                                                <div class="utf-slot-user-stack">
                                                    <span class="utf-skeleton utf-event-skeleton__avatar"></span>
                                                    <div>
                                                        <span class="utf-skeleton utf-event-skeleton__assignee"></span>
                                                        <span class="utf-skeleton utf-event-skeleton__assignee-subtitle"></span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="utf-slot-status">
                                                <span class="utf-skeleton utf-event-skeleton__status-pill"></span>
                                            </div>

                                            <div class="utf-slot-row-actions">
                                                <span class="utf-skeleton utf-event-skeleton__slot-button"></span>
                                                <span class="utf-skeleton utf-event-skeleton__slot-menu"></span>
                                            </div>
                                        </article>
                                    }
                                </section>
                            }
                        </div>
                    </section>
                </main>

                <aside class="utf-attendance-panel utf-attendance-panel--skeleton">
                    @for (var cardIndex = 0; cardIndex < SideCardSkeletonCount; cardIndex++)
                    {
                        <section class="utf-side-card utf-side-card--skeleton">
                            <header class="utf-side-card__header">
                                <span class="utf-skeleton utf-event-skeleton__panel-icon"></span>
                                <span class="utf-skeleton utf-event-skeleton__side-title"></span>
                            </header>
                            <span class="utf-skeleton utf-event-skeleton__side-line"></span>
                            <span class="utf-skeleton utf-event-skeleton__side-line utf-event-skeleton__side-line--short"></span>
                            <span class="utf-skeleton utf-event-skeleton__side-button"></span>
                        </section>
                    }
                </aside>
            </div>
        </section>
    }
    else if (_loadError is not null)
    {
        <section class="utf-state-panel utf-state-panel--warning">
            <strong>@Localizer[nameof(Language.Auto_OperationUnavailable_9b70eeab)]</strong>
            <p>@_loadError</p>
            <a class="utf-button utf-button--ghost" href="@BaseUrl.ResolveSelfUrl("events/upcoming")">
                @Localizer[nameof(Language.Auto_BackToOperations_3057840c)]
            </a>
        </section>
    }
    else if (_event is not null)
    {
        <section class="utf-mission-banner" style="@GetMissionBannerStyle()">
            <div class="utf-mission-banner__content">
                <a class="utf-event-back-link" href="@BaseUrl.ResolveSelfUrl("events/upcoming")">
                    <FluentIcon Value="@(new Icons.Regular.Size20.ArrowLeft())"/>
                    @Localizer[nameof(Language.Auto_BackToEvents_6f92c820)]
                </a>
                <span class="utf-operation-tag">@Localizer[nameof(Language.Operation)]</span>
                <h1>@(_event.Title ?? Localizer[nameof(Language.Pages_Events_Detail_UntitledOperation)].Value)</h1>

                <div class="utf-mission-meta" aria-label="@(Localizer[nameof(Language.Auto_MissionMetadata_384bdc08)])">
                    <div class="utf-mission-meta__item">
                        <FluentIcon Value="@(new Icons.Regular.Size20.CalendarLtr())"/>
                        <div>
                            <span>@Localizer[nameof(Language.Date)]</span>
                            <strong>@FormatDate(_event.ScheduledFor)</strong>
                            <small>@FormatDay(_event.ScheduledFor)</small>
                        </div>
                    </div>
                    <div class="utf-mission-meta__item">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Clock())"/>
                        <div>
                            <span>@Localizer[nameof(Language.Time)]</span>
                            <strong>@FormatUtcTime(_event.ScheduledFor)</strong>
                            <small>@FormatLocalTime(_event.ScheduledFor)</small>
                        </div>
                    </div>
                    <div class="utf-mission-meta__item">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Map())"/>
                        <div>
                            <span>@Localizer[nameof(Language.Terrain)]</span>
                            <strong>@(_event.TerrainTitle ?? Localizer[nameof(Language.Pages_Events_Detail_Status_TerrainPending)].Value)</strong>
                            <small>@Localizer[nameof(Language.Auto_MissionArea_783638f1)]</small>
                        </div>
                    </div>
                    <div class="utf-mission-meta__item">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Cube())"/>
                        <div>
                            <span>@Localizer[nameof(Language.Modpack)]</span>
                            <strong>@(_event.ModPackDefinitionTitle ?? Localizer[nameof(Language.Pages_Events_Detail_Status_ModPackPending)].Value)</strong>
                            <small>@GetModPackRevisionLabel(_event)</small>
                        </div>
                    </div>
                    <div class="utf-mission-meta__item">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Person())"/>
                        <div>
                            <span>@Localizer[nameof(Language.Host)]</span>
                            <strong>@(_event.HostedBy?.Nickname ?? Localizer[nameof(Language.Pages_Events_Detail_Status_HostPending)].Value)</strong>
                            <small>@Localizer[nameof(Language.Auto_OperationLead_56551686)]</small>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div class="utf-event-detail__grid">
            <main class="utf-event-detail__main">
                <section class="utf-briefing-panel">
                    <header class="utf-panel-title">
                        <span class="utf-panel-title__icon">
                            <span class="utf-md-icon utf-md-icon--document" aria-hidden="true"></span>
                        </span>
                        <h2>@Localizer[nameof(Language.Auto_OperationBrief_b34e36ec)]</h2>
                    </header>

                    @{
                        var briefingObjectives = GetBriefingObjectives();
                    }
                    @if (briefingObjectives.Count > 0)
                    {
                        <ul class="utf-briefing-objectives">
                            @foreach (var objective in briefingObjectives)
                            {
                                <li @key="objective.Text">
                                    <span class="@GetBriefingIconClass(objective.Icon)" aria-hidden="true"></span>
                                    <span>@objective.Text</span>
                                </li>
                            }
                        </ul>
                    }

                    @if (_event.Description.IsNotNullOrWhiteSpace())
                    {
                        <div class="utf-briefing-notes">
                            <div class="utf-section-heading">
                                <span class="utf-kicker">@Localizer[nameof(Language.Auto_FullBriefing_8df6347a)]</span>
                                <h3>@Localizer[nameof(Language.Auto_CommanderSNotes_99b2f4e5)]</h3>
                            </div>
                            <FluentMarkdown Content="@_event.Description"/>
                        </div>
                    }
                    else
                    {
                        <p class="utf-muted">@Localizer[nameof(Language.Auto_NoFullBriefingHasBeenPostedForThisOperation_574adb11)]</p>
                    }
                </section>

                <section class="utf-roster-panel">
                    <header class="utf-roster-panel__header">
                        <div class="utf-panel-title">
                            <span class="utf-panel-title__icon">
                                <span class="utf-md-icon utf-md-icon--slot" aria-hidden="true"></span>
                            </span>
                            <h2>@Localizer[nameof(Language.Auto_SlotRegister_20eeba00)]</h2>
                        </div>
                        <span>@OpenSlotCount open / @TotalSlotCount total</span>
                    </header>

                    @if (SlotRegisterGroups.Count is 0)
                    {
                        <div class="utf-state-panel">@Localizer[nameof(Language.Auto_NoSlotsConfigured_d0093e9c)]</div>
                    }
                    else
                    {
                        <div class="utf-slot-register" role="table" aria-label="@(Localizer[nameof(Language.Auto_SlotRegister_20eeba00)])">
                            <div class="utf-slot-register__head" aria-hidden="true">
                                <span>@Localizer[nameof(Language.Role)]</span>
                                <span>@Localizer[nameof(Language.Assigned)]</span>
                                <span>@Localizer[nameof(Language.Status)]</span>
                                <span></span>
                            </div>
                            @foreach (var slotGroup in SlotRegisterGroups)
                            {
                                <section class="utf-roster-group" @key="slotGroup.Name">
                                    <header class="utf-roster-group__header">
                                        <div>
                                            <span class="utf-roster-group__icon" aria-hidden="true"></span>
                                            <h3>@slotGroup.Name</h3>
                                        </div>
                                        <span>@GetSlotGroupAssignmentLabel(slotGroup)</span>
                                    </header>

                                    @foreach (var row in slotGroup.Rows)
                                    {
                                        var assignedUsers = GetAssignedUsers(row);
                                        var assignedSlots = GetAssignedSlots(row);
                                        var firstAssignableSlot = GetFirstAssignableSlot(row);

                                        <article class="@GetSlotRowClass(row)" @key="GetSlotRowKey(row)">
                                            <div class="utf-slot-role-cell">
                                                <span class="@GetSlotRoleIconClass(row)" aria-hidden="true"></span>
                                                <div>
                                                    <span class="@GetSideClass(row)">@row.SideLabel</span>
                                                    <h4>@GetSlotRegisterTitle(row)</h4>
                                                    <small>@FormatSlotNumbers(row)</small>
                                                </div>
                                            </div>

                                            <div class="utf-slot-assignee">
                                                @if (assignedUsers.Count > 0)
                                                {
                                                    <div class="utf-slot-user-stack">
                                                        <div class="utf-slot-avatars" aria-hidden="true">
                                                            @foreach (var assignedUser in assignedUsers.Take(3))
                                                            {
                                                                @if (assignedUser.ToImageSource() is { } avatar)
                                                                {
                                                                    <img src="@avatar" alt=""/>
                                                                }
                                                                else
                                                                {
                                                                    <span class="utf-slot-user__fallback"></span>
                                                                }
                                                            }
                                                        </div>
                                                        <div>
                                                            <strong>@FormatAssignedUsers(assignedUsers)</strong>
                                                            <small>@GetAssignedSubtitle(row, assignedUsers.Count)</small>
                                                        </div>
                                                    </div>
                                                }
                                                else if (assignedSlots.Count > 0)
                                                {
                                                    <div class="utf-slot-user-stack">
                                                        <div class="utf-slot-avatars" aria-hidden="true">
                                                            <span class="utf-slot-user__fallback"></span>
                                                        </div>
                                                        <div>
                                                            <strong>@GetProtectedAssignedLabel(assignedSlots.Count)</strong>
                                                            <small>@GetAssignedSubtitle(row, assignedSlots.Count)</small>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="utf-slot-open">@Localizer[nameof(Language.Auto_OpenSlot_00336ce6)]</span>
                                                }
                                            </div>

                                            <div class="utf-slot-status">
                                                <span class="@GetSlotStatusClass(row)">
                                                    <span class="utf-status__dot"></span>
                                                    @GetSlotStatusText(row)
                                                </span>
                                            </div>

                                            <div class="utf-slot-row-actions">
                                                <button class="@GetSlotActionClass(row)"
                                                        type="button"
                                                        disabled="@(firstAssignableSlot is null)"
                                                        @onclick="@(() => AssignSlotRegisterRowAsync(row))">
                                                    <FluentIcon Value="@(new Icons.Regular.Size20.PersonAvailable())"/>
                                                    <span>@GetSlotActionText(row)</span>
                                                </button>
                                                <button class="utf-slot-menu-button"
                                                        type="button"
                                                        title="@(Localizer[nameof(Language.Auto_ManageEvent_0a863949)])"
                                                        disabled="@(!CanManageEvent)"
                                                        @onclick="NavigateToEventManagement">
                                                    <span class="utf-slot-menu-dots" aria-hidden="true"></span>
                                                    <span class="utf-sr-only">@Localizer[nameof(Language.Auto_ManageEvent_0a863949)]</span>
                                                </button>
                                            </div>
                                        </article>
                                    }
                                </section>
                            }
                        </div>
                    }
                </section>
            </main>

            <aside class="utf-attendance-panel" aria-label="@(Localizer[nameof(Language.Attendance)])">
                @if (CanManageEvent)
                {
                    <section class="utf-side-card utf-event-control-card">
                        <header class="utf-side-card__header">
                            <FluentIcon Value="@(new Icons.Regular.Size20.Edit())"/>
                            <h2>@Localizer[nameof(Language.Auto_EventControls_ad2e84e1)]</h2>
                        </header>
                        <p class="utf-muted">@Localizer[nameof(Language.Auto_OpenThisOperationInCommandManagement_604a555e)]</p>
                        <button class="utf-command-nav-button"
                                type="button"
                                @onclick="NavigateToEventManagement">
                            <FluentIcon Value="@(new Icons.Regular.Size20.Edit())"/>
                            <span>@Localizer[nameof(Language.Auto_ManageEvent_0a863949)]</span>
                        </button>
                    </section>
                }

                <section class="utf-side-card">
                    <header class="utf-side-card__header">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Person())"/>
                        <h2>@Localizer[nameof(Language.Auto_YourAttendance_71dff290)]</h2>
                    </header>

                    <div class="utf-attendance-actions">
                        <button class="@GetAttendanceChoiceClass(Common.Event.EEventAcceptance.Accepted)"
                                type="button"
                                disabled="@(!CanSetAttendance)"
                                @onclick="@(() => SetAttendanceAsync(Common.Event.EEventAcceptance.Accepted))">
                            <span class="utf-attendance-choice__mark"></span>
                            <strong>@GetAttendanceChoiceLabel(Common.Event.EEventAcceptance.Accepted)</strong>
                            <span>@(_event.AcceptedCount ?? 0)</span>
                        </button>
                        <button class="@GetAttendanceChoiceClass(Common.Event.EEventAcceptance.Maybe)"
                                type="button"
                                disabled="@(!CanSetAttendance)"
                                @onclick="@(() => SetAttendanceAsync(Common.Event.EEventAcceptance.Maybe))">
                            <span class="utf-attendance-choice__mark"></span>
                            <strong>@GetAttendanceChoiceLabel(Common.Event.EEventAcceptance.Maybe)</strong>
                            <span>@(_event.MaybeCount ?? 0)</span>
                        </button>
                        <button class="@GetAttendanceChoiceClass(Common.Event.EEventAcceptance.Rejected)"
                                type="button"
                                disabled="@(!CanSetAttendance)"
                                @onclick="@(() => SetAttendanceAsync(Common.Event.EEventAcceptance.Rejected))">
                            <span class="utf-attendance-choice__mark"></span>
                            <strong>@GetAttendanceChoiceLabel(Common.Event.EEventAcceptance.Rejected)</strong>
                            <span>@(_event.RejectedCount ?? 0)</span>
                        </button>
                    </div>

                    <button class="utf-assign-slot-button"
                            type="button"
                            disabled="@(!CanAssignAnySlot)"
                            @onclick="AssignFirstAvailableSlotAsync">
                        <FluentIcon Value="@(new Icons.Regular.Size20.PersonAvailable())"/>
                        <span>@GetPrimarySlotActionLabel()</span>
                    </button>

                    @if (!Me.IsAuthenticated)
                    {
                        <p class="utf-muted">@Localizer[nameof(Language.Auto_SignInToManageAttendanceAndClaimOpenSlots_9bd2cdf2)]</p>
                    }
                    else if (IsEventClosed)
                    {
                        <p class="utf-muted">@Localizer[nameof(Language.Auto_ThisOperationHasAlreadyStarted_d6da2397)]</p>
                    }

                    @if (_actionError is not null)
                    {
                        <div class="utf-state-panel utf-state-panel--warning">@_actionError</div>
                    }
                </section>

                <section class="utf-side-card">
                    <div class="utf-attendance-progress">
                        <div>
                            <span>@FormatSlotSummary(_event)</span>
                            <small>@GetViabilityText(_event)</small>
                        </div>
                        <div class="utf-slot-meter" aria-label="@FormatSlotSummary(_event)">
                            <span style="@GetSlotMeterStyle(_event)"></span>
                        </div>
                    </div>

                    <div class="utf-roster-stats">
                        <div>
                            <span class="utf-md-icon utf-md-icon--slot" aria-hidden="true"></span>
                            <span>@Localizer[nameof(Language.Auto_OpenSlots_183c44b6)]</span>
                            <strong>@OpenSlotCount</strong>
                        </div>
                        <div>
                            <span class="utf-md-icon utf-md-icon--support" aria-hidden="true"></span>
                            <span>@Localizer[nameof(Language.Auto_TotalSlots_7dea1c50)]</span>
                            <strong>@TotalSlotCount</strong>
                        </div>
                        <div>
                            <span class="utf-md-icon utf-md-icon--host" aria-hidden="true"></span>
                            <span>@Localizer[nameof(Language.Auto_YourSlots_ee1b12de)]</span>
                            <strong>@CurrentUserSlotCount</strong>
                        </div>
                        <div>
                            <span class="utf-md-icon utf-md-icon--time" aria-hidden="true"></span>
                            <span>@Localizer[nameof(Language.Auto_TimeRemaining_864927fe)]</span>
                            <strong>@FormatTimeRemaining(_event.ScheduledFor)</strong>
                        </div>
                    </div>
                </section>

                <section class="utf-side-card">
                    <header class="utf-side-card__header">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Cube())"/>
                        <h2>@Localizer[nameof(Language.Auto_MissionPackage_3ff65611)]</h2>
                    </header>
                    <dl class="utf-package-list">
                        <div>
                            <dt>@Localizer[nameof(Language.Modpack)]</dt>
                            <dd>@(_event.ModPackDefinitionTitle ?? Localizer[nameof(Language.Pages_Events_Detail_Status_Pending)].Value)</dd>
                        </div>
                        <div>
                            <dt>@Localizer[nameof(Language.Terrain)]</dt>
                            <dd>@(_event.TerrainTitle ?? Localizer[nameof(Language.Pages_Events_Detail_Status_Pending)].Value)</dd>
                        </div>
                        <div>
                            <dt>@Localizer[nameof(Language.Host)]</dt>
                            <dd>@(_event.HostedBy?.Nickname ?? Localizer[nameof(Language.Pages_Events_Detail_Status_Pending)].Value)</dd>
                        </div>
                    </dl>
                    <FluentButton IconStart="@(new Icons.Regular.Size24.ArrowDownload())"
                                  Disabled="@(!CanDownloadModPack)"
                                  OnClick="DownloadModPack">
                        @Localizer[nameof(Language.Common_DownloadModpack)]
                    </FluentButton>
                </section>
            </aside>
        </div>
    }
</div>

@code {
    private const string DefaultMissionBannerImagePath = "media/generated/mission-overwatch-banner.jpg";
    private const int MissionMetaSkeletonItemCount       = 5;
    private const int BriefingObjectiveSkeletonItemCount = 3;
    private const int SlotGroupSkeletonCount             = 2;
    private const int SlotRowSkeletonCount               = 3;
    private const int SideCardSkeletonCount              = 3;

    private          FullEventDto?                    _event;
    private          ImmutableArray<SlotGroup>        _slotGroups    = [];
    private readonly Dictionary<Guid, UserDto>        _assignedUsers = new();
    private          int?                             _assigningSlotNumber;
    private          bool                             _isLoading = true;
    private          bool                             _attendanceUpdating;
    private          Common.Event.EEventAcceptance? _pendingAcceptance;
    private          string?                          _loadError;
    private          string?                          _actionError;
    private          IReadOnlyDictionary<string, SiteImageSettingInfo> _siteImages =
        new Dictionary<string, SiteImageSettingInfo>(StringComparer.OrdinalIgnoreCase);
    private static readonly Regex BriefingIconPrefixRegex =
        new(@"^:(?<icon>[a-z0-9-]+):\s*", RegexOptions.Compiled | RegexOptions.CultureInvariant);
    private static readonly Regex MarkdownIconShortcodeRegex =
        new(@":(?<icon>[a-z0-9-]+):", RegexOptions.Compiled | RegexOptions.CultureInvariant);
    private static readonly Regex MarkdownListPrefixRegex =
        new(@"^\s*(?:[-*+]\s+|\d+[.)]\s+)", RegexOptions.Compiled | RegexOptions.CultureInvariant);
    private static readonly Regex MarkdownImageRegex =
        new(@"!\[(?<text>[^\]]*)\]\([^\)]*\)", RegexOptions.Compiled | RegexOptions.CultureInvariant);
    private static readonly Regex MarkdownLinkRegex =
        new(@"\[(?<text>[^\]]+)\]\([^\)]*\)", RegexOptions.Compiled | RegexOptions.CultureInvariant);
    private static readonly Regex MarkdownInlineCodeRegex =
        new(@"`(?<text>[^`]+)`", RegexOptions.Compiled | RegexOptions.CultureInvariant);
    private static readonly Regex MarkdownFormattingRegex =
        new(@"[*_~>#]", RegexOptions.Compiled | RegexOptions.CultureInvariant);
    private static readonly Regex MarkdownWhitespaceRegex =
        new(@"\s+", RegexOptions.Compiled | RegexOptions.CultureInvariant);
    private static readonly Regex SentenceSplitRegex =
        new(@"(?<=[.!?])\s+", RegexOptions.Compiled | RegexOptions.CultureInvariant);
    private static readonly HashSet<string> SupportedBriefingIcons = new(StringComparer.OrdinalIgnoreCase)
    {
        "document",
        "extract",
        "host",
        "intel",
        "map",
        "medical",
        "modpack",
        "objective",
        "rally",
        "radio",
        "slot",
        "stealth",
        "support",
        "time",
        "warning",
    };
    private static readonly string[] ObjectiveFallbackIcons =
    [
        "objective",
        "warning",
        "radio",
    ];

    private bool IsEventClosed => _event?.ScheduledFor is { } scheduledFor && scheduledFor < DateTimeOffset.Now;
    private bool CanDownloadModPack => _event?.ModPackDefinitionPrimaryKey is not null;
    private IEnumerable<PlainEventSlotDto> AllSlots => _slotGroups.SelectMany((slotGroup) => slotGroup);
    private int TotalSlotCount => AllSlots.Count();
    private int OpenSlotCount
        => AllSlots.Count((slot) => slot.AssignedToFk is null && (slot.IsVisible ?? true));
    private int CurrentUserSlotCount
        => Me.IsAuthenticated ? AllSlots.Count((slot) => slot.AssignedToFk == Me.User.PrimaryKey) : 0;
    private PlainEventSlotDto? FirstAssignableSlot => AllSlots.FirstOrDefault(CanSelfAssign);
    private bool CanAssignAnySlot => FirstAssignableSlot is not null;
    private bool CanManageEvent => Me.HasClaimOrEventAdmin();
    private IReadOnlyList<SlotRegisterGroup> SlotRegisterGroups => CreateSlotRegisterGroups();

    private bool CanSetAttendance
        => Me.IsAuthenticated
           && !IsEventClosed
           && _event?.PrimaryKey is not null
           && !_attendanceUpdating;

    [Parameter]
    public Guid EventId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(ReloadAsync(), LoadSiteImagesAsync()).ConfigureAwait(false);
    }

    private async Task LoadSiteImagesAsync()
    {
        try
        {
            _siteImages = (await SiteImageSettingsRepository.GetSettingsAsync().ConfigureAwait(false))
                .ToDictionary(q => q.Key, StringComparer.OrdinalIgnoreCase);
        }
        catch
        {
            _siteImages = new Dictionary<string, SiteImageSettingInfo>(StringComparer.OrdinalIgnoreCase);
        }
    }

    private async Task ReloadAsync(CancellationToken cancellationToken = default)
    {
        _isLoading = true;
        _loadError = null;
        _actionError = null;
        _event = null;

        try
        {
            var eventId = EventId;
            var tmp = await EventRepository.GetEventAsync(eventId, cancellationToken)
                .ConfigureAwait(false);
            if (tmp is null)
            {
                _loadError = "The requested operation could not be found.";
                return;
            }

            var slots = await SlotRepository.AllSlotsAsync(eventId, cancellationToken)
                .ConfigureAwait(false);
            await LoadAssignedUsersAsync(slots, cancellationToken)
                .ConfigureAwait(false);
            _slotGroups =
            [
                ..slots.GroupBy((q) => q.Group)
                    .Select((q) => new SlotGroup(q.Key ?? string.Empty, q))
                    .OrderBy((q) => q.Name),
            ];
            _event = tmp;
        }
        catch
        {
            _slotGroups = [];
            _loadError = "Operation details could not be loaded. Check the API connection and try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadAssignedUsersAsync(
        IEnumerable<PlainEventSlotDto> slots,
        CancellationToken cancellationToken
    )
    {
        if (!Me.IsAuthenticated)
            return;

        var assignedUserIds = slots
            .Select((slot) => slot.AssignedToFk)
            .Where((assignedToFk) => assignedToFk is not null)
            .Select((assignedToFk) => assignedToFk!.Value)
            .Distinct()
            .Where((assignedToFk) => !_assignedUsers.ContainsKey(assignedToFk));

        foreach (var assignedUserId in assignedUserIds)
        {
            try
            {
                var user = await UserRepository.GetUserAsync(assignedUserId, cancellationToken)
                    .ConfigureAwait(false);
                if (user is not null)
                    _assignedUsers[assignedUserId] = user;
            }
            catch
            {
                // Public event details should still render when assignee profile details are protected.
            }
        }
    }

    private void DownloadModPack()
    {
        if (_event?.ModPackDefinitionPrimaryKey is not { } modPackDefinitionPrimaryKey)
            return;

        var path = _event.ModPackRevisionPrimaryKey is { } modPackRevisionPrimaryKey
            ? $"mod-packs/{modPackDefinitionPrimaryKey}/download/{modPackRevisionPrimaryKey}"
            : $"mod-packs/{modPackDefinitionPrimaryKey}/download/latest";
        NavigationManager.NavigateTo(BaseUrl.ResolveApiUrl(path), forceLoad: true);
    }

    private async Task SetAttendanceAsync(Common.Event.EEventAcceptance acceptance)
    {
        if (!CanSetAttendance || _event?.PrimaryKey is not { } eventId)
            return;

        _attendanceUpdating = true;
        _pendingAcceptance = acceptance;
        _actionError = null;
        try
        {
            await EventRepository.SetMeAcceptanceAsync(eventId, acceptance)
                .ConfigureAwait(false);
            await ReloadAsync()
                .ConfigureAwait(false);
        }
        catch
        {
            _actionError = "Attendance could not be updated. Check the API connection and try again.";
        }
        finally
        {
            _attendanceUpdating = false;
            _pendingAcceptance = null;
        }
    }

    private async Task AssignToSelfAsync(PlainEventSlotDto slot)
    {
        if (!CanSelfAssign(slot) || slot.SlotNumber is not { } slotNumber)
            return;

        _assigningSlotNumber = slotNumber;
        _actionError = null;
        try
        {
            await SlotRepository.SelfAssignSlotAsync(EventId, slotNumber)
                .ConfigureAwait(false);
            await ReloadAsync()
                .ConfigureAwait(false);
        }
        catch
        {
            _actionError = "The slot could not be assigned. Check the API connection and try again.";
        }
        finally
        {
            _assigningSlotNumber = null;
        }
    }

    private async Task AssignFirstAvailableSlotAsync()
    {
        if (FirstAssignableSlot is not { } slot)
            return;

        await AssignToSelfAsync(slot)
            .ConfigureAwait(false);
    }

    private async Task AssignSlotRegisterRowAsync(SlotRegisterRow row)
    {
        if (GetFirstAssignableSlot(row) is not { } slot)
            return;

        await AssignToSelfAsync(slot)
            .ConfigureAwait(false);
    }

