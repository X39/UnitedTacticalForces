    private string GetAttendanceChoiceClass(Common.Event.EEventAcceptance acceptance)
    {
        var classes = acceptance switch
        {
            Common.Event.EEventAcceptance.Accepted => "utf-attendance-choice utf-attendance-choice--confirmed",
            Common.Event.EEventAcceptance.Maybe    => "utf-attendance-choice utf-attendance-choice--pending",
            Common.Event.EEventAcceptance.Rejected => "utf-attendance-choice utf-attendance-choice--unavailable",
            _                                        => "utf-attendance-choice",
        };

        return _attendanceUpdating && _pendingAcceptance == acceptance ? $"{classes} updating" : classes;
    }

    private string GetAttendanceChoiceLabel(Common.Event.EEventAcceptance acceptance)
        => acceptance switch
        {
            Common.Event.EEventAcceptance.Accepted => Localizer[nameof(Language.Pages_Events_Detail_Status_Confirmed)].Value,
            Common.Event.EEventAcceptance.Maybe    => Localizer[nameof(Language.Pages_Events_Detail_Status_Pending)].Value,
            Common.Event.EEventAcceptance.Rejected => Localizer[nameof(Language.Pages_Events_Detail_Status_Unavailable)].Value,
            _                                        => Localizer[nameof(Language.Pages_Events_Detail_Status_Unknown)].Value,
        };

    private static string GetSideClass(SlotRegisterRow row)
        => $"utf-side-pill utf-side-pill--{row.SideKey}";

    private static string GetSideClass(PlainEventSlotDto slot)
        => $"utf-side-pill utf-side-pill--{GetSideKey(slot)}";

    private static string GetSideKey(PlainEventSlotDto slot)
        => slot.Side switch
        {
            EArmaSide.East       => "east",
            EArmaSide.West       => "west",
            EArmaSide.Resistance => "resistance",
            EArmaSide.Civilian   => "civilian",
            EArmaSide.AmbientLife => "ambient",
            EArmaSide.Logic      => "logic",
            _ => "empty",
        };

    private string GetSideLabel(PlainEventSlotDto slot)
        => slot.Side switch
        {
            EArmaSide.East       => Localizer[nameof(Language.East)].Value,
            EArmaSide.West       => Localizer[nameof(Language.West)].Value,
            EArmaSide.Resistance => Localizer[nameof(Language.Resistance)].Value,
            EArmaSide.Civilian   => Localizer[nameof(Language.Civilian)].Value,
            EArmaSide.AmbientLife => Localizer[nameof(Language.Ambient)].Value,
            EArmaSide.Logic      => Localizer[nameof(Language.Logic)].Value,
            _ => Localizer[nameof(Language.Pages_Events_Detail_Status_SidePending)].Value,
        };

    private sealed record SlotRegisterKey(
        string Group,
        string Title,
        string SideKey,
        string SideLabel
    );

    private sealed record SlotRegisterGroup(
        string Name,
        IReadOnlyList<SlotRegisterRow> Rows
    )
    {
        public int TotalCount => Rows.Sum((row) => row.Capacity);

        public int AssignedCount => Rows.Sum((row) => row.AssignedCount);
    }

    private sealed record SlotRegisterRow(
        string Group,
        string Title,
        string SideKey,
        string SideLabel,
        IReadOnlyList<PlainEventSlotDto> Slots
    )
    {
        public int Capacity => Slots.Count;

        public int AssignedCount => Slots.Count((slot) => slot.AssignedToFk is not null);

        public int OpenCount => Slots.Count((slot) => slot.AssignedToFk is null && (slot.IsVisible ?? true));

        public bool IsHidden => Slots.All((slot) => !(slot.IsVisible ?? true));

        public bool IsLocked => Slots.All((slot) => !(slot.IsSelfAssignable ?? true) || !(slot.IsVisible ?? true));

        public int FirstSlotNumber
            => Slots.Select((slot) => slot.SlotNumber ?? int.MaxValue).DefaultIfEmpty(int.MaxValue).Min();

        public int SideSort
            => SideKey switch
            {
                "west"       => 0,
                "east"       => 1,
                "resistance" => 2,
                "civilian"   => 3,
                "ambient"    => 4,
                "logic"      => 5,
                _            => 6,
            };
    }

    private sealed record BriefingObjective(string Icon, string Text);
}
