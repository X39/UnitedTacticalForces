        if (GetOpenSlotCount(row) is 0)
            return Localizer[nameof(Language.Pages_Events_Detail_Status_Assigned)].Value;
        return row.Capacity > 1 ? Localizer[nameof(Language.Pages_Events_Detail_ActionClaimRole)].Value : Localizer[nameof(Language.Pages_EventView_AssignToSelf)];
