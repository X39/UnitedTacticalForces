        => Me.IsAuthenticated
           && !IsEventClosed
           && _assigningSlotNumber is null
           && slot.SlotNumber is not null
           && slot.AssignedToFk is null
           && (slot.IsSelfAssignable ?? true)
           && (slot.IsVisible ?? true);

