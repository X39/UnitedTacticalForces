    private string GetSlotRowClass(SlotRegisterRow row)
    {
        var classes = "utf-slot-row";
        if (row.AssignedCount > 0)
            classes += " assigned";
        else
            classes += " open";
        if (IsAssignedToCurrentUser(row))
            classes += " mine";
        if (row.IsHidden)
            classes += " hidden";

        return classes;
    }

    private string GetSlotStatusClass(SlotRegisterRow row)
    {
        var classes = "utf-status ";
        if (row.IsHidden)
            return classes + "utf-status--neutral";
        if (IsAssignedToCurrentUser(row))
            return classes + "utf-status--info";
        if (row.OpenCount is 0 && row.AssignedCount > 0)
            return classes + "utf-status--success";
        if (row.IsLocked)
            return classes + "utf-status--warning";
        if (row.AssignedCount > 0)
            return classes + "utf-status--brand";
        return classes + "utf-status--brand";
    }

    private string GetSlotStatusText(SlotRegisterRow row)
    {
        if (row.IsHidden)
            return Localizer[nameof(Language.Pages_Events_Detail_Status_Hidden)].Value;
        if (IsAssignedToCurrentUser(row))
            return Localizer[nameof(Language.Pages_Events_Detail_Status_YourSlot)].Value;
        if (row.OpenCount is 0 && row.AssignedCount > 0)
            return Localizer[nameof(Language.Pages_Events_Detail_Status_Confirmed)].Value;
        if (row.AssignedCount > 0)
            return Localizer[nameof(Language.Pages_Events_Detail_Status_PartiallyFilled)].Value;
        if (row.IsLocked)
            return Localizer[nameof(Language.Pages_Events_Detail_Status_Locked)].Value;
        return Localizer[nameof(Language.Pages_Events_Detail_Status_Available)].Value;
    }

