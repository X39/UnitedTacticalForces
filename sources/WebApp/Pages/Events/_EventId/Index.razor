        var slotNumbers = row.Slots
            .Select((slot) => slot.SlotNumber)
            .Where((slotNumber) => slotNumber is not null)
            .Select((slotNumber) => slotNumber!.Value)
            .Order()
            .ToArray();

        if (slotNumbers.Length is 0)
            return Localizer[nameof(Language.Pages_Events_Detail_Status_SlotsPending)].Value;

        if (slotNumbers.Length is 1)
            return Localizer[nameof(Language.Pages_Events_Detail_Count_SlotNumber), slotNumbers[0]].Value;

        var formattedSlotNumbers = string.Join(", ", slotNumbers.Select((slotNumber) => slotNumber.ToString(CultureInfo.CurrentCulture)));
        return Localizer[nameof(Language.Pages_Events_Detail_Count_SlotNumbers), formattedSlotNumbers].Value;
    }

