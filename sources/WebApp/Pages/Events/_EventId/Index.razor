    private IReadOnlyList<SlotRegisterGroup> CreateSlotRegisterGroups()
        =>
        [
            ..AllSlots
                .GroupBy((slot) => NormalizeSlotGroup(slot.Group))
                .Select((slotGroup) => new SlotRegisterGroup(
                    slotGroup.Key,
                    [
                        ..slotGroup
                            .GroupBy(CreateSlotRegisterKey)
                            .Select(CreateSlotRegisterRow)
                            .OrderBy((row) => row.SideSort)
                            .ThenBy((row) => row.FirstSlotNumber)
                            .ThenBy((row) => row.Title, StringComparer.CurrentCultureIgnoreCase),
                    ]
                ))
                .OrderBy((slotGroup) => slotGroup.Name, StringComparer.CurrentCultureIgnoreCase),
        ];

    private SlotRegisterKey CreateSlotRegisterKey(PlainEventSlotDto slot)
        => new(
            NormalizeSlotGroup(slot.Group),
            NormalizeSlotTitle(slot.Title),
            GetSideKey(slot),
            GetSideLabel(slot)
        );

    private static SlotRegisterRow CreateSlotRegisterRow(IGrouping<SlotRegisterKey, PlainEventSlotDto> slots)
        => new(
            slots.Key.Group,
            slots.Key.Title,
            slots.Key.SideKey,
            slots.Key.SideLabel,
            [..slots.OrderBy((slot) => slot.SlotNumber ?? int.MaxValue).ThenBy((slot) => slot.Title)]
        );

