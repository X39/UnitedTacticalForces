    private IReadOnlyList<BriefingObjective> GetBriefingObjectives()
        => ExtractBriefingObjectives(_event?.Description);

    private static IReadOnlyList<BriefingObjective> ExtractBriefingObjectives(string? description)
    {
        if (string.IsNullOrWhiteSpace(description))
            return [];

        var objectives = new List<BriefingObjective>();
        var fallbackIconIndex = 0;
        var normalizedDescription = description.Replace("\r\n", "\n", StringComparison.Ordinal);
        foreach (var rawLine in normalizedDescription.Split('\n'))
        {
            var line = rawLine.Trim();
            if (line.Length is 0
                || line.StartsWith("#", StringComparison.Ordinal)
                || line.StartsWith("```", StringComparison.Ordinal)
                || line.StartsWith("|", StringComparison.Ordinal))
            {
                continue;
            }

            line = MarkdownListPrefixRegex.Replace(line, string.Empty);
            var explicitIcon = TryTakeBriefingIcon(ref line);
            if (explicitIcon is null && IsBriefingHeadingLine(line))
                continue;

            var icon = explicitIcon ?? ObjectiveFallbackIcons[fallbackIconIndex++ % ObjectiveFallbackIcons.Length];
            var text = TruncateBriefingObjective(NormalizeBriefingText(line));
            if (text.Length is 0)
                continue;

            objectives.Add(new BriefingObjective(icon, text));
            if (objectives.Count is 3)
                return objectives;
        }

        if (objectives.Count > 0)
            return objectives;

        var plainText = NormalizeBriefingText(description);
        foreach (var sentence in SentenceSplitRegex.Split(plainText))
        {
            var text = TruncateBriefingObjective(sentence.Trim());
            if (text.Length is 0)
                continue;

            objectives.Add(new BriefingObjective(
                ObjectiveFallbackIcons[fallbackIconIndex++ % ObjectiveFallbackIcons.Length],
                text
            ));
            if (objectives.Count is 3)
                break;
        }

        return objectives;
    }

    private static string? TryTakeBriefingIcon(ref string line)
    {
        var match = BriefingIconPrefixRegex.Match(line);
        if (!match.Success)
            return null;

        var icon = match.Groups["icon"].Value;
        if (!SupportedBriefingIcons.Contains(icon))
            return null;

        line = line[match.Length..].TrimStart();
        return icon.ToLowerInvariant();
    }

    private static bool IsBriefingHeadingLine(string line)
    {
        var text = NormalizeBriefingText(line);
        if (text.Length is 0 || text.Length > 42)
            return false;

        if (text.Contains(':', StringComparison.Ordinal)
            || text.Contains('.', StringComparison.Ordinal)
            || text.Contains(',', StringComparison.Ordinal))
        {
            return false;
        }

        return text.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length <= 4;
    }

    private static string NormalizeBriefingText(string value)
    {
        var text = MarkdownImageRegex.Replace(value, "${text}");
        text = MarkdownLinkRegex.Replace(text, "${text}");
        text = MarkdownInlineCodeRegex.Replace(text, "${text}");
        text = MarkdownIconShortcodeRegex.Replace(text, string.Empty);
        text = MarkdownFormattingRegex.Replace(text, string.Empty);
        return MarkdownWhitespaceRegex.Replace(text, " ").Trim();
    }

    private static string TruncateBriefingObjective(string value)
        =>value.Length<= 150 ? value : $"{value[..147].TrimEnd()}...";

    private static string GetBriefingIconClass(string icon)
        => SupportedBriefingIcons.Contains(icon)
            ? $"utf-md-icon utf-md-icon--{icon.ToLowerInvariant()}"
            : "utf-md-icon utf-md-icon--objective";

