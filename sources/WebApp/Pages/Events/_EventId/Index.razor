            : "utf-slot-assign-button";

    private string GetSlotActionText(SlotRegisterRow row)
    {
        if (row.Slots.Any((slot) => _assigningSlotNumber == slot.SlotNumber))
            return Localizer[nameof(Language.Pages_Events_Detail_ActionAssigning)].Value;
        if (IsAssignedToCurrentUser(row))
            return Localizer[nameof(Language.Pages_Events_Detail_Status_YourSlot)].Value;
        if (row.IsHidden)
            return Localizer[nameof(Language.Pages_Events_Detail_Status_Hidden)].Value;
        if (row.IsLocked)
            return Localizer[nameof(Language.Pages_Events_Detail_Status_Locked)].Value;
