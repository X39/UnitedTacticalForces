        => scheduledFor is null
            ? Localizer[nameof(Language.Pages_Events_Detail_Status_TimePending)].Value
            : $"{scheduledFor.Value.UtcDateTime.ToString("HH:mm", CultureInfo.InvariantCulture)} UTC";

    private string FormatLocalTime(DateTimeOffset? scheduledFor)
        => scheduledFor is null
            ? Localizer[nameof(Language.Pages_Events_Detail_Status_LocalTimePending)].Value
            : Localizer[nameof(Language.Pages_Events_Detail_Format_LocalTime), scheduledFor.Value.ToLocalTime().ToString("HH:mm", CultureInfo.CurrentCulture)].Value;

    private string FormatTimeRemaining(DateTimeOffset? scheduledFor)
    {
        if (scheduledFor is null)
            return Localizer[nameof(Language.Pages_Events_Detail_Status_ToBeDetermined)].Value;

        var remaining = scheduledFor.Value - DateTimeOffset.Now;
        if (remaining <= TimeSpan.Zero)
            return Localizer[nameof(Language.Pages_Events_Detail_Status_Started)].Value;

        if (remaining.TotalDays >= 1)
            return $"{remaining.Days}d {remaining.Hours}h";

        if (remaining.TotalHours >= 1)
            return $"{remaining.Hours}h {remaining.Minutes}m";

        return $"{Math.Max(1, remaining.Minutes)}m";
    }

