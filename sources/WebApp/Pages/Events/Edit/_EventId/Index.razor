                        <dt>@Localizer[nameof(Language.Maybe)]</dt>
                        <dd>@FormatCount(_event.MaybeCount)</dd>
                        <dt>@Localizer[nameof(Language.Rejected)]</dt>
                        <dd>@FormatCount(_event.RejectedCount)</dd>
                        <dt>@Localizer[nameof(Language.Slots)]</dt>
