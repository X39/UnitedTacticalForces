@page "/command/events/{EventId:guid}"
@layout CommandCenterLayout
@using System.Globalization
@using System.Text.RegularExpressions
@using Microsoft.FluentUI.AspNetCore.Components
@using X39.UnitedTacticalForces.WebApp.UtfApi.Models
@using X39.UnitedTacticalForces.WebApp.Data
@using X39.UnitedTacticalForces.WebApp.ExtensionMethods
@using X39.UnitedTacticalForces.WebApp.Services
@using X39.UnitedTacticalForces.WebApp.Services.EventRepository
@using X39.UnitedTacticalForces.WebApp.Services.MediaAssetRepository
@using X39.UnitedTacticalForces.WebApp.Services.SlotRepository
@using X39.UnitedTacticalForces.WebApp.Services.UserRepository
@using X39.UnitedTacticalForces.WebApp.UtfApi.Models
@inject IEventRepository EventRepository
@inject ISlotRepository SlotRepository
@inject IUserRepository UserRepository
@inject NavigationManager NavigationManager
@inject UserAutoCompleteService UserAutoCompleteService
@inject ModPackAutoCompleteService ModPackAutoCompleteService
@inject TerrainAutoCompleteService TerrainAutoCompleteService
@inject BaseUrl BaseUrl
@inject MeService Me

@inject IStringLocalizer<Language> Localizer
<PageTitle>@(_event?.Title ?? Localizer[nameof(Language.Pages_Events_Edit_PageTitleFallback)].Value)</PageTitle>

<div class="event-editor-page">
    <UtfCommandPageHeader Title="@GetPageTitle()"
                          Description="@(Localizer[nameof(Language.Auto_AuthoringWorkspaceForOperationMetadataBriefingMediaReadinessAnd_560063d1)])">
        <Actions>
            <UtfCommandButton OnClick="@(() => NavigationManager.NavigateTo(BaseUrl.ResolveSelfUrl("command/events")))"
                              Class="event-editor-tooltip"
                              Title="@(Localizer[nameof(Language.Auto_ReturnToTheCommandCenterEventListWithoutSaving_f8feea2c)])">
                <Icon>
                    <FluentIcon Value="@(new Icons.Regular.Size20.ArrowLeft())"/>
                </Icon>
                <ChildContent>@Localizer[nameof(Language.Auto_BackToEvents_6f92c820)]</ChildContent>
            </UtfCommandButton>
            <UtfCommandButton OnClick="@(() => NavigationManager.NavigateTo(BaseUrl.ResolveSelfUrl($"events/{EventId}")))"
                              Class="event-editor-tooltip"
                              Title="@(Localizer[nameof(Language.Auto_OpenThePublicEventViewAndSlotRegister_b06a244f)])">
                <Icon>
                    <FluentIcon Value="@(new Icons.Regular.Size20.PeopleTeam())"/>
                </Icon>
                <ChildContent>@Localizer[nameof(Language.Auto_ViewSlots_ddcd3598)]</ChildContent>
            </UtfCommandButton>
            <UtfCommandButton Disabled="@(!CanSubmit)"
                              Variant="primary"
                              Class="event-editor-tooltip"
                              Title="@(Localizer[nameof(Language.Auto_SaveEventMetadataAssetsBriefingObjectivesAndTheCurrent_1dca84a9)])"
                              OnClick="SaveAllAsync">
                <Icon>
                    <FluentIcon Value="@(new Icons.Regular.Size20.Save())"/>
                </Icon>
                <ChildContent>@Localizer[_isSaving ? nameof(Language.Pages_Events_Edit_ActionSaving) : nameof(Language.Pages_Events_Edit_ActionSaveChanges)]</ChildContent>
            </UtfCommandButton>
        </Actions>
    </UtfCommandPageHeader>

    @if (!CanManageEvents)
    {
        <section class="utf-empty-state">
            <h2>@Localizer[nameof(Language.Auto_EventAdministratorAccessRequired_d59039c1)]</h2>
            <p>@Localizer[nameof(Language.Auto_EventAuthoringIsVisibleOnlyToAuthorizedOperationPlanners_b8740e86)]</p>
        </section>
    }
    else if (_isLoading)
    {
        <div class="utf-state-panel">
            @Localizer[nameof(Language.Auto_LoadingEventEditor_f4351c62)]
            <FluentProgress Width="240px"/>
        </div>
    }
    else if (_loadError is not null)
    {
        <div class="utf-state-panel utf-state-panel--warning" role="alert">
            @_loadError
        </div>
    }
    else if (_model is not null && _event is not null)
    {
        @if (_submitError is not null)
        {
            <div class="utf-state-panel utf-state-panel--warning" role="alert">
                @_submitError
            </div>
        }
        @if (_saveMessage is not null)
        {
            <div class="utf-state-panel event-editor-save-state">
                @_saveMessage
            </div>
        }

        <section class="utf-panel event-editor-hero">
            <div>
                <span class="@GetVisibilityStatusClass()">
                    <span class="utf-status__dot"></span>@GetVisibilityLabel()
                </span>
                <h2>@GetPageTitle()</h2>
                <p>@FormatDateTime(_model.ScheduledForLocal) / @Localizer[nameof(Language.Host)]: @(_hostedBy?.Nickname ?? Localizer[nameof(Language.Pages_Events_Edit_Status_HostPending)].Value)</p>
            </div>
            <div class="event-editor-hero__actions">
                <button class="@GetTabClass(EditorTab.Details)" type="button" @onclick="@(() => SetTab(EditorTab.Details))">@Localizer["Details"]</button>
                <button class="@GetTabClass(EditorTab.Briefing)" type="button" @onclick="@(() => SetTab(EditorTab.Briefing))">@Localizer[nameof(Language.Briefing)]</button>
                <button class="@GetTabClass(EditorTab.Objectives)" type="button" @onclick="@(() => SetTab(EditorTab.Objectives))">@Localizer[nameof(Language.Objectives)]</button>
                <button class="@GetTabClass(EditorTab.Slots)" type="button" @onclick="@(() => SetTab(EditorTab.Slots))">@Localizer[nameof(Language.Slots)]</button>
            </div>
        </section>

        <div class="event-editor-workspace">
            <main class="utf-panel event-editor-main">
                @switch (_activeTab)
                {
                    case EditorTab.Briefing:
                        <section class="event-editor-section">
                            <div class="event-editor-section__heading">
                                <div>
                                    <span class="utf-kicker">@Localizer[nameof(Language.Briefing)]</span>
                                    <h2>@Localizer[nameof(Language.Auto_CommanderSNotes_99b2f4e5)]</h2>
                                </div>
                                <span>@GetBriefingLengthLabel()</span>
                            </div>
                            <label class="utf-command-field event-editor-field event-editor-field--wide">
                                <span>@Localizer[nameof(Language.Auto_BriefingMarkdown_57d6b69f)]</span>
                                <textarea class="utf-command-input event-editor-textarea"
                                          rows="18"
                                          title="@(Localizer[nameof(Language.Pages_Events_Edit_Tooltip_BriefingMarkdown)])"
                                          @bind="_model.Description"
                                          @bind:after="RefreshObjectivesFromBriefing"></textarea>
                            </label>
                            <section class="event-editor-markdown-preview">
                                <span class="utf-kicker">@Localizer[nameof(Language.Auto_RenderedBriefing_9d4f9366)]</span>
                                <FluentMarkdown Content="@_model.Description"/>
                            </section>
                        </section>
                        break;
                    case EditorTab.Objectives:
                        <section class="event-editor-section">
                            <div class="event-editor-section__heading">
                                <div>
                                    <span class="utf-kicker">@Localizer[nameof(Language.Auto_MissionObjectives_9474605d)]</span>
                                    <h2>@Localizer[nameof(Language.Auto_PublicBriefingHighlights_dd5597fe)]</h2>
                                </div>
                                <div class="event-editor-heading-actions">
                                    <span>@GetObjectivesStatusLabel()</span>
                                    <button class="utf-button utf-button--ghost"
                                            type="button"
                                            title="@Localizer["Pages_Events_Edit_Tooltip_AddObjective"]"
                                            @onclick="AddObjective">
                                        @Localizer["Pages_Events_Edit_ActionAddObjective"]
                                    </button>
                                </div>
                            </div>
                            <div class="event-editor-objectives">
                                @for (var index = 0; index < _objectiveDrafts.Count; index++)
                                {
                                    var objective = _objectiveDrafts[index];
                                    <article class="event-editor-objective-row" @key="objective.DraftKey">
                                        <label class="utf-command-field event-editor-field event-editor-objective-row__icon">
                                            <span>@Localizer[nameof(Language.Icon)]</span>
                                            <div class="event-editor-objective-select">
                                                <FluentSelect TOption="ObjectiveIconOption"
                                                              Items="@ObjectiveIconOptions"
                                                              OptionText="@(static (icon) => icon.Label)"
                                                              OptionValue="@(static (icon) => icon.Icon)"
                                                              SelectedOption="@GetSelectedObjectiveIconOption(objective)"
                                                              SelectedOptionChanged="@((icon) => OnObjectiveIconChanged(objective, icon))"
                                                              Position="@SelectPosition.Below"
                                                              AriaLabel="@(Localizer[nameof(Language.Pages_Events_Edit_Tooltip_ObjectiveIcon)])">
                                                    <OptionTemplate Context="icon">
                                                        <div class="event-editor-objective-select-option">
                                                            <span class="@GetObjectiveIconOptionClass(icon)" aria-hidden="true"></span>
                                                            <span>@icon.Label</span>
                                                        </div>
                                                    </OptionTemplate>
                                                </FluentSelect>
                                            </div>
                                        </label>
                                        <label class="utf-command-field event-editor-field">
                                            <span>@Localizer[nameof(Language.Pages_Events_Edit_LabelObjective), index + 1]</span>
                                            <input class="utf-command-input"
                                                   maxlength="150"
                                                   placeholder="@(Localizer[nameof(Language.Pages_Events_Edit_Placeholder_Objective)])"
                                                   title="@(Localizer[nameof(Language.Pages_Events_Edit_Tooltip_ObjectiveText)])"
                                                   @bind="objective.Text"
                                                   @bind:after="ApplyObjectiveDraftsToBriefing"/>
                                        </label>
                                        <span class="@GetObjectiveIconClass(objective.Icon)" aria-hidden="true"></span>
                                        <button class="@GetObjectiveRemoveButtonClass(objective)"
                                                type="button"
                                                title="@GetObjectiveRemoveButtonTitle(objective)"
                                                @onclick="@(() => RequestOrConfirmObjectiveRemoval(objective))">
                                            <FluentIcon Value="@(new Icons.Regular.Size20.Delete())"/>
                                            <span>@GetObjectiveRemoveButtonLabel(objective)</span>
                                        </button>
                                    </article>
                                }
                            </div>
                            <section class="event-editor-objective-preview">
                                <span class="utf-kicker">@Localizer[nameof(Language.Auto_PublicPreview_f948bc45)]</span>
                                @if (_objectiveDrafts.All((objective) => !objective.HasText))
                                {
                                    <p>@Localizer[nameof(Language.Auto_NoMissionObjectivesHaveBeenAdded_d6bd1a03)]</p>
                                }
                                else
                                {
                                    <ul>
                                        @foreach (var objective in _objectiveDrafts.Where((objective) => objective.HasText))
                                        {
                                            <li @key="objective.DraftKey">
                                                <span class="@GetObjectiveIconClass(objective.Icon)" aria-hidden="true"></span>
                                                <span>@objective.Text.Trim()</span>
                                            </li>
                                        }
                                    </ul>
                                }
                            </section>
                        </section>
                        break;
                    case EditorTab.Slots:
                        <section class="event-editor-section">
                            <div class="event-editor-section__heading">
                                <div>
                                    <span class="utf-kicker">@Localizer[nameof(Language.Slots)]</span>
                                    <h2>@Localizer[nameof(Language.Auto_SlotPlan_7b3bf485)]</h2>
                                </div>
                                <button class="utf-button utf-button--ghost"
                                        type="button"
                                        title="@(Localizer[nameof(Language.Pages_Events_Edit_Tooltip_AddSlot)])"
                                        @onclick="AddSlot">
                                    @Localizer[nameof(Language.Auto_AddSlot_21ac8a98)]
                                </button>
                            </div>
                            @if (VisibleSlots.Count is 0)
                            {
                                <div class="event-editor-empty">@Localizer[nameof(Language.Auto_NoSlotsConfiguredAddAtLeastOneSlotFor_a7e2439d)]</div>
                            }
                            else
                            {
                                <div class="event-editor-slot-register" role="table" aria-label="@(Localizer[nameof(Language.Auto_EditableSlotPlan_f406ee7b)])">
                                    <div class="event-editor-slot-register__head" aria-hidden="true">
                                        <span>@Localizer[nameof(Language.Role)]</span>
                                        <span>@Localizer[nameof(Language.Assigned)]</span>
                                        <span>@Localizer[nameof(Language.Status)]</span>
                                        <span></span>
                                    </div>
                                    @foreach (var slotGroup in SlotEditorGroups)
                                    {
                                        <section class="event-editor-roster-group" @key="slotGroup.Name">
                                            <header class="event-editor-roster-group__header">
                                                <div>
                                                    <span class="utf-roster-group__icon" aria-hidden="true"></span>
                                                    <h3>@slotGroup.Name</h3>
                                                </div>
                                                <span>@GetSlotGroupAssignmentLabel(slotGroup)</span>
                                            </header>

                                            @foreach (var slot in slotGroup.Slots)
                                            {
                                                <article class="@GetSlotRowClass(slot)" @key="slot.DraftKey">
                                                    <div class="event-editor-slot-role-cell">
                                                        <span class="@GetSlotRoleIconClass(slot)" aria-hidden="true"></span>
                                                        <div class="event-editor-slot-role-fields">
                                                            <label class="utf-command-field event-editor-field">
                                                                <span>@Localizer[nameof(Language.Group)]</span>
                                                                <input class="utf-command-input"
                                                                       title="@(Localizer[nameof(Language.Pages_Events_Edit_Tooltip_SlotGroup)])"
                                                                       @bind="slot.Group"/>
                                                            </label>
                                                            <label class="utf-command-field event-editor-field">
                                                                <span>@Localizer[nameof(Language.Role)]</span>
                                                                <input class="utf-command-input"
                                                                       title="@(Localizer[nameof(Language.Pages_Events_Edit_Tooltip_SlotRole)])"
                                                                       @bind="slot.Title"/>
                                                            </label>
                                                            <label class="utf-command-field event-editor-field">
                                                                <span>@Localizer[nameof(Language.Side)]</span>
                                                                <select class="utf-command-input"
                                                                        title="@(Localizer[nameof(Language.Pages_Events_Edit_Tooltip_SlotSide)])"
                                                                        @bind="slot.Side">
                                                                    <option value="0">@Localizer[nameof(Language.Empty)]</option>
                                                                    <option value="1">@Localizer[nameof(Language.East)]</option>
                                                                    <option value="2">@Localizer[nameof(Language.West)]</option>
                                                                    <option value="3">@Localizer[nameof(Language.Resistance)]</option>
                                                                    <option value="4">@Localizer[nameof(Language.Civilian)]</option>
                                                                    <option value="5">@Localizer[nameof(Language.Ambient)]</option>
                                                                    <option value="6">@Localizer[nameof(Language.Logic)]</option>
                                                                </select>
                                                            </label>
                                                        </div>
                                                    </div>

                                                    <div class="event-editor-slot-assignee">
                                                        <div class="event-editor-slot-current-user">
                                                            @if (slot.AssignedUser?.ToImageSource() is { } avatar)
                                                            {
                                                                <img src="@avatar" alt=""/>
                                                            }
                                                            else
                                                            {
                                                                <span class="event-editor-avatar-fallback" aria-hidden="true"></span>
                                                            }
                                                            <div>
                                                                <strong>@GetSlotStateLabel(slot)</strong>
                                                                <small>@Localizer[slot.IsPersisted ? nameof(Language.Pages_Events_Edit_Status_SavedAssignment) : nameof(Language.Pages_Events_Edit_Status_StagedAssignment)]</small>
                                                            </div>
                                                        </div>
                                                        <div class="utf-command-field event-editor-field event-editor-autocomplete event-editor-slot-autocomplete">
                                                            <FluentAutocomplete Id="@GetSlotAutocompleteId(slot)"
                                                                                TOption="PlainUserDto"
                                                                                MaximumSelectedOptions="1"
                                                                                MaximumOptionsSearch="8"
                                                                                AutoComplete="off"
                                                                                Position="@SelectPosition.Below"
                                                                                OnOptionsSearch="UserAutoCompleteService.PlainUserDto.OnOptionsSearch"
                                                                                OptionText="UserAutoCompleteService.PlainUserDto.OptionText"
                                                                                Label="@(Localizer[nameof(Language.Auto_AssignMember_c88914b5)])"
                                                                                Placeholder="@(Localizer[nameof(Language.Auto_SearchMember_ef216823)])"
                                                                                @bind-ValueText="slot.AssignmentSearchText"
                                                                                @bind-SelectedOption="slot.AssignmentCandidate"
                                                                                @bind-SelectedOption:after="@(() => OnSlotAssignmentCandidateChanged(slot))">
                                                                <OptionTemplate Context="user">
                                                                    <div class="event-editor-autocomplete-option">
                                                                        @if (user.ToImageSource() is { } optionAvatar)
                                                                        {
                                                                            <img src="@optionAvatar" alt=""/>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="event-editor-avatar-fallback" aria-hidden="true"></span>
                                                                        }
                                                                        <span>@GetUserLabel(user)</span>
                                                                    </div>
                                                                </OptionTemplate>
                                                                <SelectedOptionTemplate Context="user">
                                                                    <span class="event-editor-selected-option">@GetUserLabel(user)</span>
                                                                </SelectedOptionTemplate>
                                                            </FluentAutocomplete>
                                                        </div>
                                                    </div>

                                                    <div class="event-editor-slot-status">
                                                        <span class="@GetSideClass(slot)">@GetSideLabel(slot.Side)</span>
                                                        <span class="@GetSlotStatusClass(slot)">
                                                            <span class="utf-status__dot"></span>@GetSlotStatusText(slot)
                                                        </span>
                                                        <label class="event-editor-toggle" title="@(Localizer[nameof(Language.Pages_Events_Edit_Tooltip_SlotVisibility)])">
                                                            <input type="checkbox" @bind="slot.IsVisible"/>
                                                            <span>@Localizer[nameof(Language.Visible)]</span>
                                                        </label>
                                                        <label class="event-editor-toggle" title="@(Localizer[nameof(Language.Pages_Events_Edit_Tooltip_SlotSelfAssign)])">
                                                            <input type="checkbox" @bind="slot.IsSelfAssignable"/>
                                                            <span>@Localizer[nameof(Language.Auto_SelfAssign_fae0bc3e)]</span>
                                                        </label>
                                                    </div>

                                                    <div class="event-editor-slot-actions">
                                                        <button class="utf-button utf-button--ghost"
                                                                type="button"
                                                                title="@(Localizer[nameof(Language.Pages_Events_Edit_Tooltip_ApplySlotAssignment)])"
                                                                disabled="@(!CanAssignSlot(slot))"
                                                                @onclick="@(() => AssignSlotAsync(slot))">
                                                            @Localizer["Pages_Events_Edit_ActionAssignSlot"]
                                                        </button>
                                                        <button class="utf-button utf-button--ghost"
                                                                type="button"
                                                                title="@(Localizer[nameof(Language.Pages_Events_Edit_Tooltip_ClearSlotAssignment)])"
                                                                disabled="@(slot.AssignedToFk is null)"
                                                                @onclick="@(() => UnassignSlotAsync(slot))">
                                                            @Localizer["Pages_Events_Edit_ActionUnassignSlot"]
                                                        </button>
                                                        <button class="utf-button utf-button--ghost"
                                                                type="button"
                                                                title="@(Localizer[nameof(Language.Pages_Events_Edit_Tooltip_RemoveSlot)])"
                                                                @onclick="@(() => RemoveSlot(slot))">
                                                            @Localizer["Pages_Events_Edit_ActionRemoveSlot"]
                                                        </button>
                                                    </div>
                                                </article>
                                            }
                                        </section>
                                    }
                                </div>
                            }
                            <div class="event-editor-section__footer">
                                <span>@GetSlotSummaryLabel()</span>
                                <button class="utf-button utf-button--primary"
                                        type="button"
                                        title="@(Localizer[nameof(Language.Pages_Events_Edit_Tooltip_SaveSlotPlan)])"
                                        disabled="@(_isSavingSlots || _isSaving)"
                                        @onclick="@(() => SaveSlotsAsync(showSuccess: true))">
                                    @Localizer[_isSavingSlots ? nameof(Language.Pages_Events_Edit_ActionSavingSlots) : nameof(Language.Pages_Events_Edit_ActionSaveSlotPlan)]
                                </button>
                            </div>
                        </section>
                        break;
                    default:
                        <section class="event-editor-section">
                            <div class="event-editor-section__heading">
                                <div>
                                    <span class="utf-kicker">@Localizer["Details"]</span>
                                    <h2>@Localizer[nameof(Language.Auto_BasicInformation_6c092c9c)]</h2>
                                </div>
                                <span>@GetEventReadinessLabel()</span>
                            </div>
                            <div class="event-editor-form-grid">
                                <label class="utf-command-field event-editor-field event-editor-field--wide">
                                    <span>@Localizer[nameof(Language.Title)]</span>
                                    <input class="utf-command-input"
                                           maxlength="1024"
                                           title="@(Localizer[nameof(Language.Pages_Events_Edit_Tooltip_PublicTitle)])"
                                           @bind="_model.Title"/>
                                </label>
                                <label class="utf-command-field event-editor-field">
                                    <span>@Localizer[nameof(Language.Schedule)]</span>
                                    <input class="utf-command-input"
                                           type="datetime-local"
                                           title="@(Localizer[nameof(Language.Pages_Events_Edit_Tooltip_LocalSchedule)])"
                                           @bind="_model.ScheduledForLocal"/>
                                </label>
                                <div class="utf-command-field event-editor-field event-editor-autocomplete">
                                    <FluentAutocomplete Id="event-editor-host"
                                                        Required="true"
                                                        TOption="PlainUserDto"
                                                        MaximumSelectedOptions="1"
                                                        MaximumOptionsSearch="8"
                                                        AutoComplete="off"
                                                        Position="@SelectPosition.Below"
                                                        OnOptionsSearch="UserAutoCompleteService.PlainUserDto.OnOptionsSearch"
                                                        OptionText="UserAutoCompleteService.PlainUserDto.OptionText"
                                                        Label="@(Localizer[nameof(Language.Host)])"
                                                        Placeholder="@(Localizer[nameof(Language.Auto_SearchHost_abe3f02f)])"
                                                        @bind-ValueText="_hostedByText"
                                                        @bind-SelectedOption="_hostedBy"
                                                        @bind-SelectedOption:after="OnHostChanged">
                                        <OptionTemplate Context="user">
                                            <div class="event-editor-autocomplete-option">
                                                @if (user.ToImageSource() is { } avatar)
                                                {
                                                    <img src="@avatar" alt=""/>
                                                }
                                                else
                                                {
                                                    <span class="event-editor-avatar-fallback" aria-hidden="true"></span>
                                                }
                                                <span>@GetUserLabel(user)</span>
                                            </div>
                                        </OptionTemplate>
                                        <SelectedOptionTemplate Context="user">
                                            <span class="event-editor-selected-option">@GetUserLabel(user)</span>
                                        </SelectedOptionTemplate>
                                    </FluentAutocomplete>
                                </div>
                                <label class="utf-command-field event-editor-field">
                                    <span>@Localizer[nameof(Language.Auto_MinimumAccepted_05ac548c)]</span>
                                    <input class="utf-command-input"
                                           min="0"
                                           type="number"
                                           title="@(Localizer[nameof(Language.Pages_Events_Edit_Tooltip_MinimumAccepted)])"
                                           @bind="_model.MinimumAccepted"/>
                                </label>
                                <label class="utf-command-field event-editor-field">
                                    <span>@Localizer[nameof(Language.Visibility)]</span>
                                    <select class="utf-command-input"
                                            title="@(Localizer[nameof(Language.Pages_Events_Edit_Tooltip_Visibility)])"
                                            @bind="VisibilityValue">
                                        <option value="public">@Localizer[nameof(Language.Public)]</option>
                                        <option value="hidden">@Localizer[nameof(Language.Hidden)]</option>
                                    </select>
                                </label>
                                <div class="utf-command-field event-editor-field event-editor-autocomplete">
                                    <FluentAutocomplete Id="event-editor-terrain"
                                                        Required="true"
                                                        TOption="PlainTerrainDto"
                                                        MaximumSelectedOptions="1"
                                                        MaximumOptionsSearch="8"
                                                        AutoComplete="off"
                                                        Position="@SelectPosition.Below"
                                                        OnOptionsSearch="TerrainAutoCompleteService.PlainTerrainDto.OnOptionsSearch"
                                                        OptionText="TerrainAutoCompleteService.PlainTerrainDto.OptionText"
                                                        Label="@(Localizer[nameof(Language.Terrain)])"
                                                        Placeholder="@(Localizer[nameof(Language.Auto_SearchTerrain_ca2ee95e)])"
                                                        @bind-ValueText="_terrainText"
                                                        @bind-SelectedOption="_terrain"
                                                        @bind-SelectedOption:after="OnTerrainChanged">
                                        <OptionTemplate Context="terrain">
                                            <div class="event-editor-autocomplete-option">
                                                <span class="utf-md-icon utf-md-icon--map" aria-hidden="true"></span>
                                                <span>@GetTerrainLabel(terrain)</span>
                                            </div>
                                        </OptionTemplate>
                                        <SelectedOptionTemplate Context="terrain">
                                            <span class="event-editor-selected-option">@GetTerrainLabel(terrain)</span>
                                        </SelectedOptionTemplate>
                                    </FluentAutocomplete>
                                </div>
                                <div class="utf-command-field event-editor-field event-editor-autocomplete">
                                    <FluentAutocomplete Id="event-editor-modpack"
                                                        Required="true"
                                                        TOption="PlainModPackRevisionDto"
                                                        MaximumSelectedOptions="1"
                                                        MaximumOptionsSearch="8"
                                                        AutoComplete="off"
                                                        Position="@SelectPosition.Below"
                                                        OnOptionsSearch="ModPackAutoCompleteService.PlainModPackRevisionDto.OnOptionsSearch"
                                                        OptionText="ModPackAutoCompleteService.PlainModPackRevisionDto.OptionText"
                                                        Label="@(Localizer[nameof(Language.Auto_ModPackRevision_d199668f)])"
                                                        Placeholder="@(Localizer[nameof(Language.Auto_SearchModPack_33ce4302)])"
                                                        @bind-ValueText="_modPackText"
                                                        @bind-SelectedOption="_modPack"
                                                        @bind-SelectedOption:after="OnModPackChanged">
                                        <OptionTemplate Context="modPack">
                                            <div class="event-editor-autocomplete-option">
                                                <span class="utf-md-icon utf-md-icon--modpack" aria-hidden="true"></span>
                                                <span>@GetModPackLabel(modPack)</span>
                                            </div>
                                        </OptionTemplate>
                                        <SelectedOptionTemplate Context="modPack">
                                            <span class="event-editor-selected-option">@GetModPackLabel(modPack)</span>
