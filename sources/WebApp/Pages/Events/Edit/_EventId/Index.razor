                <div class="event-editor-detail__section">
                    <span class="utf-kicker">@Localizer[nameof(Language.Auto_ReadinessChecklist_13d029ae)]</span>
                    <ol class="event-editor-checklist">
                        @foreach (var item in GetReadinessRows())
                        {
                            <li class="@GetChecklistClass(item.IsComplete)" @key="item.Label">
                                <span class="utf-status__dot"></span>
                                <strong>@item.Label</strong>
