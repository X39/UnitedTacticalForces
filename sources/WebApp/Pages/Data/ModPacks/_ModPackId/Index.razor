    private async Task SaveChangesAsync()
    {
        if (!CanSaveChanges || _workspace is null)
            return;

        _isSaving = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var title = HasTitleChange ? _editTitle.Trim() : null;
            if (IsComposition)
            {
                var revisionIds = HasCompositionMemberChange ? GetLatestRevisionIds() : null;
                await ModPackRepository.ModifyModPackAsync(
                        ModPackId,
                        title,
                        useLatest: revisionIds is not null,
                        modPackRevisionIds: revisionIds
                    )
                    .ConfigureAwait(false);
            }
            else
            {
                await ModPackRepository.ModifyModPackAsync(
                        ModPackId,
                        title,
                        string.IsNullOrWhiteSpace(_replacementHtml) ? null : _replacementHtml
                    )
                    .ConfigureAwait(false);
            }

            _successMessage = Localizer[nameof(Language.Auto_ModPackChangesWereSaved_fcb4be49)].Value;
            await LoadAsync(clearMessages: false).ConfigureAwait(false);
        }
        catch
        {
            _errorMessage = Localizer[nameof(Language.Auto_ModPackChangesCouldNotBeSavedCheckThe_11fc0ea1)].Value;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeactivateModPackAsync()
    {
        if (!CanDeactivate)
            return;

        _isSaving = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            await ModPackRepository.DeleteModPackAsync(ModPackId)
                .ConfigureAwait(false);
            NavigationManager.NavigateTo(BaseUrl.ResolveSelfUrl("command/mod-packs"));
        }
        catch
        {
            _errorMessage = Localizer[nameof(Language.Auto_ModPackCouldNotBeDeactivatedRetryFromThe_3003a328)].Value;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ResetEditStateAsync()
    {
        _editTitle = _workspace?.Definition.Title ?? string.Empty;
        _replacementHtml = string.Empty;
        _replacementHtmlFileName = string.Empty;
        _selectedCompositionDefinitions = IsComposition && _workspace is not null
            ? await ResolveSelectedDefinitionsAsync(_workspace).ConfigureAwait(false)
            : [];
    }

    private async Task OnReplacementHtmlCompletedAsync(IEnumerable<FluentInputFileEventArgs> files)
    {
        if (files.SingleOrDefault() is not { Stream: not null } file)
            return;

        using var reader = new StreamReader(file.Stream);
        _replacementHtml = await reader.ReadToEndAsync();
        _replacementHtmlFileName = file.Name;
        _errorMessage = null;
        _successMessage = null;
    }

    private async Task OnStandaloneOptionsSearch(OptionsSearchEventArgs<FullModPackDefinitionDto> arg)
    {
        await ModPackAutoCompleteService.FullModPackDefinitionDto.OnOptionsSearch(arg);
        arg.Items = arg.Items?
            .Where(IsSelectableStandalone)
            .ToArray() ?? [];
    }

    private void DownloadLatestRevision()
    {
        if (_workspace?.Definition.PrimaryKey is not { } modPackId)
            return;

        var path = _workspace.Definition.RevisionPrimaryKey is { } revisionId && !IsComposition
            ? $"mod-packs/{modPackId}/download/{revisionId}"
            : $"mod-packs/{modPackId}/download/latest";
        NavigationManager.NavigateTo(BaseUrl.ResolveApiUrl(path), forceLoad: true);
    }

    private async Task<IReadOnlyList<FullModPackDefinitionDto>> ResolveSelectedDefinitionsAsync(
        ModPackWorkspaceInfo workspace)
    {
        var selectedDefinitions = new List<FullModPackDefinitionDto>();
        foreach (var member in workspace.CompositionMembers
                     .GroupBy(q => q.Definition.PrimaryKey)
                     .Select(q => q.OrderByDescending(member => member.Revision.TimeStampCreated).First()))
        {
            if (member.Definition.PrimaryKey is not { } definitionId)
                continue;

            try
            {
                var fullDefinition = await ModPackRepository.GetFullModPackDefinitionAsync(definitionId)
                    .ConfigureAwait(false);
                if (IsSelectableStandalone(fullDefinition))
                    selectedDefinitions.Add(fullDefinition);
            }
            catch
            {
                selectedDefinitions.Add(
                    new FullModPackDefinitionDto
                    {
                        PrimaryKey = definitionId,
                        Title = string.IsNullOrWhiteSpace(member.Definition.Title)
                            ? Localizer[nameof(Language.Panels_CreateModPackPanel_FallbackModPackTitle), definitionId].Value
                            : member.Definition.Title,
                        Owner = member.Owner,
                        IsActive = member.Definition.IsActive,
                        IsComposition = false,
                        ModPackRevisions = new List<PlainModPackRevisionDto> { member.Revision },
                    }
                );
            }
        }

        return selectedDefinitions;
    }

    private bool HasRouteModPackPermission(string claimIdentifier)
    {
        if (!Me.IsAuthenticated)
            return false;

        var routeValue = ModPackId.ToString(CultureInfo.InvariantCulture);
        return Me.HasResourceClaimOrModPackAdmin(Claims.ResourceBased.ModPack.All, routeValue)
               || Me.HasResourceClaimOrModPackAdmin(claimIdentifier, routeValue);
    }

    private string WorkspaceHref(string? section)
        => BaseUrl.ResolveSelfUrl(section is null
            ? $"command/mod-packs/{ModPackId}"
            : $"command/mod-packs/{ModPackId}/{section}");

    private long[] GetLatestRevisionIds()
        => _selectedCompositionDefinitions
            .Select(q => GetLatestActiveRevision(q)?.PrimaryKey)
            .Where(q => q is not null)
            .Select(q => q!.Value)
            .ToArray();

    private static bool IsSelectableStandalone(FullModPackDefinitionDto definitionDto)
        => !(definitionDto.IsComposition ?? false) && GetLatestActiveRevision(definitionDto)?.PrimaryKey is not null;

    private static PlainModPackRevisionDto? GetLatestActiveRevision(FullModPackDefinitionDto definitionDto)
        => definitionDto.ModPackRevisions
            ?.Where(q => q.IsActive ?? true)
            .OrderByDescending(q => q.TimeStampCreated)
            .FirstOrDefault();

    private static string NormalizeSection(string? section)
        => section?.Trim().ToLowerInvariant() switch
        {
            "artifact"  => "artifact",
            "edit"      => "edit",
            "revisions" => "revisions",
            "downloads" => "downloads",
            "danger"    => "danger",
            _           => "overview",
        };

    private static string GetRevisionStatusClass(PlainModPackRevisionDto revision)
        => revision.IsActive ?? false
            ? "utf-status utf-status--success"
            : "utf-status utf-status--warning";

    private static string GetDownloadAuditKey(ModPackDownloadAuditInfo audit)
        => $"{audit.User?.PrimaryKey}:{audit.ModPackDefinitionId}:{audit.ModPackRevisionId}";

    private string FormatActiveState(bool isActive)
        => isActive ? Localizer[nameof(Language.Active)].Value : Localizer[nameof(Language.Inactive)].Value;

    private static string FormatDate(DateTimeOffset? value)
        => value?.ToLocalTime().ToString("dd MMM yyyy, HH:mm", CultureInfo.CurrentCulture) ?? MissingValue;

    private static string FormatValue<T>(T? value)
        => value?.ToString() ?? MissingValue;

    private static string FormatOwner(PlainUserDto? owner)
        => string.IsNullOrWhiteSpace(owner?.Nickname) ? MissingValue : owner.Nickname;

    private static string FormatUser(PlainUserDto? user)
        => string.IsNullOrWhiteSpace(user?.Nickname) ? MissingValue : user.Nickname;

    private string FormatTitle(string? title)
        => string.IsNullOrWhiteSpace(title) ? Localizer[nameof(Language.Auto_UntitledModPack_68e62d9a)].Value : title;

    private static string FormatRevision(PlainModPackRevisionDto? revision)
        => revision is null ? MissingValue : $"#{revision.PrimaryKey}";

    private static string FormatCount(long? count, string singular, string plural)
    {
        if (count is null)
            return MissingValue;
        return count == 1
            ? $"1 {singular}"
            : $"{count.Value.ToString(CultureInfo.CurrentCulture)} {plural}";
    }
}
