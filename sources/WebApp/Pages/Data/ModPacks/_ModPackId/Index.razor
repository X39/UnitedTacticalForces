@page "/data/mod-packs/{ModPackId:long}"
@page "/command/mod-packs/{ModPackId:long}"
@page "/command/mod-packs/{ModPackId:long}/{Section}"
@layout CommandCenterLayout
@using X39.UnitedTacticalForces.WebApp.Services.ModPackRepository
@using X39.UnitedTacticalForces.WebApp.Services.GameServerRepository
@using X39.UnitedTacticalForces.Hosting.Contracts
@inject IModPackRepository ModPackRepository
@inject IGameServerRepository GameServerRepository
@inject NavigationManager NavigationManager
@inject BaseUrl BaseUrl
@inject MeService Me
@inject IJSRuntime JsRuntime
@inject IStringLocalizer<Language> Localizer

<PageTitle>@(_workspace?.Title ?? Localizer["ModPacks_FallbackTitle", ModPackId])</PageTitle>
<NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" OnBeforeInternalNavigation="ConfirmInternalNavigationAsync" />
<div class="mod-pack-workspace-page">
    <UtfCommandPageHeader Title="@(_workspace?.Title ?? Localizer["ModPacks_FallbackTitle", ModPackId])" Description="@Localizer["ModPacks_WorkspaceDescription"]">
        <Actions><UtfCommandButton Href="@BaseUrl.ResolveSelfUrl("command/mod-packs")"><ChildContent>@Localizer["ModPacks_All"]</ChildContent></UtfCommandButton><UtfCommandButton Disabled="@_isLoading" OnClick="ReloadAsync"><ChildContent>@Localizer["ModPacks_Refresh"]</ChildContent></UtfCommandButton></Actions>
    </UtfCommandPageHeader>
    @if (_errorMessage is not null) { <div class="utf-state-panel utf-state-panel--warning" role="alert" aria-live="assertive">@_errorMessage</div> }
    @if (_successMessage is not null) { <div class="utf-state-panel utf-state-panel--success" role="status" aria-live="polite">@_successMessage</div> }
    @if (_isLoading) { <div class="utf-state-panel" aria-live="polite" aria-busy="true">@Localizer["ModPacks_LoadingWorkspace"]</div> }
    else if (_workspace is null) { <section class="utf-empty-state"><h2>@Localizer["ModPacks_NotFound"]</h2></section> }
    else
    {
        <section class="utf-panel mod-pack-workspace-frame">
            <div class="mod-pack-selected-summary"><div><span class="utf-status utf-status--neutral"><span class="utf-status__dot"></span>@Localizer["ModPacks_Normalized"]</span><strong>@_workspace.Title</strong><span>@_workspace.GameIdentifier</span></div><dl><div><dt>@Localizer["ModPacks_Definition"]</dt><dd>@ModPackId</dd></div><div><dt>@Localizer["ModPacks_LatestRevision"]</dt><dd>@RevisionId</dd></div><div><dt>@Localizer["ModPacks_EffectiveMods"]</dt><dd>@_effectiveMembership.Mods.Count</dd></div></dl></div>
            <nav class="mod-pack-detail-tabs" aria-label="@Localizer["ModPacks_WorkspaceNavigation"]"><NavLink class="mod-pack-detail-tab" href="@WorkspaceHref(null)" Match="NavLinkMatch.All">@Localizer["ModPacks_Content"]</NavLink><NavLink class="mod-pack-detail-tab" href="@WorkspaceHref("edit")">@Localizer["ModPacks_NewRevision"]</NavLink><NavLink class="mod-pack-detail-tab" href="@WorkspaceHref("revisions")">@Localizer["ModPacks_Revisions"]</NavLink><NavLink class="mod-pack-detail-tab mod-pack-detail-tab--danger" href="@WorkspaceHref("danger")">@Localizer["ModPacks_Danger"]</NavLink></nav>
            @if (ActiveSection == "edit") { @EditSection() }
            else if (ActiveSection == "revisions") { @RevisionSection() }
            else if (ActiveSection == "danger") { @DangerSection() }
            else { @ContentSection() }
        </section>
    }
</div>

@code {
    private NormalizedModPackWorkspaceInfo? _workspace;
    private ModPackMembershipInfo _directMembership = new();
    private ModPackMembershipInfo _effectiveMembership = new();
    private IReadOnlyList<ModCatalogItemInfo> _catalog = [];
    private IReadOnlyList<NormalizedModPackListItemInfo> _availablePacks = [];
    private IReadOnlyList<ModPackFormatInfo> _formats = [];
    private IReadOnlyList<GameServerCapabilityInfo> _capabilities = [];
    private readonly List<ImportedDraft> _importedDrafts = [];
    private readonly HashSet<Guid> _selectedModIds = [];
    private readonly HashSet<long> _selectedPackIds = [];
    private bool _isLoading;
    private bool _isSaving;
    private string _dangerConfirmation = string.Empty;
    private string? _errorMessage;
    private string? _successMessage;
    [Parameter] public long ModPackId { get; set; }
    [Parameter] public string? Section { get; set; }
    private long? RevisionId => _workspace?.Revisions.FirstOrDefault(q => q.IsActive)?.RevisionId;
    private string ActiveSection => Section?.ToLowerInvariant() switch { "edit" => "edit", "revisions" => "revisions", "danger" => "danger", _ => "content" };
    private bool CanModify => Me.HasBaseClaimOrModPackAdmin(Claims.ResourceBased.ModPack.Modify, Claims.ResourceBased.ModPack.All);
    private bool HasUnsavedChanges => !_isSaving && ActiveSection == "edit"
        && (!_selectedModIds.SetEquals(_directMembership.Mods.Select(q => q.ModFk))
            || !_selectedPackIds.SetEquals(_directMembership.Dependencies.Select(q => q.ChildDefinitionFk))
            || _importedDrafts.Count > 0);

    protected override async Task OnParametersSetAsync() => await LoadAsync();
    private async Task ReloadAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        _isLoading = true; _errorMessage = null;
        try
        {
            _workspace = await ModPackRepository.GetNormalizedModPackAsync(ModPackId);
            if (_workspace is null || RevisionId is not { } revisionId) return;
            _directMembership = await ModPackRepository.GetMembershipAsync(revisionId, false);
            _effectiveMembership = await ModPackRepository.GetMembershipAsync(revisionId, true);
            _formats = await ModPackRepository.GetRevisionFormatsAsync(revisionId);
            _selectedFormat = _formats.FirstOrDefault()?.Identifier ?? string.Empty;
            _capabilities = await GameServerRepository.GetCapabilitiesAsync();
            _catalog = await ModPackRepository.GetModsAsync(_workspace.GameIdentifier);
            _availablePacks = (await ModPackRepository.GetNormalizedModPacksAsync(_workspace.GameIdentifier)).Where(q => q.DefinitionId != ModPackId).ToArray();
            _selectedModIds.Clear(); foreach (var mod in _directMembership.Mods) _selectedModIds.Add(mod.ModFk);
            _selectedPackIds.Clear(); foreach (var pack in _directMembership.Dependencies) _selectedPackIds.Add(pack.ChildDefinitionFk);
        }
        catch (Exception exception) { _errorMessage = UserFacingError.Message(exception); }
        finally { _isLoading = false; }
    }

    private RenderFragment ContentSection() => @<section class="mod-pack-workspace-section"><div class="mod-pack-section-heading"><div><span class="utf-kicker">@Localizer["ModPacks_ResolvedContent"]</span><h2>@Localizer["ModPacks_DirectEffective"]</h2></div></div>
        <div class="mod-pack-content-grid"><article class="mod-pack-workspace-panel"><h3>@Localizer["ModPacks_DirectMods"]</h3>@MembershipTable(_directMembership.Mods)</article><article class="mod-pack-workspace-panel"><h3>@Localizer["ModPacks_EffectiveMods"]</h3>@MembershipTable(_effectiveMembership.Mods)</article></div>
        <article class="mod-pack-workspace-panel"><h3>@Localizer["ModPacks_Nested"]</h3>@if (_directMembership.Dependencies.Count == 0) { <p>@Localizer["ModPacks_NoNested"]</p> } else { <ul>@foreach (var dependency in _directMembership.Dependencies) { <li>@Localizer["ModPacks_Dependency", dependency.ChildDefinitionFk, dependency.PinnedChildRevisionFk?.ToString() ?? Localizer["ModPacks_Latest"]]</li> }</ul> }</article>
        @if (_formats.Count > 0) { <article class="mod-pack-workspace-panel"><h3>@Localizer["ModPacks_AvailableFormats"]</h3>@foreach (var format in _formats) { <button class="utf-button utf-button--ghost" type="button" @onclick="@(() => DownloadFormat(format.Identifier))">@Localizer["ModPacks_DownloadFormat", format.DisplayName]</button> }</article> }
    </section>;

    private RenderFragment MembershipTable(IReadOnlyList<ModPackModMemberInfo> mods) => @<div class="utf-command-table-scroll"><table class="utf-command-table"><thead><tr><th>@Localizer["ModPacks_Mod"]</th><th>@Localizer["ModPacks_Provider"]</th><th>@Localizer["ModPacks_Source"]</th><th>@Localizer["ModPacks_Role"]</th><th>@Localizer["ModPacks_Version"]</th></tr></thead><tbody>@foreach (var mod in mods) { <tr><td><strong>@mod.Title</strong></td><td>@mod.ProviderIdentifier</td><td>@mod.CanonicalSourceIdentifier</td><td>@mod.UsageRole</td><td>@(mod.PinnedVersionFk?.ToString() ?? Localizer["ModPacks_Latest"])</td></tr> }</tbody></table></div>;

    private RenderFragment EditSection() => @<section class="mod-pack-workspace-section"><div class="mod-pack-section-heading"><div><span class="utf-kicker">@Localizer["ModPacks_ImmutableHistory"]</span><h2>@Localizer["ModPacks_CreateRevision"]</h2></div></div>
        @if (!CanModify) { <div class="utf-empty-state"><p>@Localizer["ModPacks_ModifyRequired"]</p></div> }
        else
        {
            @if (_formats.Count > 0) { <article class="mod-pack-workspace-panel"><label for="modpack-update-format">@Localizer["ModPacks_ImportFormat"]</label><select id="modpack-update-format" class="utf-command-input" @bind="_selectedFormat">@foreach (var format in _formats) { <option value="@format.Identifier">@format.DisplayName</option> }</select><FluentInputFile Id="modpack-update-import" AriaLabel="@Localizer["ModPacks_ImportFormat"]" Mode="InputFileMode.Stream" Multiple="false" MaximumFileCount="1" MaximumFileSize="@(_formats.FirstOrDefault(q => q.Identifier == _selectedFormat)?.MaximumSizeBytes ?? 4 * Constants.File.Megabyte)" OnCompleted="ImportFormatAsync" /></article> }
            @if (_importedDrafts.Count > 0) { <article class="mod-pack-workspace-panel"><h3>@Localizer["ModPacks_ImportReview"]</h3>@foreach (var draft in _importedDrafts) { <div><strong>@draft.Title</strong> — @draft.ProviderIdentifier @if (draft.ExistingModId is not null) { <span>@Localizer["ModPacks_CatalogMatch"]</span> } else { <select aria-label="@Localizer["ModPacks_InstallerFor", draft.Title]" class="utf-command-input" @bind="draft.InstallerIdentifier">@foreach (var installer in draft.Installers) { <option value="@installer">@installer</option> }</select> }</div> }</article> }
            <article class="mod-pack-workspace-panel"><h3>@Localizer["ModPacks_DirectMods"]</h3><div class="modpack-choice-list">@foreach (var mod in _catalog) { <label><input type="checkbox" checked="@_selectedModIds.Contains(mod.PrimaryKey)" @onchange="@(args => ToggleMod(mod.PrimaryKey, args))"/><strong>@mod.Title</strong><small>@mod.ProviderIdentifier · @mod.CanonicalSourceIdentifier</small></label> }</div></article>
            <article class="mod-pack-workspace-panel"><h3>@Localizer["ModPacks_Nested"]</h3><div class="modpack-choice-list">@foreach (var pack in _availablePacks) { <label><input type="checkbox" checked="@_selectedPackIds.Contains(pack.DefinitionId)" @onchange="@(args => TogglePack(pack.DefinitionId, args))"/><strong>@pack.Title</strong></label> }</div></article>
            @if (_selectedModIds.Count + _selectedPackIds.Count + _importedDrafts.Count == 0) { <p role="alert">@Localizer["ModPacks_RevisionNonEmpty"]</p> }
            <button class="utf-button utf-button--primary" type="button" disabled="@(_isSaving || _selectedModIds.Count + _selectedPackIds.Count + _importedDrafts.Count == 0)" @onclick="SaveRevisionAsync">@(_isSaving ? Localizer["ModPacks_Saving"] : Localizer["ModPacks_SaveRevision"])</button>
        }
    </section>;

    private RenderFragment RevisionSection() => @<section class="mod-pack-workspace-section"><div class="mod-pack-section-heading"><div><span class="utf-kicker">@Localizer["ModPacks_History"]</span><h2>@Localizer["ModPacks_ImmutableRevisions"]</h2></div></div><div class="utf-command-table-scroll"><table class="utf-command-table"><thead><tr><th>@Localizer["ModPacks_Revision"]</th><th>@Localizer["ModPacks_Created"]</th><th>@Localizer["ModPacks_Status"]</th></tr></thead><tbody>@foreach (var revision in _workspace!.Revisions) { <tr><td>@revision.RevisionId</td><td>@revision.TimeStampCreated.ToLocalTime()</td><td>@(revision.IsActive ? Localizer["ModPacks_Active"] : Localizer["ModPacks_Superseded"])</td></tr> }</tbody></table></div></section>;
    private RenderFragment DangerSection() => @<section class="mod-pack-workspace-section"><article class="mod-pack-workspace-panel"><h2>@Localizer["ModPacks_DeactivateTitle"]</h2><p>@Localizer["ModPacks_Normalized"]</p></article></section>;

    private async Task SaveRevisionAsync()
    {
        if (_selectedModIds.Count + _selectedPackIds.Count + _importedDrafts.Count == 0)
        {
            _errorMessage = Localizer["ModPacks_RevisionNonEmpty"];
            return;
        }
        _isSaving = true; _errorMessage = null; _successMessage = null;
        try
        {
            var existingPins = _directMembership.Mods.ToDictionary(q => q.ModFk, q => q.PinnedVersionFk);
            var dependencyPins = _directMembership.Dependencies.ToDictionary(q => q.ChildDefinitionFk, q => q.PinnedChildRevisionFk);
            var importedExisting = _importedDrafts.Where(q => q.ExistingModId.HasValue).Select(q => q.ExistingModId!.Value);
            await ModPackRepository.AppendRevisionAsync(ModPackId, new NormalizedModPackRevisionPayload { Mods = _selectedModIds.Concat(importedExisting).Distinct().Select(q => new NormalizedModMembershipPayload(q, existingPins.GetValueOrDefault(q))).ToArray(), NewMods = _importedDrafts.Where(q => q.ExistingModId is null).Select(q => new NormalizedModDraftPayload { Title = q.Title, ProviderIdentifier = q.ProviderIdentifier, Source = q.Source, UsageRole = EModUsageRole.Shared, InstallerIdentifier = q.InstallerIdentifier }).ToArray(), Dependencies = _selectedPackIds.Select(q => new NormalizedModPackDependencyPayload(q, dependencyPins.GetValueOrDefault(q))).ToArray() });
            _successMessage = Localizer["ModPacks_RevisionCreated"]; await LoadAsync();
        }
        catch (Exception exception) { _errorMessage = UserFacingError.Message(exception); }
        finally { _isSaving = false; }
    }
    private void ToggleMod(Guid id, ChangeEventArgs args) { if (args.Value is true) _selectedModIds.Add(id); else _selectedModIds.Remove(id); }
    private void TogglePack(long? id, ChangeEventArgs args) { if (id is not { } value) return; if (args.Value is true) _selectedPackIds.Add(value); else _selectedPackIds.Remove(value); }
    private string _selectedFormat = string.Empty;
    private async Task ImportFormatAsync(IEnumerable<FluentInputFileEventArgs> files) { if (files.SingleOrDefault() is not { Stream: not null } file) return; var format = _formats.FirstOrDefault(q => q.Identifier == _selectedFormat); var capability = _capabilities.FirstOrDefault(q => q.GameIdentifier == _workspace?.GameIdentifier); if (format is null || capability is null) { _errorMessage = Localizer["ModPacks_ImportUnavailable"]; return; } var preview = await ModPackRepository.PreviewFormatAsync(_workspace!.GameIdentifier, format.Identifier, file.Name, file.Stream); _importedDrafts.Clear(); foreach (var entry in preview.Entries) { var binding = capability.ModProviderBindings.FirstOrDefault(q => q.ProviderIdentifier == entry.Source.ProviderIdentifier); if (binding is null) { _errorMessage = Localizer["ModPacks_UnsupportedImportedProvider", entry.Source.ProviderIdentifier]; continue; } if (string.IsNullOrWhiteSpace(entry.SourceInput)) { _errorMessage = Localizer["ModPacks_InvalidImportedSource", entry.Source.CanonicalSourceIdentifier]; continue; } _importedDrafts.Add(new ImportedDraft(entry.Title, entry.Source.ProviderIdentifier, entry.SourceInput, entry.ExistingModId, binding.InstallerIdentifiers.ToArray())); } if (preview.Warnings.Count > 0) _errorMessage = string.Join(" ", preview.Warnings); }
    private void DownloadFormat(string identifier) => NavigationManager.NavigateTo(BaseUrl.ResolveApiUrl($"game-content/mod-packs/revisions/{RevisionId}/formats/{Uri.EscapeDataString(identifier)}"), forceLoad: true);
    private string WorkspaceHref(string? section) => BaseUrl.ResolveSelfUrl(section is null ? $"command/mod-packs/{ModPackId}" : $"command/mod-packs/{ModPackId}/{section}");
    private async Task ConfirmInternalNavigationAsync(LocationChangingContext context) { if (HasUnsavedChanges && !await JsRuntime.InvokeAsync<bool>("confirm", Localizer["ModPacks_DiscardRevisionChanges"].Value)) context.PreventNavigation(); }
    private sealed class ImportedDraft(string title, string providerIdentifier, string source, Guid? existingModId, IReadOnlyList<string> installers) { public string Title { get; } = title; public string ProviderIdentifier { get; } = providerIdentifier; public string Source { get; } = source; public Guid? ExistingModId { get; } = existingModId; public IReadOnlyList<string> Installers { get; } = installers; public string InstallerIdentifier { get; set; } = installers.FirstOrDefault() ?? string.Empty; }
}
