@page "/data/mod-packs/all"
@page "/command/mod-packs"
@layout CommandCenterLayout
@using X39.UnitedTacticalForces.WebApp.Services.GameServerRepository
@using X39.UnitedTacticalForces.WebApp.Services.ModPackRepository
@inject IStringLocalizer<Language> Localizer
@inject IModPackRepository ModPackRepository
@inject IGameServerRepository GameServerRepository
@inject NavigationManager NavigationManager
@inject BaseUrl BaseUrl

<PageTitle>@Localizer[nameof(Language.Pages_ModPacks_AllModPacks)]</PageTitle>
<div class="modpacks-page">
    <UtfCommandPageHeader Title="@Localizer[nameof(Language.Pages_ModPacks_AllModPacks)]" Description="@Localizer["ModPacks_LedgerDescription"]">
        <Actions><UtfCommandButton Disabled="@_isLoading" OnClick="LoadAsync">@Localizer[nameof(Language.Common_Refresh)]</UtfCommandButton><UtfCommandButton Variant="primary" Href="@BaseUrl.ResolveSelfUrl("command/mod-packs/create")">@Localizer["ModPacks_CreateTitle"]</UtfCommandButton></Actions>
    </UtfCommandPageHeader>
    @if (_error is not null) { <div class="utf-state-panel utf-state-panel--warning" role="alert" aria-live="assertive">@_error</div> }
    @if (_isLoading) { <div class="utf-state-panel" role="status" aria-live="polite" aria-busy="true">@Localizer[nameof(Language.Auto_LoadingModPackControl_4b9cc997)]</div> }
    else if (_modPacks.Count == 0) { <section class="utf-empty-state"><p>@Localizer[nameof(Language.Auto_NoModPacksMatchTheCurrentFilters_33565b66)]</p></section> }
    else
    {
        <section class="utf-panel modpacks-list"><div class="utf-command-table-scroll"><table class="utf-command-table"><thead><tr><th>@Localizer[nameof(Language.Package)]</th><th>@Localizer["ModPacks_Game"]</th><th>@Localizer["ModPacks_LatestRevision"]</th><th>@Localizer[nameof(Language.Action)]</th></tr></thead><tbody>
        @foreach (var modPack in _modPacks) { <tr @key="modPack.DefinitionId"><td><strong>@modPack.Title</strong></td><td>@modPack.GameIdentifier</td><td>@(modPack.LatestRevisionId?.ToString() ?? Localizer["ModPacks_None"])</td><td><button class="utf-button utf-button--ghost" type="button" @onclick="@(() => Open(modPack.DefinitionId))">@Localizer[nameof(Language.Open)]</button></td></tr> }
        </tbody></table></div></section>
    }
</div>

@code {
    private IReadOnlyList<NormalizedModPackListItemInfo> _modPacks = [];
    private bool _isLoading;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            var capabilities = await GameServerRepository.GetCapabilitiesAsync();
            var results = await Task.WhenAll(capabilities.Where(q => q.SupportsModPacks).Select(q => ModPackRepository.GetNormalizedModPacksAsync(q.GameIdentifier)));
            _modPacks = results.SelectMany(q => q).OrderBy(q => q.Title).ToArray();
        }
        catch (Exception exception) { _error = UserFacingError.Message(exception); _modPacks = []; }
        finally { _isLoading = false; }
    }

    private void Open(long definitionId) => NavigationManager.NavigateTo(BaseUrl.ResolveSelfUrl($"command/mod-packs/{definitionId}"));
}
