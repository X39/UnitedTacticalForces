@page "/data/mod-packs/create"
@page "/command/mod-packs/create"
@layout CommandCenterLayout
@using X39.UnitedTacticalForces.Hosting.Contracts
@using X39.UnitedTacticalForces.WebApp.Services.GameServerRepository
@using X39.UnitedTacticalForces.WebApp.Services.ModPackRepository
@inject IModPackRepository ModPackRepository
@inject IGameServerRepository GameServerRepository
@inject NavigationManager NavigationManager
@inject BaseUrl BaseUrl
@inject MeService Me
@inject IJSRuntime JsRuntime
@inject IStringLocalizer<Language> Localizer

<PageTitle>@Localizer["ModPacks_CreateTitle"]</PageTitle>
<NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" OnBeforeInternalNavigation="ConfirmInternalNavigationAsync" />
<div class="modpack-create-page">
    <UtfCommandPageHeader Title="@Localizer["ModPacks_CreateTitle"]" Description="@Localizer["ModPacks_CreateDescription"]">
        <Actions><UtfCommandButton OnClick="@(() => NavigationManager.NavigateTo(BaseUrl.ResolveSelfUrl("command/mod-packs")))"><ChildContent>@Localizer["ModPacks_Back"]</ChildContent></UtfCommandButton></Actions>
    </UtfCommandPageHeader>
    @if (!CanCreateModPacks)
    {
        <section class="utf-empty-state"><h2>@Localizer["ModPacks_AdminRequired"]</h2></section>
    }
    else if (_isLoading)
    {
        <section class="utf-state-panel" aria-live="polite" aria-busy="true">@Localizer["ModPacks_LoadingCapabilities"]</section>
    }
    else
    {
        @if (_submitError is not null) { <div class="utf-state-panel utf-state-panel--warning" role="alert">@_submitError</div> }
        <section class="utf-panel modpack-create-flow">
            <ol class="modpack-create-stepper" aria-label="@Localizer["ModPacks_CreateSteps"]">
                @foreach (var step in Enumerable.Range(1, 3))
                {
                    <li class="@GetStepClass(step)"><button type="button" @onclick="@(() => _step = step)"><span>@step</span><strong>@GetStepLabel(step)</strong><small>@GetStepDescription(step)</small></button></li>
                }
            </ol>
            <main class="modpack-create-step">
                @if (_step == 1)
                {
                    <section class="modpack-create-section">
                        <div class="modpack-create-section__heading"><div><span class="utf-kicker">@Localizer["ModPacks_Definition"]</span><h2>@Localizer["ModPacks_PackageIdentity"]</h2></div></div>
                        <label class="modpack-create-field" for="modpack-game"><span>@Localizer["ModPacks_Game"]</span></label><select id="modpack-game" class="utf-command-input" value="@_gameIdentifier" @onchange="ChangeGameAsync">@foreach (var game in _capabilities.Where(q => q.SupportsModPacks)) { <option value="@game.GameIdentifier">@game.DisplayName</option> }</select>
                        <label class="modpack-create-field" for="modpack-title"><span>@Localizer["ModPacks_Title"]</span></label><input id="modpack-title" class="utf-command-input" maxlength="1024" @bind="_title" @bind:event="oninput" />
                        @if (SelectedCapability is { } capability)
                        {
                            <div class="modpack-create-review-panel"><strong>@Localizer["ModPacks_SupportedSources"]</strong><span>@string.Join(", ", capability.ModProviderBindings.Select(q => q.DisplayName))</span>
                                @if (capability.ModPackFormats.Count > 0) { <span>@Localizer["ModPacks_ImportExport", string.Join(", ", capability.ModPackFormats.Select(q => q.DisplayName))]</span> }
                            </div>
                        }
                    </section>
                }
                else if (_step == 2)
                {
                    <section class="modpack-create-section">
                        <div class="modpack-create-section__heading"><div><span class="utf-kicker">@Localizer["ModPacks_Content"]</span><h2>@Localizer["ModPacks_ModsAndNested"]</h2></div><span>@Localizer["ModPacks_MemberCount", MemberCount]</span></div>
                        @if (SelectedCapability?.ModPackFormats.Count > 0)
                        {
                            <div class="modpack-source-entry"><label for="modpack-format-select">@Localizer["ModPacks_ImportFormat"]</label><select id="modpack-format-select" class="utf-command-input" @bind="_selectedFormatIdentifier">@foreach (var format in SelectedCapability.ModPackFormats) { <option value="@format.Identifier">@format.DisplayName</option> }</select><FluentInputFile Id="modpack-format-import" AriaLabel="@Localizer["ModPacks_ImportFormat"]" Mode="InputFileMode.Stream" Multiple="false" MaximumFileCount="1" MaximumFileSize="@(SelectedFormat?.MaximumSizeBytes ?? 4 * Constants.File.Megabyte)" Accept="@SelectedFormat?.FileExtension" OnCompleted="ImportFormatAsync" /></div>
                        }
                        @if (UploadedBinding is { } upload)
                        {
                            <div class="modpack-source-entry"><label for="modpack-artifact-title">@Localizer["ModPacks_ArtifactTitle"]</label><input id="modpack-artifact-title" class="utf-command-input" @bind="_artifactTitle"/><label for="modpack-artifact-installer">@Localizer["ModPacks_Installer"]</label><select id="modpack-artifact-installer" class="utf-command-input" @bind="_artifactInstaller">@foreach (var installer in upload.InstallerIdentifiers) { <option value="@installer">@installer</option> }</select><FluentInputFile Id="modpack-artifact-upload" AriaLabel="@Localizer["ModPacks_UploadArtifact"]" Mode="InputFileMode.Stream" Multiple="false" MaximumFileCount="1" MaximumFileSize="@(2L * 1024 * 1024 * 1024)" Accept=".zip,application/zip" OnCompleted="UploadArtifactAsync" /></div>
                        }
                        <div class="modpack-source-entry">
                            <label class="modpack-create-field modpack-create-field--wide"><span>@Localizer["ModPacks_PasteSources"]</span><textarea aria-label="@Localizer["ModPacks_PasteSources"]" class="utf-command-input" rows="4" @bind="_sourceInput"></textarea></label>
                            <button class="utf-button utf-button--ghost" type="button" disabled="@_isResolving" @onclick="PreviewSourcesAsync">@(_isResolving ? Localizer["ModPacks_Resolving"] : Localizer["ModPacks_PreviewSources"])</button>
                        </div>
                        @if (_sourcePreviews.Count > 0)
                        {
                            <section class="modpack-create-review-panel" aria-labelledby="source-preview-title"><header><strong id="source-preview-title">@Localizer["ModPacks_SourceReview"]</strong></header>
                            @foreach (var draft in _sourcePreviews)
                            {
                                <article class="modpack-source-preview" @key="draft.Input"><div><strong>@draft.Preview.Source.Title</strong><small>@draft.Preview.Source.ProviderIdentifier · @draft.Preview.Source.CanonicalSourceIdentifier</small></div>
                                @if (draft.Preview.ExistingModId is not null) { <span class="utf-status utf-status--success"><span class="utf-status__dot"></span>@Localizer["ModPacks_CatalogMatch"]</span> }
                                else
                                {
                                    <label>@Localizer["ModPacks_Usage"]<select aria-label="@Localizer["ModPacks_Usage"]" class="utf-command-input" @bind="draft.UsageRole">@foreach (var role in Enum.GetValues<EModUsageRole>()) { <option value="@role">@role</option> }</select></label>
                                    <label>@Localizer["ModPacks_Installer"]<select aria-label="@Localizer["ModPacks_Installer"]" class="utf-command-input" @bind="draft.InstallerIdentifier">@foreach (var installer in draft.Preview.InstallerIdentifiers) { <option value="@installer">@installer</option> }</select></label>
                                    <label>@Localizer["ModPacks_VersionRef"]<input aria-label="@Localizer["ModPacks_VersionRef"]" class="utf-command-input" @bind="draft.VersionSelector" /></label>
                                }
                                <button class="utf-button utf-button--ghost" type="button" @onclick="@(() => RemovePreview(draft))">@Localizer["ModPacks_Remove"]</button></article>
                            }
                            </section>
                        }
                        <section class="modpack-create-review-panel"><header><strong>@Localizer["ModPacks_Catalog"]</strong><button type="button" @onclick="SearchCatalogAsync">@Localizer["ModPacks_Search"]</button></header>
                            <label class="modpack-create-field"><span>@Localizer["ModPacks_FindMods"]</span><input aria-label="@Localizer["ModPacks_FindMods"]" class="utf-command-input" @bind="_catalogSearch" /></label>
                            <div class="modpack-choice-list">@foreach (var mod in _catalog) { <label @key="mod.PrimaryKey"><input type="checkbox" checked="@_selectedModIds.Contains(mod.PrimaryKey)" @onchange="@(args => ToggleMod(mod.PrimaryKey, args))" /> <strong>@mod.Title</strong><small>@mod.ProviderIdentifier · @mod.CanonicalSourceIdentifier</small></label> }</div>
                        </section>
                        <section class="modpack-create-review-panel"><header><strong>@Localizer["ModPacks_Nested"]</strong></header><div class="modpack-choice-list">@foreach (var pack in _availablePacks) { <label @key="pack.DefinitionId"><input type="checkbox" checked="@_selectedPackIds.Contains(pack.DefinitionId)" @onchange="@(args => TogglePack(pack.DefinitionId, args))" /> <strong>@pack.Title</strong></label> }</div></section>
                    </section>
                }
                else
                {
                    <section class="modpack-create-section"><div class="modpack-create-section__heading"><div><span class="utf-kicker">@Localizer["ModPacks_Review"]</span><h2>@Localizer["ModPacks_CommitRevision"]</h2></div></div>
                        <div class="modpack-create-review-grid"><article class="modpack-create-review-panel"><strong>@_title</strong><span>@SelectedCapability?.DisplayName</span></article><article class="modpack-create-review-panel"><strong>@Localizer["ModPacks_ContentMemberCount", MemberCount]</strong><span>@Localizer["ModPacks_ContentMemberBreakdown", _selectedModIds.Count, _sourcePreviews.Count, _selectedPackIds.Count]</span></article></div>
                        <p>@Localizer["ModPacks_CreateExplanation"]</p>
                    </section>
                }
            </main>
            <footer class="modpack-create-command-bar"><span>@GetStepLabel(_step)</span><div><button class="utf-button utf-button--ghost" type="button" disabled="@(_step == 1 || _isSubmitting)" @onclick="@(() => _step--)">@Localizer["ModPacks_Previous"]</button>
                @if (_step < 3) { <button class="utf-button utf-button--primary" type="button" disabled="@(!IsStepComplete(_step))" @onclick="@(() => _step++)">@Localizer["ModPacks_Next"]</button> }
                else { <button class="utf-button utf-button--primary" type="button" disabled="@(!CanCreate)" @onclick="CreateModPackAsync">@(_isSubmitting ? Localizer["ModPacks_Creating"] : Localizer["ModPacks_CreateTitle"])</button> }
            </div></footer>
        </section>
    }
</div>

@code {
    private IReadOnlyList<GameServerCapabilityInfo> _capabilities = [];
    private IReadOnlyList<ModCatalogItemInfo> _catalog = [];
    private IReadOnlyList<NormalizedModPackListItemInfo> _availablePacks = [];
    private readonly HashSet<Guid> _selectedModIds = [];
    private readonly HashSet<long> _selectedPackIds = [];
    private readonly List<SourceDraft> _sourcePreviews = [];
    private string _gameIdentifier = string.Empty;
    private string _title = string.Empty;
    private string _sourceInput = string.Empty;
    private string _catalogSearch = string.Empty;
    private string _artifactTitle = string.Empty;
    private string _artifactInstaller = string.Empty;
    private string _selectedFormatIdentifier = string.Empty;
    private string? _submitError;
    private int _step = 1;
    private bool _isLoading = true;
    private bool _isResolving;
    private bool _isSubmitting;
    private bool CanCreateModPacks => Me.HasBaseClaimOrModPackAdmin(Claims.Creation.ModPack, Claims.ResourceBased.ModPack.All);
    private GameServerCapabilityInfo? SelectedCapability => _capabilities.FirstOrDefault(q => q.GameIdentifier == _gameIdentifier);
    private ModPackFormatInfo? SelectedFormat => SelectedCapability?.ModPackFormats.FirstOrDefault(q => q.Identifier == _selectedFormatIdentifier) ?? SelectedCapability?.ModPackFormats.FirstOrDefault();
    private ModProviderBindingInfo? UploadedBinding => SelectedCapability?.ModProviderBindings.FirstOrDefault(q => q.ProviderIdentifier == "uploaded-artifact");
    private int MemberCount => _selectedModIds.Count + _sourcePreviews.Count + _selectedPackIds.Count;
    private bool CanCreate => !_isSubmitting && IsStepComplete(1) && IsStepComplete(2);
    private bool HasUnsavedChanges => !_isSubmitting && (!string.IsNullOrWhiteSpace(_title) || MemberCount > 0);

    protected override async Task OnInitializedAsync() { try { _capabilities = await GameServerRepository.GetCapabilitiesAsync(); _gameIdentifier = _capabilities.FirstOrDefault(q => q.SupportsModPacks)?.GameIdentifier ?? string.Empty; _selectedFormatIdentifier = SelectedCapability?.ModPackFormats.FirstOrDefault()?.Identifier ?? string.Empty; _artifactInstaller = UploadedBinding?.InstallerIdentifiers.FirstOrDefault() ?? string.Empty; await LoadChoicesAsync(); } catch (Exception exception) { _submitError = UserFacingError.Message(exception); } finally { _isLoading = false; } }
    private async Task ChangeGameAsync(ChangeEventArgs args) { _gameIdentifier = args.Value?.ToString() ?? string.Empty; _selectedModIds.Clear(); _selectedPackIds.Clear(); _sourcePreviews.Clear(); _selectedFormatIdentifier = SelectedCapability?.ModPackFormats.FirstOrDefault()?.Identifier ?? string.Empty; await LoadChoicesAsync(); }
    private async Task LoadChoicesAsync() { if (string.IsNullOrWhiteSpace(_gameIdentifier)) return; _catalog = await ModPackRepository.GetModsAsync(_gameIdentifier); _availablePacks = await ModPackRepository.GetNormalizedModPacksAsync(_gameIdentifier); }
    private async Task SearchCatalogAsync() => _catalog = await ModPackRepository.GetModsAsync(_gameIdentifier, _catalogSearch);
    private async Task ImportFormatAsync(IEnumerable<FluentInputFileEventArgs> files) { if (files.SingleOrDefault() is not { Stream: not null } file || SelectedFormat is null) return; _isResolving = true; try { var preview = await ModPackRepository.PreviewFormatAsync(_gameIdentifier, SelectedFormat.Identifier, file.Name, file.Stream); if (string.IsNullOrWhiteSpace(_title)) _title = preview.Title; _sourcePreviews.Clear(); foreach (var entry in preview.Entries) { var binding = SelectedCapability?.ModProviderBindings.FirstOrDefault(q => q.ProviderIdentifier == entry.Source.ProviderIdentifier); if (binding is null) { _submitError = Localizer["ModPacks_UnsupportedImportedProvider", entry.Source.ProviderIdentifier]; continue; } if (string.IsNullOrWhiteSpace(entry.SourceInput)) { _submitError = Localizer["ModPacks_InvalidImportedSource", entry.Source.CanonicalSourceIdentifier]; continue; } _sourcePreviews.Add(new SourceDraft(entry.SourceInput, new ModSourcePreviewInfo { SourceInput = entry.SourceInput, Source = entry.Source, ExistingModId = entry.ExistingModId, InstallerIdentifiers = binding.InstallerIdentifiers.ToArray() })); } if (preview.Warnings.Count > 0) _submitError = string.Join(" ", preview.Warnings); } catch (Exception exception) { _submitError = UserFacingError.Message(exception); } finally { _isResolving = false; } }
    private async Task UploadArtifactAsync(IEnumerable<FluentInputFileEventArgs> files) { if (files.SingleOrDefault() is not { Stream: not null } file || UploadedBinding is null) return; _isResolving = true; try { var installer = string.IsNullOrWhiteSpace(_artifactInstaller) ? UploadedBinding.InstallerIdentifiers.FirstOrDefault() : _artifactInstaller; if (string.IsNullOrWhiteSpace(installer)) { _submitError = Localizer["ModPacks_InstallerUnavailable"]; return; } var created = await ModPackRepository.CreateUploadedArtifactModAsync(_gameIdentifier, string.IsNullOrWhiteSpace(_artifactTitle) ? file.Name : _artifactTitle, EModUsageRole.Shared, installer, file.Name, file.Stream); _selectedModIds.Add(created.PrimaryKey); await SearchCatalogAsync(); } catch (Exception exception) { _submitError = UserFacingError.Message(exception); } finally { _isResolving = false; } }
    private async Task PreviewSourcesAsync() { var inputs = _sourceInput.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct().ToArray(); if (inputs.Length == 0) return; _isResolving = true; _submitError = null; try { var inputMap = inputs.ToDictionary(q => q, StringComparer.Ordinal); var identities = new HashSet<string>(StringComparer.OrdinalIgnoreCase); var previews = await ModPackRepository.PreviewSourcesAsync(_gameIdentifier, inputs); _sourcePreviews.Clear(); foreach (var preview in previews) { var key = SourceKey(preview.Source.ProviderIdentifier, preview.Source.CanonicalSourceIdentifier); if (!inputMap.TryGetValue(preview.SourceInput, out var input) || !identities.Add(key)) { _submitError = Localizer["ModPacks_PreviewCorrelationError"]; continue; } inputMap.Remove(preview.SourceInput); _sourcePreviews.Add(new SourceDraft(input, preview)); } if (inputMap.Count > 0) _submitError = Localizer["ModPacks_PreviewCorrelationError"]; } catch (Exception exception) { _submitError = UserFacingError.Message(exception); } finally { _isResolving = false; } }
    private async Task CreateModPackAsync()
    {
        if (MemberCount == 0) { _submitError = Localizer["ModPacks_RevisionNonEmpty"]; return; } if (!CanCreate) return; _isSubmitting = true; _submitError = null;
        try
        {
            var existingIds = _selectedModIds.Concat(_sourcePreviews.Where(q => q.Preview.ExistingModId.HasValue).Select(q => q.Preview.ExistingModId!.Value)).Distinct();
            var newMods = _sourcePreviews.Where(q => q.Preview.ExistingModId is null).Select(q => new NormalizedModDraftPayload { Title = q.Preview.Source.Title, ProviderIdentifier = q.Preview.Source.ProviderIdentifier, Source = q.Input, VersionSelector = q.VersionSelector, UsageRole = q.UsageRole, InstallerIdentifier = q.InstallerIdentifier }).ToArray();
            var result = await ModPackRepository.CreateNormalizedModPackAsync(new NormalizedModPackPayload { GameIdentifier = _gameIdentifier, Title = _title.Trim(), Revision = new NormalizedModPackRevisionPayload { Mods = existingIds.Select(q => new NormalizedModMembershipPayload(q, null)).ToArray(), NewMods = newMods, Dependencies = _selectedPackIds.Select(q => new NormalizedModPackDependencyPayload(q, null)).ToArray() } });
            NavigationManager.NavigateTo(BaseUrl.ResolveSelfUrl($"command/mod-packs/{result.DefinitionId}"));
        }
        catch (Exception exception) { _submitError = UserFacingError.Message(exception); }
        finally { _isSubmitting = false; }
    }
    private void ToggleMod(Guid id, ChangeEventArgs args) { if (args.Value is true) _selectedModIds.Add(id); else _selectedModIds.Remove(id); }
    private void TogglePack(long? id, ChangeEventArgs args) { if (id is not { } value) return; if (args.Value is true) _selectedPackIds.Add(value); else _selectedPackIds.Remove(value); }
    private void RemovePreview(SourceDraft draft) => _sourcePreviews.Remove(draft);
    private bool IsStepComplete(int step) => step switch { 1 => !string.IsNullOrWhiteSpace(_gameIdentifier) && !string.IsNullOrWhiteSpace(_title), 2 => MemberCount > 0, 3 => CanCreate, _ => false };
    private string GetStepClass(int step) => _step == step ? "active" : IsStepComplete(step) ? "complete" : string.Empty;
    private string GetStepLabel(int step) => Localizer[$"ModPacks_Step{step}"];
    private string GetStepDescription(int step) => Localizer[$"ModPacks_Step{step}Description"];
    private static string SourceKey(string provider, string canonical) => $"{provider}\n{canonical}";
    private async Task ConfirmInternalNavigationAsync(LocationChangingContext context) { if (HasUnsavedChanges && !await JsRuntime.InvokeAsync<bool>("confirm", Localizer["ModPacks_DiscardChanges"].Value)) context.PreventNavigation(); }
    private sealed class SourceDraft
    {
        public SourceDraft(string input, ModSourcePreviewInfo preview) { Input = input; Preview = preview; InstallerIdentifier = preview.InstallerIdentifiers.FirstOrDefault() ?? string.Empty; VersionSelector = preview.Source.VersionSelector; }
        public string Input { get; }
        public ModSourcePreviewInfo Preview { get; }
        public EModUsageRole UsageRole { get; set; } = EModUsageRole.Shared;
        public string InstallerIdentifier { get; set; }
        public string VersionSelector { get; set; }
    }
}
