@page "/command/configuration-profiles"
@attribute [Authorize]
@layout CommandCenterLayout
@using X39.UnitedTacticalForces.WebApp.Services.GameServerRepository
@inject IGameServerRepository Repository
@inject IStringLocalizer<Language> Localizer
@inject IJSRuntime JsRuntime

<PageTitle>@Localizer["Hosting_ConfigurationProfiles_Title"]</PageTitle>

<NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges"
                OnBeforeInternalNavigation="ConfirmInternalNavigationAsync"/>

<div class="configuration-profiles-page">
    <UtfCommandPageHeader Title="@(Localizer["Hosting_ConfigurationProfiles_Title"])"
                          Description="@(Localizer["Hosting_ConfigurationProfiles_Description"])"/>

    @if (_error is not null)
    {
        <UtfAlert Intent="MessageIntent.Error">@_error</UtfAlert>
    }
    @if (_success is not null)
    {
        <UtfAlert Intent="MessageIntent.Success">@_success</UtfAlert>
    }

    @if (_loading)
    {
        <section class="configuration-loading utf-panel" aria-live="polite">
            <span class="configuration-spinner" aria-hidden="true"></span>
            <p>@Localizer["Hosting_ConfigurationProfiles_Loading"]</p>
        </section>
    }
    else
    {
        <div class="configuration-workspace">
            <aside class="configuration-profile-browser utf-panel"
                   aria-label="@(Localizer["Hosting_ConfigurationProfiles_Title"])">
                <div class="configuration-browser-heading">
                    <div>
                        <span class="utf-kicker">@Localizer["Hosting_ConfigurationProfiles_Library"]</span>
                        <h2>@Localizer["Hosting_ConfigurationProfiles_Profiles"]</h2>
                    </div>
                    @if (_catalog.CanCreate)
                    {
                        <button class="utf-button utf-button--primary" type="button" @onclick="StartCreateAsync">
                            @Localizer["Hosting_ConfigurationProfiles_NewProfile"]
                        </button>
                    }
                </div>

                @if (_profiles.Count == 0)
                {
                    <div class="configuration-empty">
                        <strong>@Localizer["Hosting_ConfigurationProfiles_NoProfilesTitle"]</strong>
                        <p>@Localizer["Hosting_ConfigurationProfiles_NoProfilesDescription"]</p>
                    </div>
                }
                else
                {
                    <div class="configuration-profile-list">
                        @foreach (var profile in _profiles)
                        {
                            <button class="@ProfileButtonClass(profile)"
                                    type="button"
                                    @onclick="@(() => SelectWithConfirmationAsync(profile.PrimaryKey))">
                                <span>
                                    <strong>@profile.Title</strong>
                                    <small>@GameLabel(profile.GameIdentifier) · @Localizer["Hosting_ConfigurationProfiles_Revision"] @profile.LatestRevisionNumber</small>
                                </span>
                                <UtfStatusBadge Intent="@(profile.IsArchived ? "warning" : "success")">
                                    @(profile.IsArchived
                                        ? Localizer["Hosting_ConfigurationProfiles_Archived"]
                                        : Localizer["Hosting_ConfigurationProfiles_Active"])
                                </UtfStatusBadge>
                            </button>
                        }
                    </div>
                }
            </aside>

            <main class="configuration-editor">
                @if (_selected is null)
                {
                    <section class="configuration-panel utf-panel">
                        <div class="configuration-panel-heading">
                            <div>
                                <span class="utf-kicker">@Localizer["Hosting_ConfigurationProfiles_NewBaseline"]</span>
                                <h2>@Localizer["Hosting_ConfigurationProfiles_CreateTitle"]</h2>
                                <p>@Localizer["Hosting_ConfigurationProfiles_CreateDescription"]</p>
                            </div>
                        </div>

                        @if (!_catalog.CanCreate)
                        {
                            <div class="configuration-empty">
                                <strong>@Localizer["Hosting_ConfigurationProfiles_ViewOnlyTitle"]</strong>
                                <p>@Localizer["Hosting_ConfigurationProfiles_ViewOnlyDescription"]</p>
                            </div>
                        }
                        else if (_catalog.Games.Count == 0)
                        {
                            <div class="configuration-empty">
                                <strong>@Localizer["Hosting_ConfigurationProfiles_NoGamesTitle"]</strong>
                                <p>@Localizer["Hosting_ConfigurationProfiles_NoGamesDescription"]</p>
                            </div>
                        }
                        else
                        {
                            <div class="configuration-profile-meta">
                                <label class="configuration-field">
                                    <span>@Localizer["Hosting_ConfigurationProfiles_ProfileTitle"]</span>
                                    <input value="@_title"
                                           maxlength="256"
                                           placeholder="@(Localizer["Hosting_ConfigurationProfiles_ProfileTitlePlaceholder"])"
                                           @oninput="@(args => _title = args.Value?.ToString() ?? string.Empty)"/>
                                    <small>@Localizer["Hosting_ConfigurationProfiles_ProfileTitleHint"]</small>
                                </label>
                                <label class="configuration-field">
                                    <span>@Localizer["Hosting_ConfigurationProfiles_Game"]</span>
                                    <select value="@_game" @onchange="ChangeGame">
                                        @foreach (var game in _catalog.Games)
                                        {
                                            <option value="@game.GameIdentifier">@GameLabel(game.GameIdentifier)</option>
                                        }
                                    </select>
                                    <small>@Localizer["Hosting_ConfigurationProfiles_GameHint"]</small>
                                </label>
                            </div>

                            <ConfigurationProfileFields Definitions="@CurrentDefinitions" Values="@_draftValues"/>

                            <div class="configuration-actions">
                                <span>@Localizer["Hosting_ConfigurationProfiles_SettingCount", CurrentDefinitions.Count]</span>
                                <button class="utf-button utf-button--primary"
                                        type="button"
                                        disabled="@(_submitting || string.IsNullOrWhiteSpace(_title))"
                                        @onclick="CreateAsync">
                                    @(_submitting
                                        ? Localizer["Hosting_ConfigurationProfiles_Creating"]
                                        : Localizer["Hosting_ConfigurationProfiles_Create"])
                                </button>
                            </div>
                        }
                    </section>
                }
                else
                {
                    <section class="configuration-panel utf-panel">
                        <div class="configuration-panel-heading configuration-panel-heading--profile">
                            <div>
                                <span class="utf-kicker">@GameLabel(_selected.Profile.GameIdentifier)</span>
                                <h2>@_selected.Profile.Title</h2>
                                <p>
                                    @Localizer["Hosting_ConfigurationProfiles_Revision"] @_selected.Profile.LatestRevisionNumber ·
                                    @(_selected.Profile.IsArchived
                                        ? Localizer["Hosting_ConfigurationProfiles_Archived"]
                                        : Localizer["Hosting_ConfigurationProfiles_Active"])
                                </p>
                            </div>
                            @if (_selected.CanArchive && !_selected.Profile.IsArchived)
                            {
                                @if (_confirmArchive)
                                {
                                    <div class="configuration-archive-confirm">
                                        <span>@Localizer["Hosting_ConfigurationProfiles_ArchiveQuestion"]</span>
                                        <button class="utf-button utf-button--danger" type="button" @onclick="ArchiveAsync">
                                            @Localizer["Common_Confirm"]
                                        </button>
                                        <button class="utf-button utf-button--ghost" type="button" @onclick="@(() => _confirmArchive = false)">
                                            @Localizer["Common_Cancel"]
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <button class="utf-button utf-button--ghost" type="button" @onclick="@(() => _confirmArchive = true)">
                                        @Localizer["Hosting_ConfigurationProfiles_Archive"]
                                    </button>
                                }
                            }
                        </div>

                        @if (_selected.Profile.IsArchived)
                        {
                            <div class="configuration-empty">
                                <strong>@Localizer["Hosting_ConfigurationProfiles_ArchivedTitle"]</strong>
                                <p>@Localizer["Hosting_ConfigurationProfiles_ArchiveDescription"]</p>
                            </div>
                        }
                        else if (_selected.CanModify)
                        {
                            <div class="configuration-section-heading">
                                <div>
                                    <span class="utf-kicker">@Localizer["Hosting_ConfigurationProfiles_Draft"]</span>
                                    <h3>@Localizer["Hosting_ConfigurationProfiles_PublishTitle"]</h3>
                                </div>
                                <p>@Localizer["Hosting_ConfigurationProfiles_PublishDescription"]</p>
                            </div>
                            <ConfigurationProfileFields Definitions="@_selected.Definitions" Values="@_draftValues"/>
                            <div class="configuration-actions">
                                <span>@Localizer["Hosting_ConfigurationProfiles_BasedOnRevision", _selected.Profile.LatestRevisionNumber]</span>
                                <button class="utf-button utf-button--primary"
                                        type="button"
                                        disabled="@_submitting"
                                        @onclick="CreateRevisionAsync">
                                    @(_submitting
                                        ? Localizer["Hosting_ConfigurationProfiles_Publishing"]
                                        : Localizer["Hosting_ConfigurationProfiles_Publish"])
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="configuration-empty">
                                <strong>@Localizer["Hosting_ConfigurationProfiles_ReadOnlyTitle"]</strong>
                                <p>@Localizer["Hosting_ConfigurationProfiles_ReadOnlyDescription"]</p>
                            </div>
                        }

                        <div class="configuration-history">
                            <div class="configuration-section-heading">
                                <div>
                                    <span class="utf-kicker">@Localizer["Hosting_ConfigurationProfiles_AuditTrail"]</span>
                                    <h3>@Localizer["Hosting_ConfigurationProfiles_RevisionHistory"]</h3>
                                </div>
                                <p>@Localizer["Hosting_ConfigurationProfiles_RevisionCount", _selected.Revisions.Count]</p>
                            </div>
                            @foreach (var revision in _selected.Revisions.OrderByDescending(q => q.RevisionNumber))
                            {
                                <details class="configuration-revision" open="@(revision.RevisionNumber == _selected.Profile.LatestRevisionNumber)">
                                    <summary>
                                        <span>
                                            <strong>@Localizer["Hosting_ConfigurationProfiles_Revision"] @revision.RevisionNumber</strong>
                                            <small>@revision.TimeStampCreated.ToLocalTime().ToString("g")</small>
                                        </span>
                                        <span>@Localizer["Hosting_ConfigurationProfiles_ValueCount", revision.Values.Count]</span>
                                    </summary>
                                    <dl>
                                        @foreach (var definition in _selected.Definitions.Where(q => revision.Values.ContainsKey(q.Key)))
                                        {
                                            <div>
                                                <dt>@definition.DisplayName</dt>
                                                <dd>@RevisionValue(revision, definition)</dd>
                                            </div>
                                        }
                                    </dl>
                                    @if (revision.SensitiveConfiguredKeys.Count > 0)
                                    {
                                        <p class="configuration-redacted">@Localizer["Hosting_ConfigurationProfiles_RedactedNotice"]</p>
                                    }
                                </details>
                            }
                        </div>
                    </section>

                    @if (_selected.CanManageAccess)
                    {
                        <section class="configuration-panel configuration-access utf-panel">
                            <div class="configuration-section-heading">
                                <div>
                                    <span class="utf-kicker">@Localizer["Hosting_ConfigurationProfiles_Permissions"]</span>
                                    <h3>@Localizer["Hosting_ConfigurationProfiles_ScopedAccess"]</h3>
                                </div>
                                <p>@Localizer["Hosting_ConfigurationProfiles_AccessDescription"]</p>
                            </div>
                            @if (_accessLoading)
                            {
                                <div class="configuration-empty" aria-live="polite">
                                    <p>@Localizer["Hosting_ConfigurationProfiles_AccessLoading"]</p>
                                </div>
                            }
                            else if (_accessError is not null)
                            {
                                <UtfAlert Intent="MessageIntent.Error">@_accessError</UtfAlert>
                                <button class="utf-button utf-button--ghost"
                                        type="button"
                                        @onclick="@(() => LoadAccessAsync(_selected.Profile.PrimaryKey))">
                                    @Localizer["Hosting_ConfigurationProfiles_Retry"]
                                </button>
                            }
                            else if (_access is not null)
                            {
                                <div class="configuration-access-grid">
                                    <label class="configuration-field">
                                        <span>@Localizer["Hosting_ConfigurationProfiles_UserId"]</span>
                                        <input @bind="_userId"
                                               placeholder="@(Localizer["Hosting_ConfigurationProfiles_UserPlaceholder"])"
                                               autocomplete="off"/>
                                    </label>
                                    <span class="configuration-access-or">@Localizer["Hosting_ConfigurationProfiles_AccessOr"]</span>
                                    <label class="configuration-field">
                                        <span>@Localizer["Hosting_ConfigurationProfiles_RoleId"]</span>
                                        <input @bind="_roleId"
                                               inputmode="numeric"
                                               placeholder="@(Localizer["Hosting_ConfigurationProfiles_RolePlaceholder"])"
                                               autocomplete="off"/>
                                    </label>
                                    <label class="configuration-field configuration-access-permission">
                                        <span>@Localizer["Hosting_ConfigurationProfiles_Permission"]</span>
                                        <select @bind="_permission">
                                            @foreach (var permission in _access.AllowedPermissions)
                                            {
                                                <option value="@permission">@PermissionLabel(permission)</option>
                                            }
                                        </select>
                                    </label>
                                </div>
                                <div class="configuration-actions">
                                    <span>@Localizer["Hosting_ConfigurationProfiles_AccessEitherHint"]</span>
                                    <button class="utf-button utf-button--ghost"
                                            type="button"
                                            disabled="@_accessSubmitting"
                                            @onclick="@(() => ChangeAccessAsync(false))">
                                        @Localizer["Hosting_ConfigurationProfiles_Revoke"]
                                    </button>
                                    <button class="utf-button utf-button--primary"
                                            type="button"
                                            disabled="@_accessSubmitting"
                                            @onclick="@(() => ChangeAccessAsync(true))">
                                        @Localizer["Hosting_ConfigurationProfiles_Grant"]
                                    </button>
                                </div>

                                @if (_access.Users.Count == 0 && _access.Roles.Count == 0)
                                {
                                    <div class="configuration-empty">
                                        <p>@Localizer["Hosting_ConfigurationProfiles_NoDirectAccess"]</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="configuration-access-grants">
                                        @if (_access.Users.Count > 0)
                                        {
                                            <section>
                                                <h4>@Localizer["Hosting_ConfigurationProfiles_DirectUsers"]</h4>
                                                @foreach (var user in _access.Users)
                                                {
                                                    <article>
                                                        <div>
                                                            <strong>@user.Nickname</strong>
                                                            <small>@user.UserId</small>
                                                        </div>
                                                        <ul>
                                                            @foreach (var permission in user.Permissions)
                                                            {
                                                                <li>
                                                                    <span>@PermissionLabel(permission)</span>
                                                                    <button class="utf-button utf-button--ghost"
                                                                            type="button"
                                                                            disabled="@_accessSubmitting"
                                                                            aria-label="@(Localizer["Hosting_ConfigurationProfiles_RevokeNamed", PermissionLabel(permission), user.Nickname])"
                                                                            @onclick="@(() => ChangeUserAccessAsync(user.UserId, permission, false))">
                                                                        @Localizer["Hosting_ConfigurationProfiles_Revoke"]
                                                                    </button>
                                                                </li>
                                                            }
                                                        </ul>
                                                    </article>
                                                }
                                            </section>
                                        }
                                        @if (_access.Roles.Count > 0)
                                        {
                                            <section>
                                                <h4>@Localizer["Hosting_ConfigurationProfiles_DirectRoles"]</h4>
                                                @foreach (var role in _access.Roles)
                                                {
                                                    <article>
                                                        <div>
                                                            <strong>@role.Title</strong>
                                                            <small>@role.Description</small>
                                                        </div>
                                                        <ul>
                                                            @foreach (var permission in role.Permissions)
                                                            {
                                                                <li>
                                                                    <span>@PermissionLabel(permission)</span>
                                                                    <button class="utf-button utf-button--ghost"
                                                                            type="button"
                                                                            disabled="@_accessSubmitting"
                                                                            aria-label="@(Localizer["Hosting_ConfigurationProfiles_RevokeNamed", PermissionLabel(permission), role.Title])"
                                                                            @onclick="@(() => ChangeRoleAccessAsync(role.RoleId, permission, false))">
                                                                        @Localizer["Hosting_ConfigurationProfiles_Revoke"]
                                                                    </button>
                                                                </li>
                                                            }
                                                        </ul>
                                                    </article>
                                                }
                                            </section>
                                        }
                                    </div>
                                }
                            }
                        </section>
                    }
                }
            </main>
        </div>
    }
</div>

@code {
    private IReadOnlyList<ConfigurationProfileInfo> _profiles = [];
    private ConfigurationProfileDefinitionCatalogInfo _catalog = new();
    private ConfigurationProfileDetailsInfo? _selected;
    private ConfigurationProfileAccessInfo? _access;
    private readonly Dictionary<string, string> _draftValues = new(StringComparer.Ordinal);
    private string _title = string.Empty;
    private string _game = string.Empty;
    private string _userId = string.Empty;
    private string _roleId = string.Empty;
    private string _permission = "cfg";
    private string? _error;
    private string? _success;
    private string? _accessError;
    private bool _loading = true;
    private bool _submitting;
    private bool _accessLoading;
    private bool _accessSubmitting;
    private bool _confirmArchive;
    private bool _discardingDraft;

    private IReadOnlyList<GameConfigurationDefinitionInfo> CurrentDefinitions
        => _catalog.Games.FirstOrDefault(q => q.GameIdentifier == _game)?.Definitions ?? [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var profilesTask = Repository.GetConfigurationProfilesAsync();
            var definitionsTask = Repository.GetConfigurationProfileDefinitionsAsync();
            await Task.WhenAll(profilesTask, definitionsTask);
            _profiles = await profilesTask;
            _catalog = await definitionsTask;
            _game = _catalog.Games.FirstOrDefault()?.GameIdentifier ?? string.Empty;
            ResetDraft(CurrentDefinitions);
        }
        catch (Exception exception)
        {
            _error = UserFacingError.Message(
                exception,
                Localizer["Hosting_ConfigurationProfiles_LoadError", string.Empty].Value.TrimEnd(':', ' '));
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task StartCreateAsync()
    {
        if (!await ConfirmDiscardAsync())
            return;
        _discardingDraft = true;
        try
        {
            _selected = null;
            _access = null;
            _accessError = null;
            _title = string.Empty;
            _confirmArchive = false;
            _error = null;
            _success = null;
            if (string.IsNullOrWhiteSpace(_game))
                _game = _catalog.Games.FirstOrDefault()?.GameIdentifier ?? string.Empty;
            ResetDraft(CurrentDefinitions);
        }
        finally
        {
            _discardingDraft = false;
        }
    }

    private void ChangeGame(ChangeEventArgs args)
    {
        _game = args.Value?.ToString() ?? string.Empty;
        ResetDraft(CurrentDefinitions);
    }

    private async Task RefreshAsync() => _profiles = await Repository.GetConfigurationProfilesAsync();

    private async Task SelectWithConfirmationAsync(Guid id)
    {
        if (await ConfirmDiscardAsync())
        {
            _discardingDraft = true;
            try
            {
                await SelectAsync(id);
            }
            finally
            {
                _discardingDraft = false;
            }
        }
    }

    private async Task SelectAsync(Guid id)
    {
        await RunAsync(async () =>
        {
            _selected = await Repository.GetConfigurationProfileAsync(id);
            _confirmArchive = false;
            ResetDraft(_selected.Definitions, _selected.Revisions.FirstOrDefault()?.Values);
            if (_selected.CanManageAccess)
                await LoadAccessAsync(id);
        });
    }

    private async Task CreateAsync()
    {
        await RunSubmittingAsync(async () =>
        {
            var created = await Repository.CreateConfigurationProfileAsync(
                _title.Trim(),
                _game,
                BuildValues(CurrentDefinitions));
            await RefreshAsync();
            await SelectAsync(created.PrimaryKey);
            _success = Localizer["Hosting_ConfigurationProfiles_Created", created.Title].Value;
        });
    }

    private async Task CreateRevisionAsync()
    {
        if (_selected is null)
            return;
        var profileId = _selected.Profile.PrimaryKey;
        await RunSubmittingAsync(async () =>
        {
            await Repository.CreateConfigurationProfileRevisionAsync(
                profileId,
                BuildValues(_selected.Definitions));
            await SelectAsync(profileId);
            _success = Localizer["Hosting_ConfigurationProfiles_Published"].Value;
        });
    }

    private async Task ChangeAccessAsync(bool grant)
    {
        if (_selected is null)
            return;
        if (_access is null || !_access.AllowedPermissions.Contains(_permission, StringComparer.Ordinal))
        {
            _error = Localizer["Hosting_ConfigurationProfiles_AccessPermissionInvalid"].Value;
            return;
        }
        if (Guid.TryParse(_userId, out var userId) && string.IsNullOrWhiteSpace(_roleId))
            await ChangeUserAccessAsync(userId, _permission, grant);
        else if (long.TryParse(_roleId, out var roleId)
                 && roleId > 0
                 && string.IsNullOrWhiteSpace(_userId))
            await ChangeRoleAccessAsync(roleId, _permission, grant);
        else
            _error = Localizer["Hosting_ConfigurationProfiles_AccessInvalidSubject"].Value;
    }

    private Task ChangeUserAccessAsync(Guid userId, string permission, bool grant)
        => RunAccessChangeAsync(
            () => Repository.ChangeConfigurationProfileUserAccessAsync(
                _selected!.Profile.PrimaryKey, userId, permission, grant),
            grant);

    private Task ChangeRoleAccessAsync(long roleId, string permission, bool grant)
        => RunAccessChangeAsync(
            () => Repository.ChangeConfigurationProfileRoleAccessAsync(
                _selected!.Profile.PrimaryKey, roleId, permission, grant),
            grant);

    private async Task RunAccessChangeAsync(Func<Task> action, bool grant)
    {
        if (_selected is null || _accessSubmitting)
            return;
        _accessSubmitting = true;
        try
        {
            await RunAsync(async () =>
            {
                await action();
                await LoadAccessAsync(_selected.Profile.PrimaryKey);
                _userId = string.Empty;
                _roleId = string.Empty;
                _success = grant
                    ? Localizer["Hosting_ConfigurationProfiles_AccessGranted"].Value
                    : Localizer["Hosting_ConfigurationProfiles_AccessRevoked"].Value;
            });
        }
        finally
        {
            _accessSubmitting = false;
        }
    }

    private async Task LoadAccessAsync(Guid profileId)
    {
        _accessLoading = true;
        _accessError = null;
        try
        {
            _access = await Repository.GetConfigurationProfileAccessAsync(profileId);
            if (!_access.AllowedPermissions.Contains(_permission, StringComparer.Ordinal))
                _permission = _access.AllowedPermissions.FirstOrDefault() ?? string.Empty;
        }
        catch (Exception exception)
        {
            _access = null;
            _accessError = UserFacingError.Message(
                exception,
                Localizer["Hosting_ConfigurationProfiles_AccessLoadError"]);
        }
        finally
        {
            _accessLoading = false;
        }
    }

    private async Task ArchiveAsync()
    {
        if (_selected is null)
            return;
        var profileId = _selected.Profile.PrimaryKey;
        await RunAsync(async () =>
        {
            await Repository.ArchiveConfigurationProfileAsync(profileId);
            await RefreshAsync();
            await SelectAsync(profileId);
            _success = Localizer["Hosting_ConfigurationProfiles_ArchivedSuccess"].Value;
        });
    }

    private void ResetDraft(
        IReadOnlyList<GameConfigurationDefinitionInfo> definitions,
        IReadOnlyDictionary<string, System.Text.Json.JsonElement?>? values = null)
    {
        _draftValues.Clear();
        foreach (var definition in definitions)
        {
            if (definition.DefaultValue is { } defaultValue)
                _draftValues[definition.Key] = defaultValue.GetRawText();
        }
        if (values is null)
            return;
        foreach (var (key, value) in values)
        {
            if (value is { } actualValue)
                _draftValues[key] = actualValue.GetRawText();
        }
    }

    private IReadOnlyList<ConfigurationValueUpdateInfo> BuildValues(
        IReadOnlyList<GameConfigurationDefinitionInfo> definitions)
    {
        var missing = definitions
            .Where(q => q.Required && !_draftValues.ContainsKey(q.Key))
            .Select(q => q.DisplayName)
            .ToArray();
        if (missing.Length > 0)
            throw new InvalidOperationException($"Complete the required settings: {string.Join(", ", missing)}.");

        return _draftValues.Select(q =>
        {
            using var document = System.Text.Json.JsonDocument.Parse(q.Value);
            return new ConfigurationValueUpdateInfo(q.Key, document.RootElement.Clone());
        }).ToArray();
    }

    private string RevisionValue(
        ConfigurationProfileRevisionInfo revision,
        GameConfigurationDefinitionInfo definition)
    {
        if (revision.SensitiveConfiguredKeys.Contains(definition.Key, StringComparer.Ordinal))
            return Localizer["Hosting_ConfigurationProfiles_StoredSecurely"];
        if (!revision.Values.TryGetValue(definition.Key, out var value) || value is null)
            return Localizer["Hosting_ConfigurationProfiles_NotSet"];
        if (definition.Sensitive)
            return "••••••••";
        if (value.Value.ValueKind == System.Text.Json.JsonValueKind.Array)
            return string.Join(", ", value.Value.EnumerateArray().Select(q => q.GetString()));
        return value.Value.ValueKind == System.Text.Json.JsonValueKind.String
            ? value.Value.GetString() ?? string.Empty
            : value.Value.GetRawText();
    }

    private string PermissionLabel(string permission)
        => permission switch
        {
            "cfg"               => Localizer["Hosting_ConfigurationProfiles_PermissionFullControl"],
            "cfg:view"          => Localizer["Hosting_ConfigurationProfiles_PermissionView"],
            "cfg:modify"        => Localizer["Hosting_ConfigurationProfiles_PermissionModify"],
            "cfg:manage-access" => Localizer["Hosting_ConfigurationProfiles_PermissionManageAccess"],
            "cfg:archive"       => Localizer["Hosting_ConfigurationProfiles_PermissionArchive"],
            _                   => permission,
        };

    private string ProfileButtonClass(ConfigurationProfileInfo profile)
        => _selected?.Profile.PrimaryKey == profile.PrimaryKey
            ? "configuration-profile-card configuration-profile-card--selected"
            : "configuration-profile-card";

    private static string GameLabel(string identifier)
        => identifier.Equals("arma3", StringComparison.OrdinalIgnoreCase) ? "Arma 3" : identifier;

    private async Task RunSubmittingAsync(Func<Task> action)
    {
        _submitting = true;
        try
        {
            await RunAsync(action);
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task RunAsync(Func<Task> action)
    {
        _error = null;
        _success = null;
        try
        {
            await action();
        }
        catch (Exception exception)
        {
            _error = UserFacingError.Message(
                exception,
                Localizer["Hosting_ConfigurationProfiles_OperationFailed", string.Empty].Value.TrimEnd(':', ' '));
        }
    }

    private bool HasUnsavedChanges
    {
        get
        {
            if (_submitting || _discardingDraft)
                return false;
            if (_selected is null)
                return !string.IsNullOrWhiteSpace(_title)
                       || !DraftMatches(CurrentDefinitions, null);
            return _selected.CanModify
                   && !DraftMatches(_selected.Definitions, _selected.Revisions.FirstOrDefault()?.Values);
        }
    }

    private bool DraftMatches(
        IReadOnlyList<GameConfigurationDefinitionInfo> definitions,
        IReadOnlyDictionary<string, System.Text.Json.JsonElement?>? values)
    {
        var baseline = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var definition in definitions)
        {
            if (definition.DefaultValue is { } defaultValue)
                baseline[definition.Key] = defaultValue.GetRawText();
        }
        if (values is not null)
        {
            foreach (var (key, value) in values)
            {
                if (value is { } actualValue)
                    baseline[key] = actualValue.GetRawText();
            }
        }
        return baseline.Count == _draftValues.Count
               && baseline.All(q => _draftValues.TryGetValue(q.Key, out var value) && value == q.Value);
    }

    private async Task<bool> ConfirmDiscardAsync()
        => !HasUnsavedChanges
           || await JsRuntime.InvokeAsync<bool>("confirm", Localizer["React_UnsavedChanges"].Value)
               .ConfigureAwait(false);

    private async Task ConfirmInternalNavigationAsync(LocationChangingContext context)
    {
        if (!await ConfirmDiscardAsync())
            context.PreventNavigation();
    }
}
