@page "/command/servers/create"
@attribute [Authorize]
@layout CommandCenterLayout
@using System.Globalization
@using X39.UnitedTacticalForces.WebApp.Services.GameServerRepository
@inject IGameServerRepository GameServerRepository
@inject NavigationManager NavigationManager
@inject BaseUrl BaseUrl
@inject MeService Me
@inject IStringLocalizer<Language> Localizer

<PageTitle>@Localizer["Hosting_Create_Title"]</PageTitle>

<div class="hosting-page hosting-create-page">
    <UtfCommandPageHeader Title="@(Localizer["Hosting_Create_Title"])"
                          Description="@(Localizer["Hosting_Create_Description"])"/>

    <a class="hosting-back-link" href="@BaseUrl.ResolveSelfUrl("command/servers")">
        &larr; @Localizer["Hosting_Common_BackToServers"]
    </a>

    @if (!CanCreate)
    {
        <section class="utf-empty-state">
            <h2>@Localizer["Hosting_Create_ForbiddenTitle"]</h2>
            <p>@Localizer["Hosting_Create_ForbiddenDescription"]</p>
        </section>
    }
    else if (_isLoading)
    {
        <div class="utf-state-panel">
            @Localizer["Hosting_Create_LoadingCapabilities"]
            <FluentProgress Width="240px"/>
        </div>
    }
    else if (_loadError is not null)
    {
        <section class="utf-empty-state">
            <h2>@Localizer["Hosting_ProfileCatalog_UnavailableTitle"]</h2>
            <p>@_loadError</p>
            <button class="utf-button utf-button--ghost" type="button" @onclick="LoadCapabilitiesAsync">
                @Localizer["Hosting_ProfileCatalog_Retry"]
            </button>
        </section>
    }
    else if (_capabilities.Count is 0)
    {
        <section class="utf-empty-state">
            <h2>@Localizer["Hosting_Create_NoCapabilitiesTitle"]</h2>
            <p>@Localizer["Hosting_Create_NoCapabilitiesDescription"]</p>
        </section>
    }
    else
    {
        <div class="hosting-create-grid">
            <form class="utf-panel hosting-create-form"
                  @onsubmit="CreateServerAsync"
                  @onsubmit:preventDefault="true">
                <div class="hosting-section-heading">
                    <span class="utf-kicker">@Localizer["Hosting_Create_RecordKicker"]</span>
                    <h2>@Localizer["Hosting_Create_RecordTitle"]</h2>
                    <p>@Localizer["Hosting_Create_RecordDescription"]</p>
                </div>

                <label class="hosting-field">
                    <span>@Localizer["Hosting_Create_Name"]</span>
                    <input maxlength="256"
                           required
                           autocomplete="off"
                           @bind="_title"
                           @bind:event="oninput"/>
                </label>

                @if (SelectedCapability?.RequiresTerrain == true)
                {
                    <label class="hosting-field">
                        <span>@SelectedCapability.TerrainLabel</span>
                        <select @bind="_terrainId" required>
                            @foreach (var terrain in _terrainOptions)
                            {
                                <option value="@terrain.PrimaryKey">@terrain.Title</option>
                            }
                        </select>
                        <small>The latest compatible version is resolved when the server starts.</small>
                    </label>
                }

                @if (SelectedCapability?.RequiresScenario == true)
                {
                    <label class="hosting-field">
                        <span>@SelectedCapability.ScenarioLabel</span>
                        <select @bind="_scenarioId" required>
                            @foreach (var scenario in _scenarioOptions)
                            {
                                <option value="@scenario.PrimaryKey">@scenario.Title</option>
                            }
                        </select>
                        <small>The latest compatible version is resolved when the server starts.</small>
                    </label>
                }

                <label class="hosting-field">
                    <span>@Localizer["Hosting_Create_Game"]</span>
                    <select value="@_gameIdentifier" @onchange="ChangeGameAsync">
                        @foreach (var capability in _capabilities)
                        {
                            <option value="@capability.GameIdentifier">@capability.DisplayName</option>
                        }
                    </select>
                </label>

                <label class="hosting-field">
                    <span>@Localizer["Hosting_Create_ModPack"]</span>
                    <select value="@(_modPackDefinitionId?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)"
                            @onchange="ChangeModPackAsync">
                        <option value="">@Localizer["Hosting_Create_ModPackNone"]</option>
                        @foreach (var modPack in _modPackOptions)
                        {
                            <option value="@modPack.PrimaryKey">@modPack.Title</option>
                        }
                    </select>
                    <small>@Localizer["Hosting_Create_ModPackHint"]</small>
                </label>

                <label class="hosting-field">
                    <span>@Localizer["Hosting_Create_ConfigurationProfile"]</span>
                    <select @bind="_configurationProfileId">
                        <option value="">@Localizer["Hosting_Create_ConfigurationProfileDefault"]</option>
                        @foreach (var profile in _configurationProfileOptions)
                        {
                            <option value="@profile.PrimaryKey">
                                @Localizer["Hosting_Create_ConfigurationProfileOption", profile.Title, profile.LatestRevisionNumber]
                            </option>
                        }
                    </select>
                    <small>@Localizer["Hosting_Create_ConfigurationProfileHint"]</small>
                </label>

                <label class="hosting-field">
                    <span>@Localizer["Hosting_Common_CostOwner"]</span>
                    <select @bind="_costOwnerId">
                        <option value="" disabled="@(CurrentUserCostOwner?.IsFrozen == true)">
                            @(CurrentUserCostOwner is { } currentUserOwner
                                ? Localizer["Hosting_Create_CostOwnerSelfExisting", currentUserOwner.DisplayName]
                                : Localizer["Hosting_Create_CostOwnerSelf"])
                        </option>
                        @foreach (var owner in _costOwnerOptions.Where(q => !q.IsCurrentUser))
                        {
                            <option value="@owner.CostOwnerId" disabled="@owner.IsFrozen">
                                @owner.DisplayName@(owner.IsFrozen ? $" — {Localizer["Hosting_Create_CostOwnerFrozen"]}" : string.Empty)
                            </option>
                        }
                    </select>
                    <small>@Localizer["Hosting_Create_CostOwnerHint"]</small>
                </label>
                @if (!SelectedCostOwnerIsValid)
                {
                    <UtfAlert Intent="MessageIntent.Error">
                        @Localizer["Hosting_Create_CostOwnerFrozenError"]
                    </UtfAlert>
                }

                <label class="hosting-field">
                    <span>@Localizer["Hosting_Create_Runtime"]</span>
                    @if (AvailableProviders.Count > 0)
                    {
                        <select value="@_runtimeProviderIdentifier" @onchange="ChangeRuntimeProvider">
                        @foreach (var provider in AvailableProviders)
                        {
                            <option value="@provider.Identifier">@provider.Identifier</option>
                        }
                        </select>
                    }
                    else
                    {
                        <div class="hosting-provider-empty">@Localizer["Hosting_ProfileCatalog_NoSelectableProvider"]</div>
                    }
                    <small>@Localizer["Hosting_Create_RuntimeHint"]</small>
                </label>

                @if (SelectedProvider is { } selectedProvider && selectedProvider.Profiles.Count > 0)
                {
                    <label class="hosting-field">
                        <span>@Localizer["Hosting_Create_Profile"]</span>
                        <select value="@_runtimeProfileIdentifier" @onchange="ChangeRuntimeProfileAsync">
                            @foreach (var profile in selectedProvider.Profiles)
                            {
                                <option value="@profile.Identifier">@ProfileOption(profile)</option>
                            }
                        </select>
                        <small>@Localizer["Hosting_ProfileCatalog_SelectHint"]</small>
                    </label>
                    @if (SelectedProfile is { } selectedProfile)
                    {
                        <RuntimeProfileSummary Profile="selectedProfile"/>
                    }
                }

                @if (SelectedProfile is not null)
                {
                    <section class="hosting-storage-configuration" aria-labelledby="create-storage-title">
                        <div class="hosting-section-heading">
                            <span class="utf-kicker">@Localizer["Hosting_Create_StorageKicker"]</span>
                            <h3 id="create-storage-title">@Localizer["Hosting_Create_StorageTitle", SelectedProfile.DisplayName]</h3>
                            <p>@Localizer["Hosting_Create_StorageDescription"]</p>
                        </div>
                        <label class="hosting-field">
                            <span>@Localizer["Hosting_Create_StorageStrategy"]</span>
                            <select value="@_runtimeStorageStrategy" @onchange="ChangeStorageStrategy">
                                <option value="IncludedDisk">@Localizer["Hosting_Create_StorageIncluded"]</option>
                                @if (SelectedProvider?.Storage?.SupportsExternalBlockStorage is true)
                                {
                                    <option value="AutomaticExternal">@Localizer["Hosting_Create_StorageAutomatic"]</option>
                                    <option value="FixedExternal">@Localizer["Hosting_Create_StorageFixed"]</option>
                                }
                            </select>
                        </label>
                        @if (_runtimeStorageStrategy == "FixedExternal" && SelectedProvider?.Storage is { } storage)
                        {
                            <label class="hosting-field">
                                <span>@Localizer["Hosting_Create_ExternalCapacity"]</span>
                                <input type="number"
                                       min="@storage.MinimumCapacityGiB"
                                       max="@storage.MaximumCapacityGiB"
                                       step="@storage.CapacityIncrementGiB"
                                       @bind="_externalStorageSizeGiB"/>
                            </label>
                        }
                        <dl class="hosting-storage-selection-facts">
                            <div><dt>@Localizer["Hosting_Create_IncludedProfileDisk"]</dt><dd>@(SelectedProfile.DiskGiB?.ToString(CultureInfo.CurrentCulture) ?? "—") GiB</dd></div>
                            <div><dt>@Localizer["Hosting_Create_EstimatedPeakRequirement"]</dt><dd>@(_storageDemand is { } demand ? FormatBytes(demand.PeakPreparationRequiredBytes) : Localizer["Hosting_Create_Calculating"])</dd></div>
                            <div><dt>@Localizer[_runtimeStorageStrategy == "IncludedDisk" ? "Hosting_Create_SelectedDeploymentCapacity" : "Hosting_Storage_SelectedRawCapacity"]</dt><dd>@FormatBytes(SelectedStorageBytes())</dd></div>
                            <div><dt>@Localizer["Hosting_Create_CombinedPrice"]</dt><dd>@FormatCombinedPrice()</dd></div>
                        </dl>
                        <p class="hosting-storage-filesystem">@StorageFilesystemDescription()</p>
                        @if (_runtimeStorageStrategy != "IncludedDisk")
                        {
                            <UtfAlert Intent="MessageIntent.Warning">
                                @Localizer["Hosting_Create_ExternalStorageWarning"]
                            </UtfAlert>
                        }
                    </section>
                }

                @if (_isEstimateLoading)
                {
                    <div class="utf-state-panel" role="status">@Localizer["Hosting_Create_EstimateLoading"]</div>
                }
                else if (_estimateError is not null)
                {
                    <UtfAlert Intent="MessageIntent.Warning">@Localizer["Hosting_Create_EstimateUnavailable", _estimateError]</UtfAlert>
                }
                else if (_storageDemand is { } storageDemand)
                {
                    <StorageDemandSummary Demand="storageDemand"
                                          SelectedProfileIdentifier="_runtimeProfileIdentifier"/>
                }

                @if (UnavailableProviders.Count > 0)
                {
                    <div class="hosting-provider-statuses" aria-label="@Localizer["Hosting_Create_ProviderAvailability"]">
                        @foreach (var provider in UnavailableProviders)
                        {
                            <article>
                                <strong>@provider.Identifier</strong>
                                <span>@ProviderUnavailableDescription(provider)</span>
                            </article>
                        }
                    </div>
                }

                <label class="hosting-check-field">
                    <input type="checkbox" @bind="_isLaunchDisabled"/>
                    <span>
                        <strong>@Localizer["Hosting_Create_LaunchDisabled"]</strong>
                        <small>@Localizer["Hosting_Create_LaunchDisabledHint"]</small>
                    </span>
                </label>

                @if (_saveError is not null)
                {
                    <UtfAlert Intent="MessageIntent.Error">@_saveError</UtfAlert>
                }

                <div class="hosting-form-actions">
                    <a class="utf-button utf-button--ghost" href="@BaseUrl.ResolveSelfUrl("command/servers")">
                        @Localizer["Hosting_Common_Cancel"]
                    </a>
                    <button class="utf-button utf-button--primary"
                            type="submit"
                            disabled="@(_isSaving || !CanSubmit)">
                        @(_isSaving ? Localizer["Hosting_Create_Saving"] : Localizer["Hosting_Create_Submit"])
                    </button>
                </div>
            </form>

            <aside class="hosting-create-aside">
                <section class="utf-panel hosting-capability-card">
                    <span class="utf-kicker">@Localizer["Hosting_Create_CapabilityKicker"]</span>
                    <h2>@SelectedCapability?.DisplayName</h2>
                    <p>@SelectedCapability?.Description</p>

                    @if (SelectedCapability?.Actions.Count > 0)
                    {
                        <div class="hosting-capability-actions">
                            @foreach (var action in SelectedCapability.Actions.OrderBy((action) => action.Order))
                            {
                                <span title="@action.Description">@action.Label</span>
                            }
                        </div>
                    }
                </section>

                <section class="hosting-create-boundary">
                    <strong>@Localizer["Hosting_Create_SeparateTitle"]</strong>
                    <p>@Localizer["Hosting_Create_SeparateDescription"]</p>
                    <ol>
                        <li>@Localizer["Hosting_Create_SeparateStepCreate"]</li>
                        <li>@Localizer["Hosting_Create_SeparateStepReview"]</li>
                        <li>@Localizer["Hosting_Create_SeparateStepStart"]</li>
                    </ol>
                </section>
            </aside>
        </div>
    }
</div>

@code {
    private IReadOnlyList<GameServerCapabilityInfo> _capabilities = [];
    private string _title = string.Empty;
    private string _gameIdentifier = string.Empty;
    private string _runtimeProviderIdentifier = string.Empty;
    private string _runtimeProfileIdentifier = string.Empty;
    private string _runtimeStorageStrategy = "IncludedDisk";
    private long? _externalStorageSizeGiB;
    private IReadOnlyList<GameServerModPackOptionInfo> _modPackOptions = [];
    private long? _modPackDefinitionId;
    private IReadOnlyList<GameContentOptionInfo> _terrainOptions = [];
    private long? _terrainId;
    private IReadOnlyList<GameContentOptionInfo> _scenarioOptions = [];
    private Guid? _scenarioId;
    private IReadOnlyList<ConfigurationProfileOptionInfo> _configurationProfileOptions = [];
    private Guid? _configurationProfileId;
    private IReadOnlyList<GameServerCostOwnerOptionInfo> _costOwnerOptions = [];
    private Guid? _costOwnerId;
    private StorageDemandInfo? _storageDemand;
    private bool _isEstimateLoading;
    private string? _estimateError;
    private bool _isLaunchDisabled;
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _loadError;
    private string? _saveError;

    private bool CanCreate
        => Me.CanCreateGameServers();

    private GameServerCapabilityInfo? SelectedCapability
        => _capabilities.FirstOrDefault(capability => string.Equals(
            capability.GameIdentifier,
            _gameIdentifier,
            StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<RuntimeProviderInfo> AvailableProviders
        => SelectedCapability?.RuntimeProviderProfiles
               .Where(IsProviderAvailable)
               .OrderBy(provider => provider.Identifier, StringComparer.OrdinalIgnoreCase)
               .ToArray()
           ?? [];

    private IReadOnlyList<RuntimeProviderInfo> UnavailableProviders
        => SelectedCapability?.RuntimeProviderProfiles
               .Where(provider => !IsProviderAvailable(provider))
               .OrderBy(provider => provider.Identifier, StringComparer.OrdinalIgnoreCase)
               .ToArray()
           ?? [];

    private RuntimeProviderInfo? SelectedProvider
        => SelectedCapability?.RuntimeProviderProfiles.FirstOrDefault(provider =>
            string.Equals(
                provider.Identifier,
                _runtimeProviderIdentifier,
                StringComparison.OrdinalIgnoreCase));

    private RuntimeProfileInfo? SelectedProfile
        => SelectedProvider?.Profiles.FirstOrDefault(profile => string.Equals(
            profile.Identifier,
            _runtimeProfileIdentifier,
            StringComparison.OrdinalIgnoreCase));

    private bool CanSubmit
        => !string.IsNullOrWhiteSpace(_title)
           && SelectedCapability is not null
           && SelectedProvider is not null
           && IsProviderAvailable(SelectedProvider)
           && SelectedProfile is not null
           && (SelectedCapability.RequiresTerrain == false || _terrainId is not null)
           && (SelectedCapability.RequiresScenario == false || _scenarioId is not null)
           && SelectedCostOwnerIsValid
           && IsStorageSelectionValid();

    private GameServerCostOwnerOptionInfo? CurrentUserCostOwner
        => _costOwnerOptions.FirstOrDefault(q => q.IsCurrentUser);

    private bool SelectedCostOwnerIsValid
        => _costOwnerId is { } ownerId
            ? _costOwnerOptions.Any(q => q.CostOwnerId == ownerId && !q.IsFrozen)
            : CurrentUserCostOwner?.IsFrozen != true;

    protected override async Task OnInitializedAsync()
    {
        if (!CanCreate)
        {
            _isLoading = false;
            return;
        }

        await LoadCapabilitiesAsync();
    }

    private async Task LoadCapabilitiesAsync()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            _capabilities = await GameServerRepository.GetCapabilitiesAsync();
            _costOwnerOptions = await GameServerRepository.GetCreationCostOwnerOptionsAsync();
            if (_capabilities.FirstOrDefault() is { } capability)
            {
                _gameIdentifier = capability.GameIdentifier;
                SelectFirstAvailableProvider();
                await RefreshSelectionsAndEstimateAsync();
            }
        }
        catch (Exception exception)
        {
            _loadError = UserFacingError.Message(exception, Localizer["Hosting_Create_LoadError"].Value);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ChangeGameAsync(ChangeEventArgs args)
    {
        _gameIdentifier = args.Value?.ToString() ?? string.Empty;
        _modPackDefinitionId = null;
        _terrainId = null;
        _scenarioId = null;
        _configurationProfileId = null;
        SelectFirstAvailableProvider();
        await RefreshSelectionsAndEstimateAsync();
    }

    private async Task ChangeRuntimeProvider(ChangeEventArgs args)
    {
        _runtimeProviderIdentifier = args.Value?.ToString() ?? string.Empty;
        _runtimeProfileIdentifier = SelectedProvider?.Profiles.FirstOrDefault()?.Identifier ?? string.Empty;
        SelectDefaultStorage();
        await RefreshEstimateAsync();
    }

    private async Task ChangeRuntimeProfileAsync(ChangeEventArgs args)
    {
        _runtimeProfileIdentifier = args.Value?.ToString() ?? string.Empty;
        await RefreshEstimateAsync();
    }

    private void ChangeStorageStrategy(ChangeEventArgs args)
    {
        _runtimeStorageStrategy = args.Value?.ToString() ?? "IncludedDisk";
        if (_runtimeStorageStrategy == "FixedExternal" && SelectedProvider?.Storage is { } storage)
            _externalStorageSizeGiB ??= storage.MinimumCapacityGiB;
        else if (_runtimeStorageStrategy != "FixedExternal")
            _externalStorageSizeGiB = null;
    }

    private async Task ChangeModPackAsync(ChangeEventArgs args)
    {
        _modPackDefinitionId = long.TryParse(
            args.Value?.ToString(),
            NumberStyles.None,
            CultureInfo.InvariantCulture,
            out var value)
            ? value
            : null;
        await RefreshEstimateAsync();
    }

    private void SelectFirstAvailableProvider()
    {
        _runtimeProviderIdentifier = AvailableProviders.FirstOrDefault()?.Identifier ?? string.Empty;
        _runtimeProfileIdentifier = SelectedProvider?.Profiles.FirstOrDefault()?.Identifier ?? string.Empty;
        SelectDefaultStorage();
    }

    private async Task RefreshSelectionsAndEstimateAsync()
    {
        _modPackOptions = await GameServerRepository.GetCreationModPackOptionsAsync(_gameIdentifier);
        _terrainOptions = await GameServerRepository.GetTerrainOptionsAsync(_gameIdentifier);
        _terrainId = long.TryParse(_terrainOptions.FirstOrDefault()?.PrimaryKey, out var terrainId) ? terrainId : null;
        _scenarioOptions = await GameServerRepository.GetScenarioOptionsAsync(_gameIdentifier);
        _scenarioId = Guid.TryParse(_scenarioOptions.FirstOrDefault()?.PrimaryKey, out var scenarioId) ? scenarioId : null;
        _configurationProfileOptions = await GameServerRepository
            .GetConfigurationProfileOptionsAsync(_gameIdentifier);
        await RefreshEstimateAsync();
    }

    private async Task RefreshEstimateAsync()
    {
        if (string.IsNullOrWhiteSpace(_gameIdentifier) || string.IsNullOrWhiteSpace(_runtimeProviderIdentifier))
            return;

        _isEstimateLoading = true;
        _estimateError = null;
        try
        {
            _storageDemand = await GameServerRepository.EstimateStorageDemandAsync(new StorageDemandEstimateRequestInfo
            {
                GameIdentifier = _gameIdentifier,
                ModPackDefinitionId = _modPackDefinitionId,
                RuntimeProviderIdentifier = _runtimeProviderIdentifier,
            });
        }
        catch (Exception exception)
        {
            _storageDemand = null;
            _estimateError = UserFacingError.Message(
                exception,
                Localizer["Hosting_Create_EstimateFallback"].Value);
        }
        finally
        {
            _isEstimateLoading = false;
        }
    }

    private async Task CreateServerAsync()
    {
        if (!CanSubmit || _isSaving)
            return;

        _isSaving = true;
        _saveError = null;
        try
        {
            var server = await GameServerRepository.CreateServerAsync(new GameServerCreationInfo
            {
                Title = _title.Trim(),
                GameIdentifier = _gameIdentifier,
                RuntimeProviderIdentifier = _runtimeProviderIdentifier,
                RuntimeProfileIdentifier = _runtimeProfileIdentifier,
                RuntimeStorageStrategy = _runtimeStorageStrategy,
                ExternalStorageSizeGiB = _runtimeStorageStrategy == "FixedExternal"
                    ? _externalStorageSizeGiB
                    : null,
                ModPackDefinitionId = _modPackDefinitionId,
                TerrainId = _terrainId,
                ScenarioId = _scenarioId,
                ConfigurationProfileId = _configurationProfileId,
                CostOwnerId = _costOwnerId,
                IsLaunchDisabled = _isLaunchDisabled,
            });
            NavigationManager.NavigateTo(BaseUrl.ResolveSelfUrl($"command/servers/{server.PrimaryKey}"));
        }
        catch (Exception exception)
        {
            _saveError = UserFacingError.Message(exception, Localizer["Hosting_Create_SaveError"].Value);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private string ProfileOption(RuntimeProfileInfo profile)
        => profile.EstimatedHourlyCostEur is { } hourly
            ? Localizer[
                "Hosting_Detail_ProfileOption",
                profile.DisplayName,
                profile.VirtualCpuCount?.ToString(CultureInfo.CurrentCulture) ?? "—",
                profile.MemoryGiB?.ToString("0.#", CultureInfo.CurrentCulture) ?? "—",
                profile.DiskGiB?.ToString(CultureInfo.CurrentCulture) ?? "—",
                hourly].Value
            : Localizer[
                "Hosting_Detail_ProfileOptionNoPrice",
                profile.DisplayName,
                profile.VirtualCpuCount?.ToString(CultureInfo.CurrentCulture) ?? "—",
                profile.MemoryGiB?.ToString("0.#", CultureInfo.CurrentCulture) ?? "—",
                profile.DiskGiB?.ToString(CultureInfo.CurrentCulture) ?? "—"].Value;

    private static bool IsProviderAvailable(RuntimeProviderInfo provider)
        => string.Equals(provider.AvailabilityStatus, "available", StringComparison.OrdinalIgnoreCase)
           && provider.Profiles.Count > 0;

    private void SelectDefaultStorage()
    {
        _runtimeStorageStrategy = SelectedProvider?.Storage?.SupportsExternalBlockStorage is true
            ? "AutomaticExternal"
            : "IncludedDisk";
        _externalStorageSizeGiB = null;
    }

    private bool IsStorageSelectionValid()
    {
        if (SelectedProfile is null || _storageDemand is null)
            return false;
        if (_runtimeStorageStrategy == "IncludedDisk")
        {
            return _storageDemand.RuntimeProfiles.FirstOrDefault(q => string.Equals(
                q.RuntimeProfileIdentifier,
                SelectedProfile.Identifier,
                StringComparison.OrdinalIgnoreCase))?.IsSufficient == true;
        }
        if (SelectedProvider?.Storage is not { SupportsExternalBlockStorage: true } storage)
            return false;
        var selectedGiB = _runtimeStorageStrategy == "AutomaticExternal"
            ? AutomaticStorageGiB(storage)
            : _externalStorageSizeGiB;
        return selectedGiB is { } value
               && value >= storage.MinimumCapacityGiB
               && value <= storage.MaximumCapacityGiB
               && storage.CapacityIncrementGiB > 0
               && value % storage.CapacityIncrementGiB == 0
               && _storageDemand.MinimumExternalCapacityGiB is { } minimum
               && value >= minimum;
    }

    private long? SelectedStorageBytes()
    {
        if (_runtimeStorageStrategy == "IncludedDisk")
            return SelectedProfile?.UsableStorageBytes;
        if (SelectedProvider?.Storage is not { } storage)
            return null;
        var gib = _runtimeStorageStrategy == "AutomaticExternal"
            ? AutomaticStorageGiB(storage)
            : _externalStorageSizeGiB;
        return gib.HasValue ? checked(gib.Value * 1_073_741_824L) : null;
    }

    private long? AutomaticStorageGiB(RuntimeStorageCapabilitiesInfo storage)
    {
        return _storageDemand?.MinimumExternalCapacityGiB;
    }

    private string StorageFilesystemDescription()
        => _runtimeStorageStrategy == "IncludedDisk"
            ? Localizer["Hosting_Create_FilesystemIncluded"].Value
            : Localizer[
                "Hosting_Create_FilesystemExternal",
                SelectedProvider?.Storage?.DeploymentMountPath ?? "—"].Value;

    private string FormatCombinedPrice()
    {
        if (SelectedProfile?.EstimatedHourlyCostEur is not { } compute)
            return Localizer["Hosting_Create_PriceUnavailable"].Value;
        var storage = _runtimeStorageStrategy == "IncludedDisk"
            ? 0m
            : (SelectedStorageBytes() ?? 0) / 1_073_741_824m
              * (SelectedProvider?.Storage?.EstimatedHourlyCostPerGiBEur ?? 0m);
        return Localizer[
            "Hosting_Create_CombinedPriceValue",
            (compute + storage).ToString("C6", CultureInfo.CurrentCulture),
            ((compute + storage) * 730m).ToString("C2", CultureInfo.CurrentCulture)].Value;
    }

    private string FormatBytes(long? bytes)
        => bytes.HasValue
            ? $"{bytes.Value / 1_073_741_824m:0.##} GiB"
            : Localizer["Hosting_Create_StorageStatusUnavailable"].Value;

    private string ProviderUnavailableDescription(RuntimeProviderInfo provider)
        => provider.AvailabilityStatus.Trim().ToLowerInvariant() switch
        {
            "paused" => Localizer["Hosting_ServerMessage_ExecutionPaused"].Value,
            "configuration-required" => Localizer[
                "Hosting_ProfileCatalog_ConfigurationRequiredDescription",
                provider.Identifier].Value,
            "catalog-unavailable" => Localizer[
                "Hosting_ProfileCatalog_UnavailableDescription",
                provider.Identifier].Value,
            _ => Localizer["Hosting_ProfileCatalog_EmptyDescription", provider.Identifier].Value,
        };
}
