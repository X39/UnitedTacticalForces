@page "/command/servers/{ServerId:guid}"
@attribute [Authorize]
@layout CommandCenterLayout
@implements IAsyncDisposable
@using System.Globalization
@using System.Net
@using System.Text.Json
@using X39.UnitedTacticalForces.WebApp.Services.GameServerRepository
@inject IGameServerRepository GameServerRepository
@inject BaseUrl BaseUrl
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Language> Localizer

<PageTitle>@(_server?.Title ?? Localizer["Hosting_Detail_Title"])</PageTitle>

<div class="hosting-page hosting-detail-page">
    @if (_isLoading)
    {
        <div class="utf-state-panel">
            @Localizer["Hosting_Detail_Loading"]
            <FluentProgress Width="240px"/>
        </div>
    }
    else if (_server is null)
    {
        <section class="utf-empty-state">
            <h1>@Localizer["Hosting_Detail_NotFoundTitle"]</h1>
            <p>@(_loadError ?? Localizer["Hosting_Detail_NotFoundDescription"])</p>
            <a class="utf-button utf-button--ghost" href="@BaseUrl.ResolveSelfUrl("command/servers")">
                @Localizer["Hosting_Common_BackToServers"]
            </a>
        </section>
    }
    else
    {
        <UtfCommandPageHeader Title="@_server.Title"
                              Description="@(Localizer["Hosting_Detail_Description"])" >
            <Actions>
                <UtfCommandButton Disabled="@(_isRefreshing || _profilesLoading)" OnClick="RefreshAllAsync">
                    <Icon><FluentIcon Value="@(new Icons.Regular.Size20.ArrowSyncCircle())"/></Icon>
                    <ChildContent>@Localizer["Hosting_Common_Refresh"]</ChildContent>
                </UtfCommandButton>
                <UtfCommandButton Href="@BaseUrl.ResolveSelfUrl("command/servers")">
                    @Localizer["Hosting_Common_BackToServers"]
                </UtfCommandButton>
                @if (EmergencyTerminateAction is { } terminateAction)
                {
                    <UtfCommandButton Variant="danger"
                                      Disabled="@(_actionInProgress || !terminateAction.Enabled || terminateAction.Pending)"
                                      Title="@LocalizeServerMessage(terminateAction.UnavailableReason)"
                                      OnClick="@(() => RequestActionAsync(terminateAction))">
                        <Icon><FluentIcon Value="@(new Icons.Regular.Size20.Warning())"/></Icon>
                        <ChildContent>
                            @(terminateAction.Pending
                                ? Localizer["Hosting_Detail_ActionPending"]
                                : Localizer["Hosting_Detail_TerminateNow"])
                        </ChildContent>
                    </UtfCommandButton>
                }
                @if (!_server.IsArchived && _server.CanModify)
                {
                    <UtfCommandButton Variant="danger"
                                      Disabled="@(!CanDeleteServer || _deletingServer)"
                                      Title="@(CanDeleteServer ? null : Localizer["Hosting_Detail_DeleteUnavailable"].Value)"
                                      OnClick="DeleteServerAsync">
                        <Icon><FluentIcon Value="@(new Icons.Regular.Size20.Delete())"/></Icon>
                        <ChildContent>@Localizer["Hosting_Detail_DeleteServer"]</ChildContent>
                    </UtfCommandButton>
                }
            </Actions>
            <ChildContent>
                <div class="hosting-detail-identifiers">
                    <span>@_server.GameIdentifier</span>
                    <span>@_server.RuntimeProviderIdentifier</span>
                    <span>@_server.PrimaryKey</span>
                </div>
            </ChildContent>
        </UtfCommandPageHeader>

        @if (_loadError is not null)
        {
            <UtfAlert Intent="MessageIntent.Error">@_loadError</UtfAlert>
        }
        @if (_operationError is not null)
        {
            <UtfAlert Intent="MessageIntent.Error">@_operationError</UtfAlert>
        }

        <nav class="hosting-workspace-tabs" aria-label="@(Localizer["Hosting_Detail_WorkspaceNavigation"])" >
            <button class="@WorkspaceTabClass("overview")"
                    type="button"
                    aria-current="@(_activeSection == "overview" ? "page" : null)"
                    @onclick="@(() => SelectWorkspaceSection("overview"))">
                @Localizer["Hosting_Detail_TabOverview"]
            </button>
            <button class="@WorkspaceTabClass("runtime")"
                    type="button"
                    aria-current="@(_activeSection == "runtime" ? "page" : null)"
                    @onclick="@(() => SelectWorkspaceSection("runtime"))">
                @Localizer["Hosting_Detail_TabRuntime"]
            </button>
            <button class="@WorkspaceTabClass("cloud")"
                    type="button"
                    aria-current="@(_activeSection == "cloud" ? "page" : null)"
                    @onclick="@(() => SelectWorkspaceSection("cloud"))">
                @Localizer["Hosting_Detail_TabCloud"]
            </button>
            <button class="@WorkspaceTabClass("logs")"
                    type="button"
                    aria-current="@(_activeSection == "logs" ? "page" : null)"
                    @onclick="@(() => SelectWorkspaceSection("logs"))">
                @Localizer["Hosting_Detail_TabLogs"]
            </button>
            <button class="@WorkspaceTabClass("files")"
                    type="button"
                    aria-current="@(_activeSection == "files" ? "page" : null)"
                    @onclick="@(() => SelectWorkspaceSection("files"))">
                @Localizer["Hosting_Detail_TabFiles"]
            </button>
            <button class="@WorkspaceTabClass("configuration")"
                    type="button"
                    aria-current="@(_activeSection == "configuration" ? "page" : null)"
                    @onclick="@(() => SelectWorkspaceSection("configuration"))">
                Configuration
            </button>
            <button class="@WorkspaceTabClass("jobs")"
                    type="button"
                    aria-current="@(_activeSection == "jobs" ? "page" : null)"
                    @onclick="@(() => SelectWorkspaceSection("jobs"))">
                @Localizer["Hosting_Detail_TabJobs"]
                @if (_server.PendingJobCount > 0)
                {
                    <span class="hosting-tab-count">@_server.PendingJobCount</span>
                }
            </button>
            <button class="@WorkspaceTabClass("audit")"
                    type="button"
                    aria-current="@(_activeSection == "audit" ? "page" : null)"
                    @onclick="@(() => SelectWorkspaceSection("audit"))">
                @Localizer["Hosting_Detail_TabAudit"]
            </button>
        </nav>

        @if (_activeSection == "configuration")
        {
            <section class="utf-panel">
                <div class="hosting-section-heading">
                    <span class="utf-kicker">Effective game configuration</span>
                    <h2>Structured settings</h2>
                    <p>Defaults, the selected profile revision, and sparse server overrides are resolved here. A physical file at a generated target still wins at runtime.</p>
                </div>
                @if (_configurationLoading)
                {
                    <div class="utf-state-panel">Loading configuration…</div>
                }
                else if (_configurationError is not null)
                {
                    <UtfAlert Intent="MessageIntent.Error">@_configurationError</UtfAlert>
                }
                else if (_configuration is { } configuration)
                {
                    <label class="hosting-field">
                        <span>Configuration profile</span>
                        <select value="@(configuration.ProfileId?.ToString() ?? string.Empty)" @onchange="ChangeConfigurationProfileAsync">
                            <option value="">Game defaults only</option>
                            @foreach (var profile in _configurationProfileOptions)
                            {
                                <option value="@profile.PrimaryKey">@profile.Title</option>
                            }
                        </select>
                    </label>
                    @if (configuration.ProfileId is not null)
                    {
                        <div class="hosting-form-actions">
                            <button class="utf-button utf-button--ghost" type="button" @onclick="FollowLatestProfileAsync">Follow latest</button>
                            <button class="utf-button utf-button--ghost" type="button" disabled="@(configuration.ProfileRevisionId is null)" @onclick="PinCurrentProfileAsync">Pin revision @configuration.ProfileRevisionNumber</button>
                        </div>
                    }
                    @if (!configuration.IsComplete)
                    {
                        <UtfAlert Intent="MessageIntent.Warning">Required values are missing or invalid. The generated targets remain visible, but Start and generated downloads are blocked.</UtfAlert>
                    }
                    @foreach (var target in configuration.Entries.GroupBy(q => q.TargetPath))
                    {
                        <section class="hosting-file-mutations">
                            <div>
                                <h3>@target.Key</h3>
                                @if (_configurationOverriddenTargets.Contains(target.Key))
                                {
                                    <UtfAlert Intent="MessageIntent.Warning">A physical persistent file is effective at this target. Structured settings are hidden until that override is deleted in Files.</UtfAlert>
                                }
                                else
                                {
                                @foreach (var entry in target.GroupBy(q => q.Group).SelectMany(q => q))
                                {
                                    <label class="hosting-field">
                                        <span>@entry.DisplayName <small>from @entry.Source</small></span>
                                        <textarea disabled="@(!_server.CanModify || entry.Sensitive && entry.Value is null)"
                                                  value="@ConfigurationEditValue(entry)"
                                                  @onchange="@(args => SetConfigurationEdit(entry.Key, args.Value?.ToString()))"></textarea>
                                        <small>@entry.Description @entry.Warning</small>
                                    </label>
                                    @if (_server.CanModify && entry.Source == "Server")
                                    {
                                        <button class="utf-button utf-button--ghost" type="button" @onclick="@(() => ResetConfigurationEntryAsync(entry.Key))">Reset to inherited value</button>
                                    }
                                }
                                }
                            </div>
                        </section>
                    }
                    @if (_server.CanModify)
                    {
                        <button class="utf-button utf-button--primary" type="button" disabled="@(_configurationSaving || _configurationEdits.Count == 0)" @onclick="SaveConfigurationAsync">Save overrides</button>
                    }
                }
            </section>
        }

        @if (_activeSection == "overview")
        {
            <section class="hosting-command-strip" aria-labelledby="hosting-next-action-title">
                <div class="hosting-state-summary">
                    <span class="utf-kicker">@Localizer["Hosting_Detail_CurrentState"]</span>
                    <div>
                        <UtfStatusBadge Intent="@ServerStateIntent">@ServerStateLabel</UtfStatusBadge>
                        <span>@Localizer["Hosting_Detail_ServerAge", FormatAge(_server.TimeStampCreated)]</span>
                        <span>@_server.CostOwnerName</span>
                    </div>
                </div>
                @if (PrimaryAction is { } primaryAction)
                {
                    <article class="hosting-primary-action">
                        <div>
                            <span class="utf-kicker">@Localizer["Hosting_Detail_NextAction"]</span>
                            <h2 id="hosting-next-action-title">@ActionLabel(primaryAction)</h2>
                            <p>@ActionDescription(primaryAction)</p>
                            @if (!string.IsNullOrWhiteSpace(primaryAction.CostDescription))
                            {
                                <small>@ActionCostDescription(primaryAction)</small>
                            }
                        </div>
                        <button class="@GetActionButtonClass(primaryAction)"
                                type="button"
                                disabled="@(_actionInProgress || !primaryAction.Enabled || primaryAction.Pending)"
                                @onclick="@(() => RequestActionAsync(primaryAction))">
                            @(primaryAction.Pending ? Localizer["Hosting_Detail_ActionPending"] : ActionLabel(primaryAction))
                        </button>
                    </article>
                }
                else
                {
                    <article class="hosting-primary-action hosting-primary-action--quiet">
                        <div>
                            <span class="utf-kicker">@Localizer["Hosting_Detail_NextAction"]</span>
                            <h2 id="hosting-next-action-title">@Localizer["Hosting_Detail_NoActionNeeded"]</h2>
                            <p>@Localizer["Hosting_Detail_NoActionNeededDescription"]</p>
                        </div>
                    </article>
                }
                @if (SecondaryActions.Count > 0)
                {
                    <div class="hosting-secondary-actions">
                        @foreach (var action in SecondaryActions)
                        {
                            <button class="utf-button utf-button--ghost"
                                    type="button"
                                    disabled="@(_actionInProgress || !action.Enabled || action.Pending)"
                                    @onclick="@(() => RequestActionAsync(action))">
                                @ActionLabel(action)
                            </button>
                        }
                    </div>
                }
            </section>
        }

        @if (_activeSection == "overview")
        {
        <section class="hosting-detail-overview">
            <article class="utf-panel hosting-fact-panel">
                <div class="hosting-section-heading">
                    <span class="utf-kicker">@Localizer["Hosting_Detail_RecordKicker"]</span>
                    <h2>@Localizer["Hosting_Detail_RecordTitle"]</h2>
                </div>
                <dl class="hosting-facts">
                    <div>
                        <dt>@Localizer["Hosting_Common_CostOwner"]</dt>
                        <dd>@_server.CostOwnerName</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Hosting_Detail_LaunchPolicy"]</dt>
                        <dd>@(_server.IsLaunchDisabled ? Localizer["Hosting_Detail_LaunchDisabled"] : Localizer["Hosting_Detail_LaunchEnabled"])</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Hosting_Detail_CloudProfile"]</dt>
                        <dd>
                            <strong>@_server.RuntimeProfileDisplayName</strong>
                            <small><code>@_server.RuntimeProfileIdentifier</code></small>
                        </dd>
                    </div>
                    <div>
                        <dt>@Localizer["Hosting_Detail_EstimatedCost"]</dt>
                        <dd>@FormatProfileCost(_server.EstimatedHourlyCostEur, _server.EstimatedMonthlyCostEur)</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Hosting_Detail_Archived"]</dt>
                        <dd>@(_server.IsArchived ? Localizer["Hosting_Common_Yes"] : Localizer["Hosting_Common_No"])</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Hosting_Common_Updated"]</dt>
                        <dd>@FormatDate(_server.TimeStampUpdated)</dd>
                    </div>
                </dl>
                <RuntimeProfileEditor Provider="_runtimeProvider"
                                      ProviderIdentifier="@_server.RuntimeProviderIdentifier"
                                      CurrentIdentifier="@_server.RuntimeProfileIdentifier"
                                      SelectedIdentifier="@_selectedRuntimeProfileIdentifier"
                                      SelectedIdentifierChanged="SelectRuntimeProfile"
                                      OnSave="SaveRuntimeProfileAsync"
                                      OnRetry="ReloadRuntimeProfilesAsync"
                                      IsLoading="@_profilesLoading"
                                      LoadError="@_profileCatalogError"
                                      CanModify="@(_server.CanModify && !_server.IsArchived)"
                                      CanSave="@_profileChanged"
                                      IsSaving="@_profileMutationInProgress"
                                      HasActiveDeployment="@(_server.Deployment is not null)"
                                      ReadOnlyDescription="@ProfileReadOnlyDescription"/>
                @if (_storageDemandLoading)
                {
                    <p class="hosting-muted" role="status">Refreshing storage estimate…</p>
                }
                else if (_storageDemandError is not null)
                {
                    <UtfAlert Intent="MessageIntent.Warning">Storage estimate unavailable: @_storageDemandError</UtfAlert>
                }
                else if (_storageDemand is { } storageDemand)
                {
                    <p class="hosting-muted">Peak deployment storage: @FormatBytes(storageDemand.PeakPreparationRequiredBytes)</p>
                }
            </article>

            <article class="utf-panel hosting-fact-panel">
                <div class="hosting-section-heading">
                    <span class="utf-kicker">@Localizer["Hosting_Detail_DeploymentKicker"]</span>
                    <h2>@Localizer["Hosting_Detail_DeploymentTitle"]</h2>
                </div>
                @if (_server.Deployment is not { } deployment)
                {
                    <p class="hosting-muted">@Localizer["Hosting_Detail_NoDeployment"]</p>
                }
                else
                {
                    <dl class="hosting-facts">
                        <div>
                            <dt>@Localizer["Hosting_Common_Status"]</dt>
                            <dd>@LocalizeToken("Hosting_DeploymentStatus", deployment.Status)</dd>
                        </div>
                        <div>
                            <dt>@Localizer["Hosting_Common_Stage"]</dt>
                            <dd>@HumanizeToken(deployment.Stage)</dd>
                        </div>
                        <div>
                            <dt>@Localizer["Hosting_Common_CostOwner"]</dt>
                            <dd>@deployment.CostOwnerName</dd>
                        </div>
                        <div>
                            <dt>@Localizer["Hosting_Detail_Worker"]</dt>
                            <dd>@LocalizeToken("Hosting_WorkerStatus", deployment.WorkerStatus)</dd>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(deployment.PublicAddress))
                        {
                            <div>
                                <dt>@Localizer["Hosting_Detail_PublicAddress"]</dt>
                                <dd><code>@deployment.PublicAddress</code></dd>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(deployment.ConnectionEndpoint))
                        {
                            <div>
                                <dt>@Localizer["Hosting_Detail_ConnectionEndpoint"]</dt>
                                <dd>
                                    <code>@deployment.ConnectionEndpoint</code>
                                    @if (!string.IsNullOrWhiteSpace(deployment.ConnectionProtocol))
                                    {
                                        <span> (@deployment.ConnectionProtocol)</span>
                                    }
                                </dd>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(deployment.AdministrativeSshCommand))
                        {
                            <div>
                                <dt>Administrator SSH</dt>
                                <dd><code>@deployment.AdministrativeSshCommand</code></dd>
                            </div>
                        }
                    </dl>
                    @if (string.Equals(deployment.Stage, "waiting-for-worker-registration", StringComparison.OrdinalIgnoreCase)
                         || string.Equals(deployment.Stage, "waiting-for-worker", StringComparison.OrdinalIgnoreCase))
                    {
                        <UtfAlert Intent="MessageIntent.Info">
                            The VM is allocated, but its worker has not registered yet. Initial package updates,
                            Docker installation, storage preparation, and the first worker-image pull happen before
                            registration and can take several minutes.
                        </UtfAlert>
                    }
                    @if (!string.IsNullOrWhiteSpace(deployment.AdministrativeSshCommand))
                    {
                        <details class="hosting-commands">
                            <summary>Worker failure diagnostics</summary>
                            <div>
                                <div class="hosting-command"><span>Cloud-init status and errors</span><code>sudo cloud-init status --long</code></div>
                                <div class="hosting-command"><span>Cloud-init log</span><code>sudo journalctl -u cloud-final --no-pager -n 200</code></div>
                                <div class="hosting-command"><span>UTF services</span><code>sudo systemctl --failed; sudo systemctl list-units 'utf-*'</code></div>
                                <div class="hosting-command"><span>Worker container and logs</span><code>sudo docker ps -a; sudo docker logs --tail 200 $(sudo docker ps -aq --filter name=utf-cloud-worker)</code></div>
                            </div>
                        </details>
                    }
                    @if (deployment.Resources.Count > 0)
                    {
                        <details class="hosting-commands">
                            <summary>@Localizer["Hosting_Detail_ProviderResources", deployment.Resources.Count]</summary>
                            <div>
                                @foreach (var resource in deployment.Resources)
                                {
                                    <div class="hosting-command" @key="resource.PrimaryKey">
                                        <span>@resource.Kind · @resource.State</span>
                                        <strong>@(resource.ProviderState ?? Localizer["Hosting_Common_NotApplicable"])</strong>
                                        <small>@(resource.ProviderResourceIdentifier ?? Localizer["Hosting_Common_NotApplicable"])</small>
                                    </div>
                                }
                            </div>
                        </details>
                    }
                    @if (deployment.PossibleCost)
                    {
                        <p class="hosting-cost-warning">@Localizer["Hosting_Detail_PossibleCost"]</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(deployment.FaultSummary))
                    {
                        <p class="hosting-fault">@deployment.FaultSummary</p>
                    }
                }
            </article>
        </section>
        }

        @if (_activeSection is "overview" or "audit")
        {
        <section class="utf-panel hosting-operations-panel">
            <div class="hosting-section-heading hosting-section-heading--row">
                <div>
                    <span class="utf-kicker">@Localizer["Hosting_Detail_OperationsKicker"]</span>
                    <h2>@Localizer["Hosting_Detail_OperationsTitle"]</h2>
                    <p>@Localizer["Hosting_Detail_OperationsDescription"]</p>
                </div>
                @if (_operations.Count > 8)
                {
                    <button class="utf-button utf-button--ghost"
                            type="button"
                            @onclick="@(() => _showAllOperations = !_showAllOperations)">
                        @(_showAllOperations
                            ? Localizer["Hosting_Detail_OperationsShowRecent"]
                            : Localizer["Hosting_Detail_OperationsShowAll"])
                    </button>
                }
            </div>

            @if (_operations.Count is 0)
            {
                <p class="hosting-muted">@Localizer["Hosting_Detail_OperationsEmpty"]</p>
            }
            else
            {
                <ol class="hosting-operation-list">
                    @foreach (var operation in VisibleOperations)
                    {
                        <li class="hosting-operation" @key="operation.PrimaryKey">
                            <span class="@GetOperationIconClass(operation)">
                                @GetOperationIcon(operation)
                            </span>
                            <div class="hosting-operation-copy">
                                <div class="hosting-operation-title">
                                    <strong>@operation.Summary</strong>
                                    <time datetime="@operation.TimeStampCreated.ToString("O")">
                                        @FormatDate(operation.TimeStampCreated)
                                    </time>
                                </div>
                                <div class="hosting-operation-meta">
                                    <UtfStatusBadge Intent="@GetOperationIntent(operation)">
                                        @operation.Status
                                    </UtfStatusBadge>
                                    <span>@operation.ProviderIdentifier</span>
                                    @if (!string.IsNullOrWhiteSpace(operation.ResourceKind))
                                    {
                                        <span>@operation.ResourceKind</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(operation.ProviderState))
                                    {
                                        <span>@operation.ProviderState</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(operation.ResourceIdentifier))
                                {
                                    <code>@operation.ResourceIdentifier</code>
                                }
                                @if ((operation.Status is "failed" or "warning")
                                     && !string.IsNullOrWhiteSpace(operation.Detail))
                                {
                                    <p class="hosting-operation-error">@operation.Detail</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(operation.TraceId))
                                {
                                    <small>
                                        @Localizer["Hosting_Detail_OperationsTrace"]:
                                        <code>@operation.TraceId</code>
                                    </small>
                                }
                            </div>
                        </li>
                    }
                </ol>
            }
        </section>
        }

        @if (_activeSection == "runtime")
        {
        @if (IsArma3Server)
        {
        <section class="utf-panel hosting-modpack-panel">
            <div class="hosting-section-heading">
                <span class="utf-kicker">@Localizer["Hosting_Detail_ModPackKicker"]</span>
                <h2>@Localizer["Hosting_Detail_ModPackTitle"]</h2>
                <p>@Localizer["Hosting_Detail_ModPackDescription"]</p>
            </div>

            @if (_modPackError is not null)
            {
                <UtfAlert Intent="MessageIntent.Error">@_modPackError</UtfAlert>
            }
            @if (_modPacksLoading)
            {
                <div class="utf-state-panel">@Localizer["Hosting_Detail_ModPackLoading"]</div>
            }
            else
            {
                <div class="hosting-modpack-editor">
                    <label class="hosting-field">
                        <span>@Localizer["Hosting_Detail_ModPackTitle"]</span>
                        <select value="@(_selectedModPackDefinitionId?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)"
                                disabled="@(!_server.CanModify || _modPackMutationInProgress)"
                                @onchange="SelectModPack">
                            <option value="">@Localizer["Hosting_Detail_NoModPack"]</option>
                            @foreach (var option in _modPackOptions)
                            {
                                <option value="@option.PrimaryKey">@option.Title</option>
                            }
                        </select>
                    </label>
                    @if (_server.Deployment is not null)
                    {
                        <UtfAlert Intent="MessageIntent.Info">
                            @Localizer["Hosting_Detail_ModPackAppliesNextPreparation"]
                        </UtfAlert>
                    }
                    @if (_server.CanModify)
                    {
                        <button class="utf-button utf-button--primary"
                                type="button"
                                disabled="@(!_modPackSelectionDirty || _modPackMutationInProgress)"
                                @onclick="SaveModPackAsync">
                            @Localizer["Hosting_Detail_SaveModPack"]
                        </button>
                    }
                </div>
            }
        </section>
        }

        <section class="utf-panel hosting-actions-panel">
            <div class="hosting-section-heading">
                <span class="utf-kicker">@Localizer["Hosting_Detail_ActionsKicker"]</span>
                <h2>@Localizer["Hosting_Detail_ActionsTitle"]</h2>
                <p>@Localizer["Hosting_Detail_ActionsDescription"]</p>
            </div>

            @if (RuntimeActions.Count is 0)
            {
                <p class="hosting-muted">@Localizer["Hosting_Detail_NoActions"]</p>
            }
            else
            {
                <div class="hosting-action-groups">
                    @foreach (var group in OrderedActionGroups)
                    {
                        <section class="hosting-action-group">
                            <h3>@group.Key</h3>
                            <div class="hosting-action-grid">
                                @foreach (var action in group.OrderBy((action) => action.Order))
                                {
                                    <article class="@GetActionClass(action)" @key="action.Id">
                                        <div class="hosting-action-copy">
                                            <div>
                                                @if (!string.IsNullOrWhiteSpace(action.Icon))
                                                {
                                                    <span class="hosting-action-icon" aria-hidden="true">@GetActionIcon(action.Icon)</span>
                                                }
                                                <strong>@ActionLabel(action)</strong>
                                            </div>
                                            <p>@ActionDescription(action)</p>
                                            @if (string.Equals(action.Id, "start", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <p class="hosting-cost-warning">
                                                    @Localizer["Hosting_Detail_StartProfileSummary",
                                                        _server.RuntimeProfileDisplayName,
                                                        FormatProfileCost(_server.EstimatedHourlyCostEur, _server.EstimatedMonthlyCostEur)]
                                                </p>
                                            }
                                            <div class="hosting-action-meta">
                                                <span>@LocalizeToken("Hosting_CostImpact", action.CostImpact)</span>
                                                @if (action.ExpectedDurationSeconds is { } durationSeconds)
                                                {
                                                    <span>@Localizer["Hosting_Detail_ExpectedDuration", FormatDuration(durationSeconds)]</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(action.CostDescription))
                                            {
                                                <small>@ActionCostDescription(action)</small>
                                            }
                                            @if (!action.Enabled && !string.IsNullOrWhiteSpace(action.UnavailableReason))
                                            {
                                                <span class="hosting-action-unavailable">@LocalizeServerMessage(action.UnavailableReason)</span>
                                            }
                                        </div>
                                        <button class="@GetActionButtonClass(action)"
                                                type="button"
                                                disabled="@(_actionInProgress || !action.Enabled || action.Pending)"
                                                title="@LocalizeServerMessage(action.UnavailableReason)"
                                                @onclick="@(() => RequestActionAsync(action))">
                                            @(action.Pending ? Localizer["Hosting_Detail_ActionPending"] : ActionLabel(action))
                                        </button>
                                    </article>
                                }
                            </div>
                        </section>
                    }
                </div>
            }

            @if (_challengedAction is { } challengedAction)
            {
                <section class="hosting-challenge" role="alertdialog" aria-labelledby="hosting-challenge-title">
                    <div>
                        <span class="utf-kicker">@Localizer["Hosting_Detail_ConfirmationKicker"]</span>
                        <h3 id="hosting-challenge-title">@ActionLabel(challengedAction)</h3>
                        <p>@LocalizeServerMessage(challengedAction.ConfirmationText)</p>
                    </div>
                    <label>
                        <span>@Localizer["Hosting_Detail_TypeChallenge", challengedAction.ConfirmationChallenge!]</span>
                        <input autocomplete="off"
                               @ref="_confirmationInputElement"
                               value="@_confirmationInput"
                               @oninput="UpdateConfirmationInput"/>
                    </label>
                    <div>
                        <button class="utf-button utf-button--ghost" type="button" @onclick="CancelChallenge">
                            @Localizer["Hosting_Common_Cancel"]
                        </button>
                        <button class="utf-button utf-button--danger"
                                type="button"
                                disabled="@(!ChallengeMatches || _actionInProgress)"
                                @onclick="ConfirmChallengedActionAsync">
                            @ActionLabel(challengedAction)
                        </button>
                    </div>
                </section>
            }
        </section>
        }

        @if (_activeSection == "jobs")
        {
        <section class="utf-panel hosting-queue-panel">
            <div class="hosting-section-heading hosting-section-heading--row">
                <div>
                    <span class="utf-kicker">@Localizer["Hosting_Detail_QueueKicker"]</span>
                    <h2>@Localizer["Hosting_Detail_QueueTitle"]</h2>
                    <p>@Localizer["Hosting_Detail_QueueDescription"]</p>
                </div>
                <UtfStatusBadge Intent="@(_server.PendingJobCount > 0 ? "info" : "neutral")">
                    @Localizer["Hosting_Servers_JobCount", _server.PendingJobCount]
                </UtfStatusBadge>
            </div>

            @if (_jobs.Count is 0)
            {
                <p class="hosting-muted">@Localizer["Hosting_Detail_QueueEmpty"]</p>
            }
            else
            {
                <div class="hosting-job-list">
                    @foreach (var job in _jobs.OrderByDescending((job) => job.TimeStampCreated))
                    {
                        <article class="hosting-job" @key="job.PrimaryKey">
                            <header>
                                <div>
                                    <strong>@LocalizeActionId(job.ActionId)</strong>
                                    <span>@LocalizeToken("Hosting_LifecycleJobKind", job.Kind) · @LocalizeToken("Hosting_LifecycleJobStatus", job.Status) · @HumanizeToken(job.Stage)</span>
                                </div>
                                <time>@FormatDate(job.TimeStampUpdated)</time>
                            </header>
                            <progress max="100" value="@Math.Clamp(job.ProgressPercent, 0, 100)"></progress>
                            <div class="hosting-job-meta">
                                <span>@Localizer["Hosting_Detail_Progress", job.ProgressPercent]</span>
                                <span>@Localizer["Hosting_Detail_Attempts", job.AttemptCount]</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(job.FailureReason))
                            {
                                <p class="hosting-fault">@job.FailureReason</p>
                                <small class="hosting-muted">
                                    Diagnostic reference: @job.PrimaryKey
                                    @if (!string.IsNullOrWhiteSpace(job.FailureCode))
                                    {
                                        <text> · @job.FailureCode</text>
                                    }
                                </small>
                            }
                            @if (job.CanRetry || job.CanSkip)
                            {
                                <div class="hosting-job-actions">
                                    @if (job.CanRetry)
                                    {
                                        <button class="utf-button utf-button--primary"
                                                type="button"
                                                disabled="@_jobInterventionInProgress"
                                                @onclick="@(() => InterveneAsync(job, retry: true))">
                                            @Localizer["Hosting_Detail_Retry"]
                                        </button>
                                    }
                                    @if (job.CanSkip)
                                    {
                                        <button class="utf-button utf-button--ghost"
                                                type="button"
                                                disabled="@_jobInterventionInProgress"
                                                @onclick="@(() => InterveneAsync(job, retry: false))">
                                            @Localizer["Hosting_Detail_Skip"]
                                        </button>
                                    }
                                </div>
                            }
                            @if (job.Commands.Count > 0)
                            {
                                <details class="hosting-commands">
                                    <summary>@Localizer["Hosting_Detail_Commands", job.Commands.Count]</summary>
                                    <div>
                                        @foreach (var command in job.Commands.OrderBy((command) => command.Sequence))
                                        {
                                            <div class="hosting-command" @key="command.PrimaryKey">
                                                <span>#@command.Sequence · @LocalizeActionId(command.ActionId)</span>
                                                <strong>@LocalizeToken("Hosting_WorkerCommandStatus", command.Status) · @HumanizeToken(command.Stage)</strong>
                                                @if (!string.IsNullOrWhiteSpace(command.FailureReason))
                                                {
                                                    <small>@command.FailureReason</small>
                                                }
                                            </div>
                                        }
                                    </div>
                                </details>
                            }
                        </article>
                    }
                </div>
            }
        </section>
        }

        @if (_activeSection == "files")
        {
        <section class="utf-panel hosting-files-panel">
            <div class="hosting-section-heading">
                <span class="utf-kicker">@Localizer["Hosting_Detail_FilesKicker"]</span>
                <h2>@Localizer["Hosting_Detail_FilesTitle"]</h2>
                <p>@Localizer["Hosting_Detail_FilesDescription"]</p>
            </div>

            <div class="hosting-explorer">
                <aside class="hosting-explorer-sidebar">
