    private bool CanSaveRuntimeStorage(RuntimeStorageCapabilitiesInfo storage)
        => _server is { CanModify: true, IsArchived: false, Deployment: null }
           && _storageSelectionDirty
           && !_storageMutationInProgress
           && string.IsNullOrWhiteSpace(storage.ReadinessFailure)
           && (_selectedRuntimeStorageStrategy != "AutomaticExternal"
               || SelectedStorageCapacityBytes(storage) is { } automaticBytes
               && automaticBytes / 1_073_741_824L <= storage.MaximumCapacityGiB)
           && (_selectedRuntimeStorageStrategy != "FixedExternal"
               || _selectedExternalStorageSizeGiB is { } size
               && size >= storage.MinimumCapacityGiB
               && size <= storage.MaximumCapacityGiB
               && size % storage.CapacityIncrementGiB == 0);

