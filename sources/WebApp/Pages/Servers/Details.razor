    private string StorageSelectionSummary(RuntimeStorageCapabilitiesInfo storage)
        => _selectedRuntimeStorageStrategy switch
        {
            "IncludedDisk" => "Deployment content uses the selected profile's included disk.",
            "AutomaticExternal" => $"Deployment content uses {storage.DeploymentMountPath}; capacity is resolved from the latest peak requirement when Start provisions.",
            "FixedExternal" => $"Deployment content uses a {_selectedExternalStorageSizeGiB?.ToString(CultureInfo.CurrentCulture) ?? "—"} GiB external filesystem at {storage.DeploymentMountPath}.",
            _ => string.Empty,
        };

    private long? SelectedStorageCapacityBytes(RuntimeStorageCapabilitiesInfo storage)
    {
        const long gibibyte = 1_073_741_824L;
        if (_selectedRuntimeStorageStrategy == "IncludedDisk")
        {
            return _storageDemand?.RuntimeProfiles.FirstOrDefault(profile => string.Equals(
                profile.RuntimeProfileIdentifier,
                _selectedRuntimeProfileIdentifier,
                StringComparison.OrdinalIgnoreCase))?.UsableCapacityBytes;
        }
        if (_selectedRuntimeStorageStrategy == "FixedExternal")
            return _selectedExternalStorageSizeGiB is { } fixedGiB ? fixedGiB * gibibyte : null;
        if (_storageDemand is not { } demand)
            return null;
        var requiredGiB = demand.PeakPreparationRequiredBytes / gibibyte
                          + (demand.PeakPreparationRequiredBytes % gibibyte == 0 ? 0 : 1);
        var constrainedGiB = Math.Max(requiredGiB, storage.MinimumCapacityGiB);
        var increment = Math.Max(1, storage.CapacityIncrementGiB);
        var roundedGiB = constrainedGiB / increment + (constrainedGiB % increment == 0 ? 0 : 1);
        return checked(roundedGiB * increment * gibibyte);
    }

    private string FormatSelectedRuntimePrice(RuntimeStorageCapabilitiesInfo storage)
    {
        if (SelectedRuntimeProfile?.EstimatedHourlyCostEur is not { } computeHourly)
            return Localizer["Hosting_Detail_PriceUnavailable"].Value;
        var selectedBytes = SelectedStorageCapacityBytes(storage);
        var storageHourly = _selectedRuntimeStorageStrategy == "IncludedDisk" || selectedBytes is null
            ? 0m
            : selectedBytes.Value / 1_073_741_824m * storage.EstimatedHourlyCostPerGiBEur;
        var hourly = computeHourly + storageHourly;
        var monthly = (SelectedRuntimeProfile.EstimatedMonthlyCostEur ?? computeHourly * 730m) + storageHourly * 730m;
        return FormatProfileCost(hourly, monthly);
    }

