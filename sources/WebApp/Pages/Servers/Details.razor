                <div class="hosting-explorer-main">

            @if (_fileError is not null)
            {
                <UtfAlert Intent="MessageIntent.Warning">@_fileError</UtfAlert>
            }

            <div class="hosting-file-toolbar">
                <button class="utf-button utf-button--ghost"
                        type="button"
                        disabled="@(string.IsNullOrEmpty(_currentPath) || _filesLoading)"
                        @onclick="OpenParentDirectoryAsync">
                    @Localizer["Hosting_Detail_ParentFolder"]
                </button>
                <nav class="hosting-breadcrumbs" aria-label="@(Localizer["Hosting_Detail_Breadcrumbs"])" >
                    @foreach (var breadcrumb in FileBreadcrumbs)
                    {
                        <button type="button"
                                disabled="@_filesLoading"
                                @onclick="@(() => LoadFilesAsync(breadcrumb.Path))">
                            @breadcrumb.Label
                        </button>
                        @if (breadcrumb.Path != _currentPath)
                        {
                            <span aria-hidden="true">›</span>
                        }
                    }
                </nav>
                <button class="utf-button utf-button--ghost"
                        type="button"
                        disabled="@_filesLoading"
                        @onclick="@(() => LoadFilesAsync(_currentPath))">
                    @Localizer["Hosting_Common_Refresh"]
                </button>
            </div>

            @if (_filesLoading)
            {
                <div class="utf-state-panel">@Localizer["Hosting_Detail_FilesLoading"]</div>
            }
            else if (_files.Count is 0)
            {
                <p class="hosting-muted">@Localizer["Hosting_Detail_FilesEmpty"]</p>
            }
            else
            {
                <div class="hosting-file-list" role="table" aria-label="@(Localizer["Hosting_Detail_FilesTitle"])" >
                    <div class="hosting-file-entry-header" role="row">
                        <div role="columnheader">
                            <button type="button" @onclick="@(() => SetFileSort("name"))">
                                @Localizer["Hosting_Detail_FileName"] @SortIndicator("name")
                            </button>
                        </div>
                        <div role="columnheader">
                            <button type="button" @onclick="@(() => SetFileSort("modified"))">
                                @Localizer["Hosting_Detail_FileModified"] @SortIndicator("modified")
                            </button>
                        </div>
                        <span role="columnheader">@Localizer["Hosting_Detail_FileType"]</span>
                        <div role="columnheader">
                            <button type="button" @onclick="@(() => SetFileSort("size"))">
                                @Localizer["Hosting_Detail_FileSize"] @SortIndicator("size")
                            </button>
                        </div>
                        <span role="columnheader">@Localizer["Hosting_Detail_FileActions"]</span>
                    </div>
                    @foreach (var entry in SortedFiles)
                    {
                        <article class="hosting-file-entry" role="row" @key="entry.Path">
                            <div class="hosting-file-name-cell" role="cell">
                                <button class="hosting-file-name"
                                        type="button"
                                        disabled="@(!entry.IsDirectory)"
                                        @onclick="@(() => OpenDirectoryAsync(entry))">
                                    @if (entry.IsDirectory)
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size20.Open())"/>
                                    }
                                    else
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size20.DocumentBulletListClock())"/>
                                    }
                                    <strong>@entry.Name</strong>
                                    @if (entry.IsGeneratedTarget)
                                    {
                                        <small>@(entry.OverridesGenerated ? "persistent override" : entry.ConfigurationStatus == "Incomplete" ? "generated · incomplete" : "generated")</small>
                                    }
                                </button>
                            </div>
                            <time role="cell">@(entry.ModifiedAt is { } modifiedAt ? FormatDate(modifiedAt) : "–")</time>
                            <span role="cell">@LocalizeToken("Hosting_FileClassification", entry.Classification)</span>
                            <span role="cell">@FormatFileSize(entry.Size)</span>
                            <div role="cell">
                                @if (!entry.IsDirectory)
                                {
                                    <a class="utf-button utf-button--ghost"
                                       href="@GetDownloadUrl(entry)"
                                       download="@entry.Name">
                                        @Localizer["Hosting_Detail_Download"]
                                    </a>
                                }
                                @if (entry.CanModify && (!entry.IsGeneratedTarget || entry.OverridesGenerated))
                                {
                                    <button class="utf-button utf-button--ghost"
                                            type="button"
                                            disabled="@_fileMutationInProgress"
                                            @onclick="@(() => DeleteFileAsync(entry))">
                                        @Localizer["Hosting_Detail_Delete"]
                                    </button>
                                }
                            </div>
                        </article>
                    }
                </div>
            }

            @if (CanMutateFiles)
            {
                <div class="hosting-file-mutations">
                <section>
                    <h3>@Localizer["Hosting_Detail_UploadTitle"]</h3>
                    <label class="hosting-field">
                        <span>@Localizer["Hosting_Detail_TargetPath"]</span>
                        <input @bind="_uploadPath" @bind:event="oninput"/>
                    </label>
                    <InputFile OnChange="SelectUploadAsync"/>
                    <small>@(_selectedUploadName ?? Localizer["Hosting_Detail_NoFileSelected"])</small>
                    @if (UploadTargetsGeneratedFile)
                    {
                        <label class="hosting-check-field">
                            <input type="checkbox" @bind="_confirmGeneratedOverride"/>
                            <span><strong>Create persistent override</strong><small>This hides structured editing for the generated target until the uploaded file is deleted.</small></span>
                        </label>
                    }
                    <button class="utf-button utf-button--primary"
                            type="button"
                            disabled="@(_fileMutationInProgress || _selectedUpload is null || string.IsNullOrWhiteSpace(_uploadPath))"
                            @onclick="UploadFileAsync">
                        @Localizer["Hosting_Detail_Upload"]
                    </button>
                </section>
                <section>
                    <h3>@Localizer["Hosting_Detail_CreateFolderTitle"]</h3>
                    <label class="hosting-field">
                        <span>@Localizer["Hosting_Detail_TargetPath"]</span>
                        <input @bind="_directoryPath" @bind:event="oninput"/>
                    </label>
                    <button class="utf-button utf-button--ghost"
                            type="button"
                            disabled="@(_fileMutationInProgress || string.IsNullOrWhiteSpace(_directoryPath))"
                            @onclick="CreateDirectoryAsync">
                        @Localizer["Hosting_Detail_CreateFolder"]
                    </button>
                </section>
                </div>
            }
                </div>
            </div>
        </section>

        @if (_server.CanModify)
        {
            <section class="utf-panel hosting-preservation-panel">
            <div class="hosting-section-heading">
                <span class="utf-kicker">@Localizer["Hosting_Detail_PreservationKicker"]</span>
                <h2>@Localizer["Hosting_Detail_PreservationTitle"]</h2>
                <p>@Localizer["Hosting_Detail_PreservationDescription"]</p>
            </div>

            @if (_selectionError is not null)
            {
                <UtfAlert Intent="MessageIntent.Warning">@_selectionError</UtfAlert>
            }

            <div class="hosting-preservation-grid">
                <div class="hosting-selection-list">
                    @if (_selections.Count is 0)
                    {
                        <p class="hosting-muted">@Localizer["Hosting_Detail_PreservationEmpty"]</p>
                    }
                    @foreach (var selection in _selections.OrderBy((selection) => selection.Path))
                    {
                        <article @key="selection.PrimaryKey">
                            <div>
                                <strong>@selection.Path</strong>
                                <span>@selection.Scope · @selection.Mode</span>
                                @if (selection.SeededByGame)
                                {
                                    <small>@Localizer["Hosting_Detail_SeededByGame"]</small>
                                }
                            </div>
                            <button class="utf-button utf-button--ghost"
                                    type="button"
                                    disabled="@_selectionMutationInProgress"
                                    @onclick="@(() => DeleteSelectionAsync(selection))">
                                @Localizer["Hosting_Detail_Remove"]
                            </button>
                        </article>
                    }
                </div>

                <form class="hosting-selection-form"
                      @onsubmit="AddSelectionAsync"
                      @onsubmit:preventDefault="true">
                    <h3>@Localizer["Hosting_Detail_AddPreservation"]</h3>
                    <label class="hosting-field">
                        <span>@Localizer["Hosting_Detail_TargetPath"]</span>
                        <input required @bind="_selectionPath" @bind:event="oninput"/>
                    </label>
                    <label class="hosting-field">
                        <span>@Localizer["Hosting_Detail_Scope"]</span>
                        <select @bind="_selectionScope">
                            <option value="File">@Localizer["Hosting_Detail_ScopeFile"]</option>
                            <option value="FlatFolder">@Localizer["Hosting_Detail_ScopeFlat"]</option>
                            <option value="RecursiveFolder">@Localizer["Hosting_Detail_ScopeRecursive"]</option>
                        </select>
                    </label>
                    <label class="hosting-field">
                        <span>@Localizer["Hosting_Detail_DeletionPolicy"]</span>
                        <select @bind="_selectionMode">
                            <option value="CreateOrUpdate">@Localizer["Hosting_Detail_ModeCreateUpdate"]</option>
                            <option value="MirrorDeletions">@Localizer["Hosting_Detail_ModeMirror"]</option>
                        </select>
                    </label>
                    <button class="utf-button utf-button--primary"
                            type="submit"
                            disabled="@(_selectionMutationInProgress || string.IsNullOrWhiteSpace(_selectionPath))">
                        @Localizer["Hosting_Detail_Add"]
                    </button>
                </form>
            </div>
            </section>
        }
        }

        @if (_activeSection == "cloud")
        {
            <section class="hosting-cloud-grid">
                <article class="utf-panel hosting-cloud-profile-panel">
                    <div class="hosting-section-heading">
                        <span class="utf-kicker">@Localizer["Hosting_Detail_CloudProfileKicker"]</span>
                        <h2>@Localizer["Hosting_Detail_CloudProfileTitle"]</h2>
                        <p>@Localizer["Hosting_Detail_CloudProfileDescription"]</p>
                    </div>
                    <dl class="hosting-facts">
                        <div>
                            <dt>@Localizer["Hosting_Detail_DesiredProfile"]</dt>
                            <dd>
                                <strong>@_server.RuntimeProfileDisplayName</strong>
                                <small><code>@_server.RuntimeProfileIdentifier</code></small>
                            </dd>
                        </div>
                        <div>
                            <dt>@Localizer["Hosting_Detail_EstimatedCost"]</dt>
                            <dd>@FormatProfileCost(_server.EstimatedHourlyCostEur, _server.EstimatedMonthlyCostEur)</dd>
                        </div>
                        @if (_server.Deployment is { } activeDeployment)
                        {
                            <div>
                                <dt>@Localizer["Hosting_Detail_ActiveProfile"]</dt>
                                <dd>
                                    <strong>@activeDeployment.RuntimeProfileDisplayName</strong>
                                    <small><code>@activeDeployment.RuntimeProfileIdentifier</code></small>
                                </dd>
                            </div>
                            <div>
                                <dt>@Localizer["Hosting_Detail_ActiveProfileCost"]</dt>
                                <dd>@FormatProfileCost(activeDeployment.EstimatedHourlyCostEur, monthly: null)</dd>
                            </div>
                        }
                    </dl>
                    <RuntimeProfileEditor Provider="_runtimeProvider"
                                          ProviderIdentifier="@_server.RuntimeProviderIdentifier"
                                          CurrentIdentifier="@_server.RuntimeProfileIdentifier"
                                          SelectedIdentifier="@_selectedRuntimeProfileIdentifier"
                                          SelectedIdentifierChanged="SelectRuntimeProfile"
                                          OnSave="SaveRuntimeProfileAsync"
                                          OnRetry="ReloadRuntimeProfilesAsync"
                                          IsLoading="@_profilesLoading"
                                          LoadError="@_profileCatalogError"
                                          CanModify="@(_server.CanModify && !_server.IsArchived)"
                                          CanSave="@_profileChanged"
                                          IsSaving="@_profileMutationInProgress"
                                          HasActiveDeployment="@(_server.Deployment is not null)"
                                          ReadOnlyDescription="@ProfileReadOnlyDescription"/>
                    @if (_runtimeProvider?.Storage is { } storage)
                    {
                        <section class="hosting-storage-configuration" aria-labelledby="runtime-storage-title">
                            <div class="hosting-section-heading">
                                <span class="utf-kicker">Deployment storage</span>
                                <h3 id="runtime-storage-title">Storage for @SelectedRuntimeProfile?.DisplayName</h3>
                                <p>Choose the single filesystem used for game files, Workshop content, scenarios, and preparation.</p>
                            </div>
                            <div class="hosting-storage-selection-grid">
                                <label class="hosting-field">
                                    <span>Storage strategy</span>
                                    <select value="@_selectedRuntimeStorageStrategy"
                                            disabled="@(!_server.CanModify || _server.IsArchived || _server.Deployment is not null || _storageMutationInProgress)"
                                            @onchange="SelectRuntimeStorage">
                                        <option value="IncludedDisk">Included profile disk only</option>
                                        @if (storage.SupportsExternalBlockStorage)
                                        {
                                            <option value="AutomaticExternal">Automatically sized external storage</option>
                                            <option value="FixedExternal">Explicit external capacity</option>
                                        }
                                    </select>
                                </label>
                                @if (_selectedRuntimeStorageStrategy == "FixedExternal")
                                {
                                    <label class="hosting-field">
                                        <span>External capacity (GiB)</span>
                                        <input type="number"
                                               min="@storage.MinimumCapacityGiB"
                                               max="@storage.MaximumCapacityGiB"
                                               step="@storage.CapacityIncrementGiB"
                                               value="@_selectedExternalStorageSizeGiB"
                                               disabled="@(_storageMutationInProgress || _server.Deployment is not null)"
                                               @onchange="SelectExternalStorageSize"/>
                                    </label>
                                }
                            </div>
                            <dl class="hosting-storage-selection-facts">
                                <div><dt>Included profile disk</dt><dd>@FormatDiskGiB(SelectedRuntimeProfile?.DiskGiB)</dd></div>
                                <div><dt>Estimated peak requirement</dt><dd>@FormatOptionalBytes(_storageDemand?.PeakPreparationRequiredBytes)</dd></div>
                                <div><dt>Selected deployment capacity</dt><dd>@FormatOptionalBytes(SelectedStorageCapacityBytes(storage))</dd></div>
                                <div><dt>Combined estimated price</dt><dd>@FormatSelectedRuntimePrice(storage)</dd></div>
                            </dl>
                            <p class="hosting-storage-filesystem">@StorageSelectionSummary(storage)</p>
                            @if (_selectedRuntimeStorageStrategy != "IncludedDisk")
                            {
                                <UtfAlert Intent="MessageIntent.Warning">
                                    External deployment storage is deleted during full cost-stop or termination.
                                </UtfAlert>
                            }
                            @if (!string.IsNullOrWhiteSpace(storage.ReadinessFailure))
                            {
                                <UtfAlert Intent="MessageIntent.Warning">@storage.ReadinessFailure</UtfAlert>
                            }
                            @if (_server.Deployment is not null)
                            {
                                <UtfAlert Intent="MessageIntent.Info">Storage changes apply to the next deployment.</UtfAlert>
                            }
                            <button class="utf-button utf-button--primary"
                                    type="button"
                                    disabled="@(!CanSaveRuntimeStorage(storage))"
                                    @onclick="SaveRuntimeStorageAsync">
                                Save deployment storage
                            </button>
                        </section>
                    }
                    @if (_storageDemandLoading)
                    {
                        <p class="hosting-muted" role="status">Refreshing storage estimateâ€¦</p>
                    }
                    else if (_storageDemandError is not null)
                    {
                        <UtfAlert Intent="MessageIntent.Warning">Storage estimate unavailable: @_storageDemandError</UtfAlert>
                    }
                    else if (_storageDemand is { } cloudStorageDemand)
                    {
                        <StorageDemandSummary Demand="cloudStorageDemand"
                                              SelectedProfileIdentifier="_selectedRuntimeProfileIdentifier"/>
                    }
                </article>

                <article class="utf-panel hosting-deployment-panel">
                    <div class="hosting-section-heading">
                        <span class="utf-kicker">@Localizer["Hosting_Detail_DeploymentKicker"]</span>
                        <h2>@Localizer["Hosting_Detail_DeploymentTitle"]</h2>
                    </div>
                    @if (_server.Deployment is not { } cloudDeployment)
                    {
                        <p class="hosting-muted">@Localizer["Hosting_Detail_NoDeployment"]</p>
                    }
                    else
                    {
                        <dl class="hosting-facts">
                            <div>
                                <dt>@Localizer["Hosting_Common_Status"]</dt>
                                <dd>@LocalizeToken("Hosting_DeploymentStatus", cloudDeployment.Status)</dd>
                            </div>
                            <div>
                                <dt>@Localizer["Hosting_Detail_CloudProfile"]</dt>
                                <dd>
                                    <strong>@cloudDeployment.RuntimeProfileDisplayName</strong>
                                    <small><code>@cloudDeployment.RuntimeProfileIdentifier</code></small>
                                </dd>
                            </div>
                            <div>
                                <dt>Deployment filesystem</dt>
                                <dd>
                                    <strong>@HumanizeToken(cloudDeployment.RuntimeStorageStrategy)</strong>
                                    <small><code>@cloudDeployment.DeploymentRoot</code></small>
                                </dd>
                            </div>
                            <div>
                                <dt>Provisioned storage</dt>
                                <dd>@FormatOptionalBytes(
                                    cloudDeployment.SelectedExternalStorageBytes
                                    ?? cloudDeployment.IncludedStorageBytes)</dd>
                            </div>
                            <div>
                                <dt>@Localizer["Hosting_Common_Stage"]</dt>
                                <dd>@HumanizeToken(cloudDeployment.Stage)</dd>
                            </div>
                            <div>
                                <dt>@Localizer["Hosting_Detail_Worker"]</dt>
                                <dd>@LocalizeToken("Hosting_WorkerStatus", cloudDeployment.WorkerStatus)</dd>
                            </div>
                            <div>
                                <dt>@Localizer["Hosting_Detail_LastHeartbeat"]</dt>
                                <dd>@(cloudDeployment.LastHeartbeat is { } heartbeat ? FormatDate(heartbeat) : Localizer["Hosting_Common_NotApplicable"])</dd>
                            </div>
                        </dl>
                        <section class="hosting-storage-card">
                            <div class="hosting-section-heading">
                                <span class="utf-kicker">@Localizer["Hosting_Detail_StorageKicker"]</span>
                                <h3>@Localizer["Hosting_Detail_StorageTitle"]</h3>
                                <p>@Localizer["Hosting_Detail_StorageDescription"]</p>
                            </div>
                            @if (TryGetDiskUsage(cloudDeployment, out var diskTotal, out var diskAvailable, out var diskUsed))
                            {
                                <progress max="@diskTotal" value="@diskUsed"></progress>
                                <dl class="hosting-storage-facts">
                                    <div>
                                        <dt>@Localizer["Hosting_Detail_DiskUsed"]</dt>
                                        <dd>@FormatBytes(diskUsed)</dd>
                                    </div>
                                    <div>
                                        <dt>@Localizer["Hosting_Detail_DiskFree"]</dt>
                                        <dd>@FormatBytes(diskAvailable)</dd>
                                    </div>
                                    <div>
                                        <dt>@Localizer["Hosting_Detail_DiskTotal"]</dt>
                                        <dd>@FormatBytes(diskTotal)</dd>
                                    </div>
                                    <div>
                                        <dt>@Localizer["Hosting_Detail_DiskObserved"]</dt>
                                        <dd>@(cloudDeployment.DiskTimeStampObserved is { } observed
                                            ? FormatDate(observed)
                                            : Localizer["Hosting_Common_NotApplicable"])</dd>
                                    </div>
                                </dl>
                                @if (DiskIsBelowExpected(diskTotal))
                                {
                                    <UtfAlert Intent="MessageIntent.Warning">
                                        @Localizer[
                                            "Hosting_Detail_DiskExpectedMismatch",
                                            FormatOptionalBytes(ExpectedDeploymentStorageBytes),
                                            FormatBytes(diskTotal)]
                                    </UtfAlert>
                                }
                            }
                            else
                            {
                                <p class="hosting-muted">@Localizer["Hosting_Detail_NoDiskTelemetry"]</p>
                            }
                        </section>
                        @if (cloudDeployment.PossibleCost)
                        {
                            <UtfAlert Intent="MessageIntent.Warning">@Localizer["Hosting_Detail_PossibleCost"]</UtfAlert>
                        }
                        @if (cloudDeployment.Resources.Count > 0)
                        {
                            <div class="hosting-resource-list">
                                @foreach (var resource in cloudDeployment.Resources)
                                {
                                    <article @key="resource.PrimaryKey">
                                        <strong>@HumanizeToken(resource.Kind)</strong>
                                        <UtfStatusBadge Intent="neutral">@HumanizeToken(resource.State)</UtfStatusBadge>
                                        <small>@(resource.ProviderResourceIdentifier ?? Localizer["Hosting_Common_NotApplicable"])</small>
                                    </article>
                                }
                            </div>
                        }
                    }
                </article>
            </section>
        }

        @if (_activeSection == "logs")
        {
            <section class="utf-panel hosting-logs-panel">
                <div class="hosting-section-heading hosting-section-heading--row">
                    <div>
                        <span class="utf-kicker">@Localizer["Hosting_Detail_LogsKicker"]</span>
                        <h2>@Localizer["Hosting_Detail_LogsTitle"]</h2>
                        <p>@Localizer["Hosting_Detail_LogsDescription"]</p>
                    </div>
                    @if (CollectLogsAction is { } collectLogsAction)
                    {
                        <button class="utf-button utf-button--primary"
                                type="button"
                                disabled="@(_actionInProgress || !collectLogsAction.Enabled || collectLogsAction.Pending)"
                                title="@collectLogsAction.UnavailableReason"
                                @onclick="@(() => RequestActionAsync(collectLogsAction))">
                            @Localizer["Hosting_Detail_RefreshLogs"]
                        </button>
                    }
                </div>
                @if (LatestDiagnosticCommand is { } diagnosticCommand)
                {
                    <div class="hosting-log-meta">
                        <UtfStatusBadge Intent="success">@Localizer["Hosting_Detail_LogSnapshot"]</UtfStatusBadge>
                        <time>@FormatDate(diagnosticCommand.TimeStampCompleted ?? diagnosticCommand.TimeStampCreated)</time>
                    </div>
                    <pre class="hosting-log-output" tabindex="0">@diagnosticCommand.DiagnosticOutput</pre>
                }
                else
                {
                    <div class="utf-empty-state hosting-inline-empty">
                        <h2>@Localizer["Hosting_Detail_NoLogsTitle"]</h2>
                        <p>@Localizer["Hosting_Detail_NoLogsDescription"]</p>
                    </div>
                }
            </section>
        }
    }
</div>

@code {
    private const long MaxUploadBytes = 16 * 1024 * 1024;
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(5);
    private readonly CancellationTokenSource _cancellationTokenSource = new();

    [Parameter]
    public Guid ServerId { get; set; }

    [SupplyParameterFromQuery(Name = "action")]
    public string? RequestedAction { get; set; }

    private GameServerInfo? _server;
    private IReadOnlyList<LifecycleJobInfo> _jobs = [];
    private IReadOnlyList<HostingOperationInfo> _operations = [];
    private IReadOnlyList<HostingFileInfo> _files = [];
    private GameConfigurationInfo? _configuration;
    private IReadOnlyList<ConfigurationProfileOptionInfo> _configurationProfileOptions = [];
    private readonly Dictionary<string, string> _configurationEdits = new(StringComparer.Ordinal);
    private readonly HashSet<string> _configurationOverriddenTargets = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<PreservationSelectionInfo> _selections = [];
    private IReadOnlyList<RuntimeProfileInfo> _availableProfiles = [];
    private RuntimeProviderInfo? _runtimeProvider;
    private IReadOnlyList<GameServerModPackOptionInfo> _modPackOptions = [];
    private Task? _pollTask;
    private bool _isLoading = true;
    private bool _isRefreshing;
    private bool _actionInProgress;
    private bool _jobInterventionInProgress;
    private bool _filesLoading;
    private bool _configurationLoading;
    private bool _configurationSaving;
    private bool _fileMutationInProgress;
    private bool _selectionMutationInProgress;
    private bool _deletingServer;
    private bool _profileMutationInProgress;
    private bool _storageMutationInProgress;
    private bool _storageSelectionDirty;
    private bool _profileSelectionDirty;
    private bool _profilesLoading;
    private bool _modPacksLoading;
    private bool _modPackOptionsLoaded;
    private bool _modPackMutationInProgress;
    private bool _modPackSelectionDirty;
    private bool _showAllOperations;
    private string? _handledRequestedAction;
    private bool _focusConfirmationInput;
    private ElementReference _confirmationInputElement;
    private string _activeSection = "overview";
    private string? _loadError;
    private string? _operationError;
    private string? _fileError;
    private string? _configurationError;
    private string? _selectionError;
    private string? _modPackError;
    private string? _profileCatalogError;
    private StorageDemandInfo? _storageDemand;
    private bool _storageDemandLoading;
    private string? _storageDemandError;
    private GameServerActionInfo? _challengedAction;
    private string _confirmationInput = string.Empty;
    private EHostingFileContext _fileContext = EHostingFileContext.Persistent;
    private string _currentPath = string.Empty;
    private byte[]? _selectedUpload;
    private string? _selectedUploadName;
    private string _uploadPath = string.Empty;
    private bool _confirmGeneratedOverride;
    private string _directoryPath = string.Empty;
    private string _selectionPath = string.Empty;
    private string _selectionScope = "File";
    private string _selectionMode = "CreateOrUpdate";
    private string _selectedRuntimeProfileIdentifier = string.Empty;
    private string _selectedRuntimeStorageStrategy = "IncludedDisk";
    private long? _selectedExternalStorageSizeGiB;
    private long? _selectedModPackDefinitionId;
    private string _fileSortColumn = "name";
    private bool _fileSortDescending;

    private bool _profileChanged
        => _server is not null
           && SelectedRuntimeProfile is not null
           && !string.Equals(
               _selectedRuntimeProfileIdentifier,
               _server.RuntimeProfileIdentifier,
               StringComparison.OrdinalIgnoreCase);

    private bool CanDeleteServer
        => _server is { IsArchived: false, CanModify: true, Deployment: null, PendingJobCount: 0 }
           && _jobs.All(q => !q.CanRetry && !q.CanSkip);

    private bool CanMutateFiles
        => _server is { CanModify: true }
           && _fileContext is EHostingFileContext.Persistent;

    private bool UploadTargetsGeneratedFile
        => _files.Any(q => q.IsGeneratedTarget
                           && !q.OverridesGenerated
                           && string.Equals(q.Path, _uploadPath, StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<FileBreadcrumb> FileBreadcrumbs
    {
        get
        {
            var rootLabel = _fileContext is EHostingFileContext.Persistent
                ? Localizer["Hosting_Detail_PersistentFiles"].Value
                : Localizer["Hosting_Detail_LiveFiles"].Value;
            var breadcrumbs = new List<FileBreadcrumb>
            {
                new(rootLabel, string.Empty),
            };
            var segments = _currentPath
                .Replace('\\', '/')
                .Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            var path = string.Empty;
            foreach (var segment in segments)
            {
                path = CombinePath(path, segment);
                breadcrumbs.Add(new FileBreadcrumb(segment, path));
            }
            return breadcrumbs;
        }
    }

    private IEnumerable<HostingFileInfo> SortedFiles
    {
        get
        {
            var directoriesFirst = _files.OrderByDescending(q => q.IsDirectory);
            return (_fileSortColumn, _fileSortDescending) switch
            {
                ("modified", true) => directoriesFirst.ThenByDescending(q => q.ModifiedAt),
                ("modified", false) => directoriesFirst.ThenBy(q => q.ModifiedAt),
                ("size", true) => directoriesFirst.ThenByDescending(q => q.Size),
                ("size", false) => directoriesFirst.ThenBy(q => q.Size),
                (_, true) => directoriesFirst.ThenByDescending(q => q.Name, StringComparer.CurrentCultureIgnoreCase),
                _ => directoriesFirst.ThenBy(q => q.Name, StringComparer.CurrentCultureIgnoreCase),
            };
        }
    }

    private IEnumerable<HostingOperationInfo> VisibleOperations
        => _activeSection == "audit" && _showAllOperations ? _operations : _operations.Take(6);

    private RuntimeProfileInfo? SelectedRuntimeProfile
        => _availableProfiles.FirstOrDefault(q => string.Equals(
            q.Identifier,
            _selectedRuntimeProfileIdentifier,
            StringComparison.OrdinalIgnoreCase));

    private RuntimeProfileInfo? DeploymentRuntimeProfile
        => _server?.Deployment is { } deployment
            ? _availableProfiles.FirstOrDefault(q => string.Equals(
                q.Identifier,
                deployment.RuntimeProfileIdentifier,
                StringComparison.OrdinalIgnoreCase))
            : null;

    private bool IsArma3Server
        => string.Equals(_server?.GameIdentifier, "arma3", StringComparison.OrdinalIgnoreCase);

    private IReadOnlyList<GameServerActionInfo> RuntimeActions
        => _server?.Actions
               .Where(q => !string.Equals(q.Id, "collect-logs", StringComparison.OrdinalIgnoreCase))
               .Where(q => q.Enabled || q.Pending)
               .OrderBy(q => q.Order)
               .ToArray()
           ?? [];

    private string ProfileReadOnlyDescription
        => _server?.IsArchived is true
            ? Localizer["Hosting_ProfileCatalog_ArchivedDescription"].Value
            : Localizer["Hosting_ProfileCatalog_ReadOnlyDescription"].Value;

    private GameServerActionInfo? PrimaryAction
    {
        get
        {
            if (_server is null)
                return null;

            var enabled = _server.Actions
                .Where(q => q.Enabled || q.Pending)
                .Where(q => !string.Equals(q.Id, "collect-logs", StringComparison.OrdinalIgnoreCase))
                .ToArray();
            if (_server.Deployment?.PossibleCost == true)
            {
                var costStop = enabled.FirstOrDefault(q => q.Dangerous
                                                           && q.CostImpact.Contains(
                                                               "StopsCost",
                                                               StringComparison.OrdinalIgnoreCase));
                if (costStop is not null)
                    return costStop;
            }

            return enabled.FirstOrDefault(q => string.Equals(q.Id, "start", StringComparison.OrdinalIgnoreCase))
                   ?? enabled.FirstOrDefault(q => string.Equals(q.Id, "stop", StringComparison.OrdinalIgnoreCase))
                   ?? enabled.OrderBy(q => q.Order).FirstOrDefault();
        }
    }

    private IReadOnlyList<GameServerActionInfo> SecondaryActions
        => _server?.Actions
               .Where(q => q.Enabled || q.Pending)
               .Where(q => !string.Equals(q.Id, "collect-logs", StringComparison.OrdinalIgnoreCase))
               .Where(q => PrimaryAction is null || !string.Equals(q.Id, PrimaryAction.Id, StringComparison.Ordinal))
               .OrderBy(q => q.Order)
               .Take(4)
               .ToArray()
           ?? [];

    private GameServerActionInfo? CollectLogsAction
        => _server?.Actions.FirstOrDefault(q => string.Equals(
            q.Id,
            "collect-logs",
            StringComparison.OrdinalIgnoreCase));

    private GameServerActionInfo? EmergencyTerminateAction
        => _server?.Actions.FirstOrDefault(q => string.Equals(
            q.Id,
            "terminate",
            StringComparison.OrdinalIgnoreCase));

    private WorkerCommandInfo? LatestDiagnosticCommand
        => _jobs
            .SelectMany(q => q.Commands)
            .Where(q => !string.IsNullOrWhiteSpace(q.DiagnosticOutput))
            .OrderByDescending(q => q.TimeStampCompleted ?? q.TimeStampCreated)
            .FirstOrDefault();

    private string ServerStateIntent
        => _server?.Deployment switch
        {
            null => "neutral",
            { PossibleCost: true } => "warning",
            { Status: "Running" } => "success",
            { Status: "Failed" or "Faulted" } => "danger",
            _ => "info",
        };

    private string ServerStateLabel
        => _server?.Deployment is { } deployment
            ? LocalizeToken("Hosting_DeploymentStatus", deployment.Status)
            : Localizer["Hosting_Detail_StateOffline"].Value;

    private IEnumerable<IGrouping<string, GameServerActionInfo>> OrderedActionGroups
        => RuntimeActions.Count is 0
            ? Array.Empty<IGrouping<string, GameServerActionInfo>>()
            : RuntimeActions
                .GroupBy((action) => string.IsNullOrWhiteSpace(action.Group)
                    ? Localizer["Hosting_Detail_OtherActions"].Value
                    : LocalizeToken("Hosting_ActionGroup", action.Group))
                .OrderBy((group) => group.Min((action) => action.Order));

    private bool ChallengeMatches
        => _challengedAction?.ConfirmationChallenge is { } challenge
           && string.Equals(_confirmationInput, challenge, StringComparison.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        await RefreshRuntimeAsync(showLoading: true, _cancellationTokenSource.Token);
        if (_server is not null)
        {
            await LoadRuntimeProfilesAsync(_cancellationTokenSource.Token);
            await LoadFilesAsync(string.Empty, _cancellationTokenSource.Token);
            if (_server.CanModify)
                await LoadSelectionsAsync(_cancellationTokenSource.Token);
        }
        _pollTask = PollAsync(_cancellationTokenSource.Token);
    }

    private async Task RefreshRuntimeAsync(bool showLoading, CancellationToken cancellationToken = default)
    {
        if (_isRefreshing)
            return;

        _isRefreshing = true;
        if (showLoading)
            _isLoading = true;
        try
        {
            var serverTask = GameServerRepository.GetServerAsync(ServerId, cancellationToken);
            var jobsTask = GameServerRepository.GetJobsAsync(ServerId, cancellationToken);
            var operationsTask = GameServerRepository.GetOperationsAsync(
                ServerId,
                cancellationToken: cancellationToken);
            await Task.WhenAll(serverTask, jobsTask, operationsTask);
            _server = await serverTask;
            _jobs = await jobsTask;
            _operations = await operationsTask;
            SynchronizeRuntimeProfileSelection();
            if (IsArma3Server && !_modPackOptionsLoaded)
                await LoadModPackOptionsAsync(cancellationToken);
            if (!_modPackSelectionDirty && _server is not null)
                _selectedModPackDefinitionId = _server.SelectedModPackDefinitionId;
            _loadError = null;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            _loadError = UserFacingError.Message(exception, Localizer["Hosting_Detail_LoadError"].Value);
        }
        finally
        {
            _isRefreshing = false;
            _isLoading = false;
        }
    }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(RequestedAction))
            _handledRequestedAction = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_server is not null
            && !string.IsNullOrWhiteSpace(RequestedAction)
            && !string.Equals(_handledRequestedAction, RequestedAction, StringComparison.OrdinalIgnoreCase))
        {
            _handledRequestedAction = RequestedAction;
            var requestedAction = _server.Actions.SingleOrDefault(q => string.Equals(
                q.Id,
                RequestedAction,
                StringComparison.OrdinalIgnoreCase));
            if (requestedAction is { Enabled: true, Pending: false }
                && !string.IsNullOrWhiteSpace(requestedAction.ConfirmationChallenge))
            {
                _challengedAction = requestedAction;
                _confirmationInput = string.Empty;
                _focusConfirmationInput = true;
                NavigationManager.NavigateTo(
                    BaseUrl.ResolveSelfUrl($"command/servers/{ServerId}"),
                    replace: true);
                StateHasChanged();
                return;
            }
        }

        if (_focusConfirmationInput)
        {
            _focusConfirmationInput = false;
            await _confirmationInputElement.FocusAsync();
        }
    }

    private async Task RefreshAllAsync()
    {
        await RefreshRuntimeAsync(showLoading: false, _cancellationTokenSource.Token);
        if (_server is not null)
            await LoadRuntimeProfilesAsync(_cancellationTokenSource.Token);
    }

    private Task ReloadRuntimeProfilesAsync()
        => LoadRuntimeProfilesAsync(_cancellationTokenSource.Token);

    private async Task LoadRuntimeProfilesAsync(CancellationToken cancellationToken = default)
    {
        if (_profilesLoading || _server is null)
            return;

        _profilesLoading = true;
        _profileCatalogError = null;
        try
        {
            var capabilities = await GameServerRepository.GetCapabilitiesAsync(cancellationToken);
            var capability = capabilities.FirstOrDefault(candidate => string.Equals(
                candidate.GameIdentifier,
                _server.GameIdentifier,
                StringComparison.OrdinalIgnoreCase));
            _runtimeProvider = capability?.RuntimeProviderProfiles.FirstOrDefault(provider => string.Equals(
                provider.Identifier,
                _server.RuntimeProviderIdentifier,
                StringComparison.OrdinalIgnoreCase));
            _availableProfiles = _runtimeProvider?.Profiles.ToArray() ?? [];
            SynchronizeRuntimeProfileSelection();
            SynchronizeRuntimeStorageSelection();
            await LoadStorageDemandAsync(cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            _profileCatalogError = UserFacingError.Message(
                exception,
                Localizer["Hosting_ProfileCatalog_LoadFailed"].Value);
        }
        finally
        {
            _profilesLoading = false;
        }
    }

    private async Task LoadStorageDemandAsync(CancellationToken cancellationToken = default)
    {
        if (_server is null || _storageDemandLoading)
            return;

        _storageDemandLoading = true;
        _storageDemandError = null;
        try
        {
            _storageDemand = await GameServerRepository.GetStorageDemandAsync(ServerId, cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            _storageDemand = null;
            _storageDemandError = UserFacingError.Message(exception, "The estimate could not be refreshed.");
        }
        finally
        {
            _storageDemandLoading = false;
        }
    }

    private void SynchronizeRuntimeProfileSelection()
    {
        if (_profileSelectionDirty || _server is null)
            return;

        var currentProfile = _availableProfiles.FirstOrDefault(profile => string.Equals(
            profile.Identifier,
            _server.RuntimeProfileIdentifier,
            StringComparison.OrdinalIgnoreCase));
        _selectedRuntimeProfileIdentifier = currentProfile?.Identifier
                                            ?? _availableProfiles.FirstOrDefault()?.Identifier
                                            ?? _server.RuntimeProfileIdentifier;
    }

    private void SynchronizeRuntimeStorageSelection()
    {
        if (_storageSelectionDirty || _server is null)
            return;
        _selectedRuntimeStorageStrategy = _server.RuntimeStorageStrategy;
        _selectedExternalStorageSizeGiB = _server.ExternalStorageSizeGiB;
    }

    private static string GetOperationIntent(HostingOperationInfo operation)
        => operation.Status.Trim().ToLowerInvariant() switch
        {
            "failed" => "danger",
            "warning" => "warning",
            "pending" => "info",
            "succeeded" or "success" or "completed" => "success",
            _ => "neutral",
        };

    private static string GetOperationIconClass(HostingOperationInfo operation)
        => $"hosting-operation-icon hosting-operation-icon--{operation.Status.Trim().ToLowerInvariant()}";

    private static string GetOperationIcon(HostingOperationInfo operation)
        => operation.ResourceKind switch
        {
            "primary-ip" => "IP",
            "firewall" => "FW",
            "server" => "SRV",
            _ when operation.Kind.Contains("Worker", StringComparison.OrdinalIgnoreCase) => "W",
            _ => "OP",
        };

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(PollInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await RefreshRuntimeAsync(showLoading: false, cancellationToken);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private void SelectWorkspaceSection(string section)
    {
        _activeSection = section;
        if (section == "audit")
            _showAllOperations = true;
        if (section == "configuration" && _configuration is null)
            _ = LoadConfigurationAsync(_cancellationTokenSource.Token);
    }

    private async Task LoadConfigurationAsync(CancellationToken cancellationToken = default)
    {
        if (_server is null)
            return;
        _configurationLoading = true;
        _configurationError = null;
        try
        {
            _configuration = await GameServerRepository.GetConfigurationAsync(ServerId, cancellationToken);
            _configurationProfileOptions = await GameServerRepository
                .GetConfigurationProfileOptionsAsync(_server.GameIdentifier, cancellationToken);
            _configurationOverriddenTargets.Clear();
            foreach (var target in _configuration.Entries.Select(q => q.TargetPath).Distinct(StringComparer.OrdinalIgnoreCase))
            {
                var entries = await GameServerRepository.GetFilesAsync(
                    ServerId,
                    EHostingFileContext.Persistent,
                    ParentPath(target),
                    cancellationToken);
                if (entries.Any(q => string.Equals(q.Path, target, StringComparison.OrdinalIgnoreCase)
                                     && (q.OverridesGenerated || q.ConfigurationStatus == "Conflict")))
                    _configurationOverriddenTargets.Add(target);
            }
            _configurationEdits.Clear();
        }
        catch (Exception exception)
        {
            _configurationError = UserFacingError.Message(exception, "The structured configuration could not be loaded.");
        }
        finally
        {
            _configurationLoading = false;
        }
    }

    private string ConfigurationEditValue(GameConfigurationEntryInfo entry)
        => _configurationEdits.TryGetValue(entry.Key, out var value)
            ? value
            : entry.Value?.GetRawText() ?? string.Empty;

    private void SetConfigurationEdit(string key, string? value)
        => _configurationEdits[key] = value ?? "null";

    private async Task SaveConfigurationAsync()
    {
        _configurationSaving = true;
        _configurationError = null;
        try
        {
            var updates = _configurationEdits.Select(q =>
            {
                using var document = JsonDocument.Parse(q.Value);
                return new ConfigurationValueUpdateInfo(q.Key, document.RootElement.Clone());
            }).ToArray();
            _configuration = await GameServerRepository.UpdateConfigurationAsync(
                ServerId,
                updates,
                [],
                _cancellationTokenSource.Token);
            _configurationEdits.Clear();
        }
        catch (Exception exception)
        {
            _configurationError = UserFacingError.Message(exception, "The configuration changes could not be saved. Values must be valid JSON for their declared type.");
        }
        finally
        {
            _configurationSaving = false;
        }
    }

    private async Task ResetConfigurationEntryAsync(string key)
    {
        try
        {
            _configuration = await GameServerRepository.UpdateConfigurationAsync(
                ServerId,
                [],
                [key],
                _cancellationTokenSource.Token);
            _configurationEdits.Remove(key);
        }
        catch (Exception exception)
        {
            _configurationError = UserFacingError.Message(exception, "The server override could not be reset.");
        }
    }

    private async Task ChangeConfigurationProfileAsync(ChangeEventArgs args)
    {
        var profileId = Guid.TryParse(args.Value?.ToString(), out var value) ? value : (Guid?) null;
        await GameServerRepository.SelectConfigurationProfileAsync(
            ServerId,
            profileId,
            null,
            _cancellationTokenSource.Token);
        await LoadConfigurationAsync(_cancellationTokenSource.Token);
    }

    private async Task FollowLatestProfileAsync()
    {
        if (_configuration?.ProfileId is not { } profileId)
            return;
        await GameServerRepository.SelectConfigurationProfileAsync(
            ServerId,
            profileId,
            null,
            _cancellationTokenSource.Token);
        await LoadConfigurationAsync(_cancellationTokenSource.Token);
    }

    private async Task PinCurrentProfileAsync()
    {
        if (_configuration is not { ProfileId: { } profileId, ProfileRevisionId: { } revisionId })
            return;
        await GameServerRepository.SelectConfigurationProfileAsync(
            ServerId,
            profileId,
            revisionId,
            _cancellationTokenSource.Token);
        await LoadConfigurationAsync(_cancellationTokenSource.Token);
    }

    private string WorkspaceTabClass(string section)
        => _activeSection == section
            ? "hosting-workspace-tab hosting-workspace-tab--active"
            : "hosting-workspace-tab";

    private void SetFileSort(string column)
    {
        if (string.Equals(_fileSortColumn, column, StringComparison.Ordinal))
            _fileSortDescending = !_fileSortDescending;
        else
        {
            _fileSortColumn = column;
            _fileSortDescending = false;
        }
    }

    private string SortIndicator(string column)
        => !string.Equals(_fileSortColumn, column, StringComparison.Ordinal)
            ? string.Empty
            : _fileSortDescending
                ? "↓"
                : "↑";

    private async Task RequestActionAsync(GameServerActionInfo action)
    {
        _operationError = null;
        if (!action.Enabled || action.Pending)
            return;

        if (!string.IsNullOrWhiteSpace(action.ConfirmationChallenge))
        {
            _challengedAction = action;
            _confirmationInput = string.Empty;
            _focusConfirmationInput = true;
            return;
        }

        if (!string.IsNullOrWhiteSpace(action.ConfirmationText))
        {
            var confirmed = await DialogService.ShowUtfConfirmationAsync(
                ActionLabel(action),
                LocalizeServerMessage(action.ConfirmationText),
                ActionLabel(action),
                Localizer["Hosting_Common_Cancel"].Value,
                destructive: action.Dangerous,
                kicker: Localizer["Hosting_Detail_ConfirmationKicker"].Value
            );
            if (!confirmed)
                return;
        }

        _ = await ExecuteActionAsync(action, confirmation: null);
    }

    private async Task ConfirmChallengedActionAsync()
    {
        if (_challengedAction is not { } action || !ChallengeMatches)
            return;

        if (await ExecuteActionAsync(action, _confirmationInput))
            CancelChallenge();
    }

    private async Task<bool> ExecuteActionAsync(GameServerActionInfo action, string? confirmation)
    {
        _actionInProgress = true;
        _operationError = null;
        try
        {
            await GameServerRepository.ExecuteActionAsync(
