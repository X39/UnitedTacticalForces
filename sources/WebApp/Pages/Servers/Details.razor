                    <div class="hosting-file-contexts" role="tree" aria-label="@(Localizer["Hosting_Detail_FileContexts"])" >
                <button class="@GetFileContextClass(EHostingFileContext.Persistent)"
                        type="button"
                        role="treeitem"
                        aria-selected="@(_fileContext is EHostingFileContext.Persistent)"
                        @onclick="@(() => SelectFileContextAsync(EHostingFileContext.Persistent))">
                    <strong>@Localizer["Hosting_Detail_PersistentFiles"]</strong>
                    <span>@Localizer["Hosting_Detail_PersistentFilesHint"]</span>
                </button>
                <button class="@GetFileContextClass(EHostingFileContext.Live)"
                        type="button"
                        role="treeitem"
                        aria-selected="@(_fileContext is EHostingFileContext.Live)"
                        @onclick="@(() => SelectFileContextAsync(EHostingFileContext.Live))">
                    <strong>@Localizer["Hosting_Detail_LiveFiles"]</strong>
                        <span>@Localizer["Hosting_Detail_LiveFilesHint"]</span>
                </button>
                    </div>
                    @if (_selections.Any(q => q.SeededByGame))
                    {
                        <h3>@Localizer["Hosting_Detail_SeededByGame"]</h3>
