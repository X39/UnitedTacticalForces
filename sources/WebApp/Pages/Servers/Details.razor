    private static string ParentPath(string path)
    {
        var normalized = path.Replace('\\', '/').Trim('/');
        var separatorIndex = normalized.LastIndexOf('/');
        return separatorIndex < 0 ? string.Empty : normalized[..separatorIndex];
    }

    private static string CombinePath(string directory, string name)
        => string.IsNullOrWhiteSpace(directory) ? name : $"{directory.TrimEnd('/', '\\')}/{name}";

    private static string FormatDate(DateTimeOffset value)
        => value.ToLocalTime().ToString("g", CultureInfo.CurrentCulture);

    private string FormatAge(DateTimeOffset value)
    {
        var age = DateTimeOffset.UtcNow - value;
        if (age.TotalDays >= 1)
            return Localizer["Hosting_Detail_AgeDays", Math.Floor(age.TotalDays)].Value;
        if (age.TotalHours >= 1)
            return Localizer["Hosting_Detail_AgeHours", Math.Floor(age.TotalHours)].Value;
        return Localizer["Hosting_Detail_AgeMinutes", Math.Max(0, Math.Floor(age.TotalMinutes))].Value;
    }

    private string FormatFileSize(long? size)
    {
        if (size is null)
            return Localizer["Hosting_Common_NotApplicable"].Value;
        if (size < 1024)
            return $"{size} B";
        if (size < 1024 * 1024)
            return $"{size / 1024d:0.#} KB";
        return $"{size / 1024d / 1024d:0.#} MB";
    }

    private static string FormatDuration(int seconds)
    {
        var duration = TimeSpan.FromSeconds(seconds);
        return duration.TotalHours >= 1
            ? $"{duration.TotalHours:0.#} h"
            : duration.TotalMinutes >= 1
                ? $"{duration.TotalMinutes:0.#} min"
                : $"{Math.Max(0, seconds)} s";
    }

    private string FormatProfileCost(decimal? hourly, decimal? monthly)
        => hourly is null
            ? Localizer["Hosting_Detail_PriceUnavailable"].Value
            : monthly is { } monthlyCost
                ? Localizer["Hosting_Detail_ProfileCostMonthly", hourly, monthlyCost].Value
                : Localizer["Hosting_Detail_ProfileCostHourly", hourly].Value;

    private string FormatDiskGiB(int? diskGiB)
        => diskGiB is { } value
            ? Localizer["Hosting_Detail_DiskGiB", value].Value
            : Localizer["Hosting_Common_NotApplicable"].Value;

    private static bool TryGetDiskUsage(
        GameServerDeploymentInfo deployment,
        out long total,
        out long available,
        out long used)
    {
        total = deployment.DiskTotalBytes ?? 0;
        available = deployment.DiskAvailableBytes ?? 0;
        used = Math.Max(0, total - available);
        return total > 0 && available >= 0 && available <= total;
    }

    private bool DiskIsBelowExpected(long observedTotalBytes)
    {
        if (ExpectedDeploymentStorageBytes is not { } expectedBytes || expectedBytes <= 0)
            return false;
        return observedTotalBytes < expectedBytes * 0.9m;
    }

    private long? ExpectedDeploymentStorageBytes
        => _server?.Deployment is { } deployment
            ? deployment.SelectedExternalStorageBytes
              ?? deployment.IncludedStorageBytes
              ?? (DeploymentRuntimeProfile?.DiskGiB is { } expectedDiskGiB
                  ? expectedDiskGiB * 1024L * 1024L * 1024L
                  : null)
            : null;

    private static string FormatBytes(long bytes)
    {
        const long kibibyte = 1024;
        const long mebibyte = kibibyte * 1024;
        const long gibibyte = mebibyte * 1024;
        return bytes switch
        {
            >= gibibyte => $"{bytes / (double)gibibyte:0.##} GiB",
            >= mebibyte => $"{bytes / (double)mebibyte:0.##} MiB",
            >= kibibyte => $"{bytes / (double)kibibyte:0.##} KiB",
            _ => $"{bytes} B",
        };
    }

    private string FormatOptionalBytes(long? bytes)
        => bytes is { } value ? FormatBytes(value) : Localizer["Hosting_Common_NotApplicable"].Value;

    private string LocalizeToken(string prefix, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Localizer["Hosting_Common_NotApplicable"].Value;
        var key = $"{prefix}_{NormalizeResourceToken(value)}";
        var localized = Localizer[key];
        return localized.ResourceNotFound ? HumanizeToken(value) : localized.Value;
    }

    private string ActionLabel(GameServerActionInfo action)
        => LocalizeActionValue(action.Id, "Label", action.Label);

    private string ActionDescription(GameServerActionInfo action)
        => LocalizeActionValue(action.Id, "Description", action.Description);

    private string ActionCostDescription(GameServerActionInfo action)
        => LocalizeActionValue(action.Id, "CostDescription", action.CostDescription);

    private string LocalizeActionId(string actionId)
        => LocalizeActionValue(actionId, "Label", HumanizeToken(actionId));

    private string LocalizeActionValue(string actionId, string suffix, string fallback)
    {
        var key = $"Hosting_Action_{NormalizeResourceToken(actionId)}_{suffix}";
        var localized = Localizer[key];
        return localized.ResourceNotFound ? fallback : localized.Value;
    }

    private string LocalizeServerMessage(string? message)
        => message switch
        {
            null or "" => string.Empty,
            "Server Operate permission is required." => Localizer["Hosting_ServerMessage_OperatePermissionRequired"],
            "Another lifecycle operation is pending." => Localizer["Hosting_ServerMessage_OperationPending"],
            "Server launch is disabled." => Localizer["Hosting_ServerMessage_LaunchDisabled"],
            "This action is unavailable in the current deployment state." =>
                Localizer["Hosting_ServerMessage_ActionUnavailableForState"],
            "Termination is already in progress." => Localizer["Hosting_ServerMessage_TerminationPending"],
            "Confirm this server action." => Localizer["Hosting_ServerMessage_ConfirmAction"],
            "Live unpublished data will be lost." => Localizer["Hosting_ServerMessage_LiveDataWillBeLost"],
            _ => message,
        };

    private static string NormalizeResourceToken(string value)
        => new(value.Where(char.IsLetterOrDigit).ToArray());

    private static string HumanizeToken(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "–";
        var builder = new System.Text.StringBuilder(value.Length + 8);
        for (var index = 0; index < value.Length; index++)
        {
            var character = value[index];
            if (character is '-' or '_')
            {
                builder.Append(' ');
                continue;
            }
            if (index > 0 && char.IsUpper(character) && char.IsLower(value[index - 1]))
                builder.Append(' ');
            builder.Append(character);
        }
        return CultureInfo.CurrentCulture.TextInfo.ToTitleCase(builder.ToString().Trim().ToLowerInvariant());
    }

