                            {
                                <button type="button"
                                        title="@selection.Path"
                                        @onclick="@(() => OpenPreservedPathAsync(selection))">
                                    <FluentIcon Value="@(new Icons.Regular.Size20.FolderOpen())"/>
                                    <span>@selection.Path</span>
                                </button>
                            }
                        </div>
                    }
