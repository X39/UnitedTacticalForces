{
  "name": "@utf/react-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run locales:check && npm run generate && tsc -b && vite build",
    "build:assets": "npm run locales:check && npm run generate && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "generate": "npm run contracts:generate",
    "locales:check": "node scripts/check-locales.mjs",
    "locales:unused": "node scripts/check-locales.mjs --unused",
    "contracts:generate": "openapi-typescript openapi/utf-api.json -o src/generated/api.ts",
    "contracts:check": "npm run contracts:generate && git diff --exit-code -- src/generated/api.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile-320 --project=mobile-390",
    "test:e2e:update-snapshots": "playwright test --grep @visual --update-snapshots",
    "test:uat": "playwright test -c playwright.uat.config.ts",
    "ci": "npm run locales:check && npm run locales:unused && npm run contracts:check && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build:assets"
  },
  "dependencies": {
    "@adobe/mdast-util-gridtables": "4.0.19",
    "@adobe/remark-gridtables": "3.0.20",
    "@fluentui/react-components": "9.74.6",
    "@fluentui/react-icons": "2.0.320",
    "@hookform/resolvers": "5.2.2",
    "@tanstack/react-query": "5.101.4",
    "@types/mdast": "4.0.4",
    "date-fns": "4.1.0",
    "highlight.js": "11.11.1",
    "i18next": "26.3.6",
    "i18next-browser-languagedetector": "8.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-i18next": "17.0.11",
    "react-markdown": "10.1.0",
    "react-router": "7.18.2",
    "rehype-highlight": "7.0.2",
    "rehype-slug": "6.0.0",
    "remark-deflist": "1.0.0",
    "remark-directive": "4.0.0",
    "remark-flexible-markers": "1.3.5",
    "remark-gfm": "4.0.1",
    "unist-util-visit": "5.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "17.11.0",
    "jsdom": "28.0.0",
    "msw": "2.12.10",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.12"
  }
}
