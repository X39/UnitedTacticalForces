# Public listener. Keep PUBLIC_URL in sync with APP_PORT and omit a trailing slash.
APP_PORT=8080
PUBLIC_URL=http://localhost:8080

# PostgreSQL. Change the password before first startup and keep the same values on updates.
POSTGRES_DB=utf
POSTGRES_USER=utf
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Optional application behavior and integrations.
AUTO_VERIFY_NEW_USERS=false
STEAM_ENABLED=false
STEAM_API_KEY=
DISCORD_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
HETZNER_TOKEN=

# Production cloud provisioning requires an immutable worker image digest.
CLOUD_WORKER_IMAGE=
