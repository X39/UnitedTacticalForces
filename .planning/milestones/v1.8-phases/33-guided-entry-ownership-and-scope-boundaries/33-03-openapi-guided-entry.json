{
  "openapi": "3.0.1",
  "info": {
    "title": "United Tactical Forces Guided Cloud Entry",
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://localhost:7072"
    }
  ],
  "paths": {
    "/game-servers/cloud-entry/options": {
      "get": {
        "operationId": "GetGuidedCloudEntryOptionsAsync",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuidedCloudEntryOptionsDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/game-servers/cloud-entry/arma3-server": {
      "post": {
        "operationId": "CreateArma3GuidedCloudEntryServerAsync",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuidedCloudPlanningServerCreationPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameServerBillingAssignmentDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/game-servers/{gameServerId}/cloud-entry/billing-owner": {
      "post": {
        "operationId": "AssignGuidedCloudEntryBillingOwnerAsync",
        "parameters": [
          {
            "name": "gameServerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuidedCloudEntryBillingOwnerSelectionPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuidedCloudEntryServerOptionDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/game-servers/{gameServerId}/cloud-entry/readiness": {
      "post": {
        "operationId": "ValidateGuidedCloudEntryReadinessAsync",
        "parameters": [
          {
            "name": "gameServerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuidedCloudEntryReadinessPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuidedCloudEntryReadinessDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
